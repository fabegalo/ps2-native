file(READ "${PS2N_LOCK_FILE}" original)
get_filename_component(root "${PS2N_LOCK_FILE}" DIRECTORY)
get_filename_component(SCRATCH "${SCRATCH}" ABSOLUTE)
if(EXISTS "${SCRATCH}")
    message(FATAL_ERROR "SDK lock test scratch already exists")
endif()
file(MAKE_DIRECTORY "${SCRATCH}")
set(temporary "${SCRATCH}/sdk-lock-negative.json")
if(EXISTS "${temporary}")
    message(FATAL_ERROR "SDK lock test output already exists")
endif()
set(lock "${original}")
string(JSON count LENGTH "${lock}" ps2recomp_sdk patches)
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
    string(JSON path GET "${lock}" ps2recomp_sdk patches ${index} file)
    file(RELATIVE_PATH relative "${SCRATCH}" "${root}/${path}")
    string(JSON lock SET "${lock}" ps2recomp_sdk patches ${index} file "\"${relative}\"")
endforeach()
function(check_lock candidate expected)
    file(WRITE "${temporary}" "${candidate}")
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DPS2N_LOCK_FILE=${temporary}"
        "-DPS2N_PS2RECOMP_SOURCE_DIR=${PS2N_PS2RECOMP_SOURCE_DIR}"
        -P "${root}/cmake/VerifyPS2Recomp.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    file(REMOVE "${temporary}")
    string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic "${output}${error}")
    if(expected STREQUAL "success")
        if(NOT result EQUAL 0)
            message(FATAL_ERROR "SDK lock verification failed: ${output}${error}")
        endif()
    elseif(result EQUAL 0 OR NOT diagnostic MATCHES "${expected}")
        message(FATAL_ERROR "SDK lock negative control failed: ${output}${error}")
    endif()
endfunction()
check_lock("${lock}" success)
string(REPEAT "0" 40 zero_commit)
string(REPEAT "0" 64 zero_hash)
string(JSON invalid SET "${lock}" ps2recomp_sdk commit "\"${zero_commit}\"")
check_lock("${invalid}" "does not match")
string(JSON invalid SET "${lock}" ps2recomp_sdk patches 0 sha256 "\"${zero_hash}\"")
check_lock("${invalid}" "patch changed")
string(JSON path MEMBER "${lock}" ps2recomp_sdk patches 0 files 0)
string(JSON invalid SET "${lock}" ps2recomp_sdk patches 0 files "${path}" "\"${zero_hash}\"")
check_lock("${invalid}" "patch missing or modified")
file(REMOVE_RECURSE "${SCRATCH}")
message(STATUS "SDK revision, patch digest and patched source negative controls passed")
