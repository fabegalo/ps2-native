file(MAKE_DIRECTORY "${OUTPUT}")
execute_process(COMMAND "${FIXTURE}" "${OUTPUT}/fixture.elf" RESULT_VARIABLE result OUTPUT_QUIET)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "checkpoint CLI fixture failed")
endif()
set(scenario aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa)
function(run_checked)
    execute_process(COMMAND "${RUNNER}" "${OUTPUT}/fixture.elf" ${ARGN} "--checkpoint-scenario=${scenario}" --tail=0 RESULT_VARIABLE result OUTPUT_VARIABLE report ERROR_VARIABLE error)
    if(NOT result EQUAL 1 OR NOT report MATCHES "CHECKPOINT_SAVED")
        message(FATAL_ERROR "checkpoint CLI failed: ${result}: ${report} ${error}")
    endif()
    if(NOT report MATCHES "EXECUTION retired=[0-9]+ aot=0 interpreted=[0-9]+ aot_percent=0 execution_ms=[0-9.e+-]+ instructions_per_second=[0-9.e+-]+")
        message(FATAL_ERROR "checkpoint execution metrics missing or inconsistent: ${report}")
    endif()
endfunction()
run_checked(--budget=9 --checkpoint-every=5 "--checkpoint-out=${OUTPUT}/prefix.ps2ncp")
run_checked(--budget=8 --checkpoint-every=5 "--resume=${OUTPUT}/prefix.ps2ncp" "--checkpoint-out=${OUTPUT}/resumed.ps2ncp")
run_checked(--budget=17 "--checkpoint-out=${OUTPUT}/continuous.ps2ncp")
foreach(mode resumed continuous)
    execute_process(COMMAND "${CHECKPOINT}" inspect "${OUTPUT}/${mode}.ps2ncp" RESULT_VARIABLE result OUTPUT_VARIABLE info)
    if(NOT result EQUAL 0 OR NOT info MATCHES "retired=17 ")
        message(FATAL_ERROR "checkpoint CLI lost the absolute instruction count: ${info}")
    endif()
    string(REGEX MATCH "payload_sha256=([0-9a-f]+)" match "${info}")
    set(${mode}_hash "${CMAKE_MATCH_1}")
endforeach()
if(NOT resumed_hash STREQUAL continuous_hash)
    message(FATAL_ERROR "checkpoint CLI changed complete modeled state: ${resumed_hash} != ${continuous_hash}")
endif()
message(STATUS "Periodic CLI save/resume matches uninterrupted complete state")
if(PROFILE_ENABLED)
    run_checked(--budget=17 --profile "--checkpoint-out=${OUTPUT}/profiled.ps2ncp")
    execute_process(COMMAND "${CHECKPOINT}" inspect "${OUTPUT}/profiled.ps2ncp" RESULT_VARIABLE result OUTPUT_VARIABLE info)
    if(NOT result EQUAL 0 OR NOT info MATCHES "payload_sha256=${continuous_hash}")
        message(FATAL_ERROR "host component profiling changed the complete checkpoint state: ${info}")
    endif()
else()
    execute_process(COMMAND "${RUNNER}" "${OUTPUT}/fixture.elf" --budget=1 --profile RESULT_VARIABLE result ERROR_VARIABLE error OUTPUT_QUIET)
    if(NOT result EQUAL 1 OR NOT error MATCHES "PS2N_ENABLE_PROFILING")
        message(FATAL_ERROR "normal build did not explicitly refuse unavailable component timers: ${error}")
    endif()
endif()
