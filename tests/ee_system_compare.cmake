execute_process(COMMAND "${NATIVE}" "${IMAGE}" RESULT_VARIABLE native_exit OUTPUT_VARIABLE native_output ERROR_VARIABLE native_error TIMEOUT 30)
execute_process(COMMAND "${REFERENCE}" "${IMAGE}" RESULT_VARIABLE reference_exit OUTPUT_VARIABLE reference_output ERROR_VARIABLE reference_error TIMEOUT 30)
if(NOT native_exit EQUAL 0 OR NOT reference_exit EQUAL 0)
    message(FATAL_ERROR "EE system comparison failed: native=${native_exit}: ${native_error}; reference=${reference_exit}: ${reference_error}")
endif()
if(NOT native_output STREQUAL reference_output)
    message(FATAL_ERROR "EE system state differs: ${native_output} / ${reference_output}")
endif()
message(STATUS "${native_output}")
