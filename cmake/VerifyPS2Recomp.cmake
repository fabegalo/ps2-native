cmake_minimum_required(VERSION 3.21)
find_package(Git REQUIRED QUIET)
if(NOT EXISTS "${PS2N_PS2RECOMP_SOURCE_DIR}/.git")
    message(FATAL_ERROR "PS2Recomp SDK missing. Run git submodule update --init out/ps2recomp-reference, then apply the patches in deps.lock.json in order")
endif()
file(READ "${PS2N_LOCK_FILE}" lock)
string(JSON expected GET "${lock}" ps2recomp_sdk commit)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PS2N_PS2RECOMP_SOURCE_DIR}" rev-parse HEAD
    OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
    message(FATAL_ERROR "PS2Recomp revision '${actual}' does not match deps.lock.json (${expected})")
endif()
get_filename_component(root "${PS2N_LOCK_FILE}" DIRECTORY)
string(JSON count LENGTH "${lock}" ps2recomp_sdk patches)
if(count GREATER 0)
    math(EXPR last "${count} - 1")
    foreach(index RANGE ${last})
        string(JSON patch GET "${lock}" ps2recomp_sdk patches ${index})
        string(JSON path GET "${patch}" file)
        string(JSON expected GET "${patch}" sha256)
        file(READ "${root}/${path}" content)
        string(REPLACE "\r\n" "\n" content "${content}")
        string(SHA256 actual "${content}")
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "PS2Recomp patch changed: ${path}")
        endif()
        string(JSON files LENGTH "${patch}" files)
        math(EXPR last_file "${files} - 1")
        foreach(file_index RANGE ${last_file})
            string(JSON path MEMBER "${patch}" files ${file_index})
            list(APPEND approved_files "${path}")
            string(JSON expected GET "${patch}" files "${path}")
            string(SHA256 file_key "${path}")
            if(DEFINED final_hash_${file_key})
                string(JSON base ERROR_VARIABLE base_error GET "${patch}" base_files "${path}")
                if(base_error OR NOT base STREQUAL final_hash_${file_key})
                    message(FATAL_ERROR "PS2Recomp patch chain mismatch: ${path}")
                endif()
            endif()
            set(final_hash_${file_key} "${expected}")
        endforeach()
    endforeach()
endif()
list(REMOVE_DUPLICATES approved_files)
foreach(path IN LISTS approved_files)
    string(SHA256 file_key "${path}")
    file(READ "${PS2N_PS2RECOMP_SOURCE_DIR}/${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    string(SHA256 actual "${content}")
    if(NOT actual STREQUAL final_hash_${file_key})
        message(FATAL_ERROR "PS2Recomp patch missing or modified: ${path}; apply patches/ps2recomp in lock order")
    endif()
endforeach()
execute_process(COMMAND "${GIT_EXECUTABLE}" -c core.safecrlf=false -C "${PS2N_PS2RECOMP_SOURCE_DIR}" diff --name-only HEAD
    OUTPUT_VARIABLE changed OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect PS2Recomp source changes")
endif()
string(REPLACE "\n" ";" changed "${changed}")
foreach(path IN LISTS changed)
    if(NOT path IN_LIST approved_files)
        message(FATAL_ERROR "Unrecorded PS2Recomp source change: ${path}")
    endif()
endforeach()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PS2N_PS2RECOMP_SOURCE_DIR}"
    ls-files --others --exclude-standard -- "*.cpp" "*.h" "*.hpp" "*.cmake" CMakeLists.txt
    OUTPUT_VARIABLE untracked OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
if(NOT result EQUAL 0 OR NOT untracked STREQUAL "")
    message(FATAL_ERROR "Unrecorded PS2Recomp build inputs: ${untracked}")
endif()
foreach(name IN ITEMS elfio toml11 fmt libdwarf rabbitizer nlohmann_json)
    if(NOT DEFINED PS2N_SDK_${name}_DIR)
        continue()
    endif()
    string(JSON expected GET "${lock}" dependencies ${name} commit)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PS2N_SDK_${name}_DIR}" rev-parse HEAD
        OUTPUT_VARIABLE actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE result)
    if(NOT result EQUAL 0 OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "PS2Recomp dependency ${name}: expected ${expected}, got ${actual}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${PS2N_SDK_${name}_DIR}" diff --quiet HEAD
        RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "PS2Recomp dependency ${name} has unrecorded source changes")
    endif()
endforeach()
