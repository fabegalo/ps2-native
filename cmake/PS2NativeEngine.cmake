set(_gs "${PROJECT_SOURCE_DIR}/third_party/ps2-native-gs")
set(PS2N_ENGINE_WGPU "${PROJECT_SOURCE_DIR}/out/dependencies/wgpu-v29.0.1.1-windows-gnu" CACHE PATH "Verified wgpu-native package")
add_library(ps2n_engine_gs STATIC ${_gs}/gs/gs.cpp ${_gs}/gs/gif.cpp ${_gs}/vif.cpp ${_gs}/gs/raster.cpp ${_gs}/gs/gpu/gpu.cpp
    ${_gs}/gs/gpu/tiles.cpp ${_gs}/gs/gpu/hwdraw.cpp ${_gs}/gs/gpu/hwcache.cpp ${_gs}/gs/gpu/hwstat.cpp src/engine/gs_host.cpp)
target_include_directories(ps2n_engine_gs PUBLIC ${_gs} ${_gs}/include)
target_include_directories(ps2n_engine_gs PRIVATE include ${_ee}/include third_party/ps2recomp-iop src/engine third_party/ps2-native-vu/include ${PS2N_ENGINE_WGPU}/include)
target_compile_definitions(ps2n_engine_gs PRIVATE PS2_GPU PS2_LIVE_EE=1)
target_compile_options(ps2n_engine_gs PRIVATE -ffp-contract=off)
foreach(_shader IN ITEMS gs blit hwdraw hwcache hwdraw_sync)
    set(_name "kGsShader")
    if(_shader STREQUAL "blit")
        set(_name "kBlitShader")
    elseif(_shader STREQUAL "hwdraw")
        set(_name "kHwShader")
    elseif(_shader STREQUAL "hwcache")
        set(_name "kCacheShader")
    elseif(_shader STREQUAL "hwdraw_sync")
        set(_name "kHwSyncShader")
    endif()
    set(_output "${CMAKE_CURRENT_BINARY_DIR}/engine_${_shader}_wgsl.cpp")
    add_custom_command(OUTPUT "${_output}" COMMAND ${CMAKE_COMMAND} -DSRC=${_gs}/gs/gpu/${_shader}.wgsl -DOUT=${_output} -DNAME=${_name} -P ${_gs}/embed.cmake DEPENDS ${_gs}/gs/gpu/${_shader}.wgsl ${_gs}/embed.cmake)
    target_sources(ps2n_engine_gs PRIVATE ${_output})
endforeach()
target_link_libraries(ps2n_engine PUBLIC ps2n_engine_gs)
if(NOT EXISTS "${PS2N_ENGINE_WGPU}/include/webgpu/wgpu.h")
    message(FATAL_ERROR "Provide wgpu-native v29.0.1.1 via PS2N_ENGINE_WGPU; Windows package: python scripts/fetch-engine-graphics.py")
endif()
if(WIN32)
    set(_engine_wgpu "${PS2N_ENGINE_WGPU}/lib/libwgpu_native.dll.a")
else()
    find_library(_engine_wgpu NAMES wgpu_native PATHS "${PS2N_ENGINE_WGPU}/lib" NO_DEFAULT_PATH REQUIRED)
endif()
target_link_libraries(ps2n_engine_gs PRIVATE ps2n_engine_content "${_engine_wgpu}")
if(WIN32)
    target_link_libraries(ps2n_engine_gs PRIVATE ws2_32 userenv ntdll synchronization)
    configure_file("${PS2N_ENGINE_WGPU}/lib/wgpu_native.dll" "${CMAKE_CURRENT_BINARY_DIR}/wgpu_native.dll" COPYONLY)
endif()

