# The translator is a component; no external runtime is linked.
if(NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "The vendored AOT component requires Clang vector builtins")
endif()
set(_ee "${PROJECT_SOURCE_DIR}/third_party/ps2-native-recomp")
add_library(ps2n_engine_content STATIC src/elf.cpp src/io.cpp src/sha256.cpp)
target_include_directories(ps2n_engine_content PUBLIC include)
add_executable(ps2n-ee-recomp
    tools/ps2n_ee_prepare.cpp ${_ee}/recomp/elf.cpp ${_ee}/recomp/r5900.cpp
    ${_ee}/recomp/analysis.cpp ${_ee}/recomp/codegen.cpp
    ${_ee}/recomp/eerecomp_gen.cpp ${_ee}/recomp/snr2.cpp)
target_include_directories(ps2n-ee-recomp PRIVATE ${_ee}/include ${_ee}/recomp)
target_link_libraries(ps2n-ee-recomp PRIVATE ps2n_engine_content)
add_library(ps2n_engine STATIC src/engine/console.cpp)
target_include_directories(ps2n_engine PUBLIC include ${_ee}/include)
target_link_libraries(ps2n_engine PRIVATE ps2n_engine_content)
target_compile_definitions(ps2n_engine PUBLIC PS2_LIVE_EE=1)
target_compile_options(ps2n_engine PUBLIC -ffp-contract=off)
set(PS2N_ENGINE_ELF "" CACHE FILEPATH "Original ELF to execute through the engine")
set(PS2N_ENGINE_GENERATED "" CACHE PATH "AOT translation of PS2N_ENGINE_ELF")
set(PS2N_ENGINE_ELF_SHA256 "" CACHE STRING "SHA-256 of the translated ELF")
if(PS2N_ENGINE_GENERATED)
    file(SHA256 "${PS2N_ENGINE_ELF}" _elf_hash)
    if(NOT _elf_hash STREQUAL PS2N_ENGINE_ELF_SHA256)
        message(FATAL_ERROR "AOT input hash mismatch")
    endif()
    file(GLOB _generated CONFIGURE_DEPENDS "${PS2N_ENGINE_GENERATED}/*.cpp")
    add_executable(ps2n-engine-run tools/ps2n_engine_main.cpp ${_generated})
    target_link_libraries(ps2n-engine-run PRIVATE ps2n_engine)
    target_include_directories(ps2n-engine-run PRIVATE ${PS2N_ENGINE_GENERATED})
    target_compile_definitions(ps2n-engine-run PRIVATE PS2N_ENGINE_ELF="${PS2N_ENGINE_ELF}")
endif()

include(CTest)
if(BUILD_TESTING)
    add_executable(ps2n-engine-tests tests/engine_tests.cpp)
    target_link_libraries(ps2n-engine-tests PRIVATE ps2n_engine)
    add_test(NAME engine-core COMMAND ps2n-engine-tests)
    set_tests_properties(engine-core PROPERTIES TIMEOUT 10)
endif()
