# D3D12 is an optional Windows host backend. DXC is a build tool only.
option(PS2N_ENABLE_DIRECTX "Build the experimental Direct3D 12 GS backend when DXC is available" ON)
if(WIN32 AND PS2N_ENABLE_DIRECTX)
    if(CMAKE_HOST_SYSTEM_PROCESSOR MATCHES "ARM64|arm64|aarch64")
        set(ps2n_dxc_arch arm64)
    else()
        set(ps2n_dxc_arch x64)
    endif()
    file(GLOB ps2n_dxc_candidates "C:/Program Files (x86)/Windows Kits/10/bin/*/${ps2n_dxc_arch}/dxc.exe")
    list(SORT ps2n_dxc_candidates COMPARE NATURAL ORDER DESCENDING)
    set(ps2n_dxc_hints)
    foreach(candidate IN LISTS ps2n_dxc_candidates)
        get_filename_component(candidate_dir "${candidate}" DIRECTORY)
        list(APPEND ps2n_dxc_hints "${candidate_dir}")
    endforeach()
    find_program(PS2N_DXC_EXECUTABLE NAMES dxc HINTS ${ps2n_dxc_hints} "$ENV{VULKAN_SDK}/Bin")
    if(PS2N_DXC_EXECUTABLE)
        file(SHA256 "${PS2N_DXC_EXECUTABLE}" PS2N_GS_DXC_SHA256)
        set(ps2n_dxc_dependencies "${PS2N_DXC_EXECUTABLE}")
        get_filename_component(ps2n_dxc_directory "${PS2N_DXC_EXECUTABLE}" DIRECTORY)
        foreach(dll IN ITEMS dxcompiler.dll dxil.dll)
            if(EXISTS "${ps2n_dxc_directory}/${dll}")
                file(SHA256 "${ps2n_dxc_directory}/${dll}" ps2n_dxc_dependency_hash)
                string(APPEND PS2N_GS_DXC_SHA256 "${ps2n_dxc_dependency_hash}")
                list(APPEND ps2n_dxc_dependencies "${ps2n_dxc_directory}/${dll}")
            endif()
        endforeach()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${ps2n_dxc_dependencies})
        set(ps2n_dxil_header "${CMAKE_CURRENT_BINARY_DIR}/generated/gs_flat_dxil.hpp")
        add_custom_command(OUTPUT "${ps2n_dxil_header}"
            COMMAND "${CMAKE_COMMAND}" -E make_directory "${CMAKE_CURRENT_BINARY_DIR}/generated"
            COMMAND "${PS2N_DXC_EXECUTABLE}" -T cs_6_0 -E main -O3 -Ges -WX
                -Fh "${ps2n_dxil_header}" -Vn ps2n_gs_flat_dxil "${CMAKE_CURRENT_SOURCE_DIR}/shaders/gs_flat.hlsl"
            DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/shaders/gs_flat.hlsl" ${ps2n_dxc_dependencies} VERBATIM)
        target_sources(ps2n_core PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/src/gs_directx.cpp" "${ps2n_dxil_header}")
        target_include_directories(ps2n_core PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/generated")
        target_compile_definitions(ps2n_core PRIVATE PS2N_HAS_DIRECTX=1)
        message(STATUS "Experimental GS Direct3D 12: DXC found; hardware SM6/int64 checked at runtime")
    else()
        message(STATUS "Experimental GS Direct3D 12: DXC absent; CPU renderer remains available")
    endif()
endif()
