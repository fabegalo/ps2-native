# Focused original-boot hardware tests; all firmware fixtures are our own.
if(BUILD_TESTING)
    add_executable(ps2n-cdvd-media tests/cdvd_media.cpp)
    target_link_libraries(ps2n-cdvd-media PRIVATE ps2n_core)
    add_test(NAME native-cdvd-media COMMAND ps2n-cdvd-media "${FIXTURE_DIR}")
    set_tests_properties(native-cdvd-media PROPERTIES TIMEOUT 30)
    add_executable(ps2n-sio2-idle tests/sio2_idle.cpp)
    target_link_libraries(ps2n-sio2-idle PRIVATE ps2n_core)
    add_test(NAME native-sio2-idle COMMAND ps2n-sio2-idle)
    set_tests_properties(native-sio2-idle PROPERTIES TIMEOUT 30)
    add_executable(ps2n-rom1 tests/rom1.cpp)
    target_link_libraries(ps2n-rom1 PRIVATE ps2n_core)
    add_test(NAME native-rom1 COMMAND ps2n-rom1)
    set_tests_properties(native-rom1 PROPERTIES TIMEOUT 30)
    add_executable(ps2n-cdvd-bus tests/cdvd_bus.cpp)
    target_link_libraries(ps2n-cdvd-bus PRIVATE ps2n_core)
    add_test(NAME native-cdvd-bus COMMAND ps2n-cdvd-bus)
    set_tests_properties(native-cdvd-bus PROPERTIES TIMEOUT 30)
    add_executable(ps2n-sif1-boot tests/sif1_boot.cpp)
    target_link_libraries(ps2n-sif1-boot PRIVATE ps2n_core)
    add_test(NAME native-sif1-boot COMMAND ps2n-sif1-boot)
    set_tests_properties(native-sif1-boot PROPERTIES TIMEOUT 30)
    add_executable(ps2n-gs-events-fixture tests/gs_events.cpp)
    target_compile_definitions(ps2n-gs-events-fixture PRIVATE PS2N_GS_EVENTS_FIXTURE=1)
    target_link_libraries(ps2n-gs-events-fixture PRIVATE ps2n_core)
    set(GS_EVENTS_ROM "${FIXTURE_DIR}/gs-events.bin")
    set(GS_EVENTS_AOT "${FIXTURE_DIR}/gs_events_aot.cpp")
    add_custom_command(OUTPUT "${GS_EVENTS_ROM}"
        COMMAND $<TARGET_FILE:ps2n-gs-events-fixture> "${GS_EVENTS_ROM}"
        DEPENDS ps2n-gs-events-fixture VERBATIM)
    add_custom_command(OUTPUT "${GS_EVENTS_AOT}"
        COMMAND $<TARGET_FILE:ps2n-aot> "${GS_EVENTS_ROM}" "${GS_EVENTS_AOT}" --bios --entry=0xBFC00400
        DEPENDS ps2n-aot "${GS_EVENTS_ROM}" VERBATIM)
    add_executable(ps2n-gs-events tests/gs_events.cpp "${GS_EVENTS_AOT}")
    target_link_libraries(ps2n-gs-events PRIVATE ps2n_core)
    foreach(CASE IN ITEMS events timing reset irq knowledge ram-knowledge held-counter dma-setup vu-control vif-control ipu-control diagnostic-boundary iop-memory dma-suspend guest)
        add_test(NAME bios-gs-${CASE} COMMAND ps2n-gs-events ${CASE} "${GS_EVENTS_ROM}")
        set_tests_properties(bios-gs-${CASE} PROPERTIES TIMEOUT 30)
    endforeach()
endif()
