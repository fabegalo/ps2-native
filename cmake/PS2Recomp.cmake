# PS2Recomp is the execution layer, consumed with locked patches at the commit pinned in
# deps.lock.json (as x360-native consumes ReXGlue):
#   ps2xRecomp/ps2xAnalyzer  built as their own top-level project (README flow)
#   ps2xRuntime/ps2xIOP      added here; each prepared game links ps2_runtime
include(ExternalProject)
include(FetchContent)

set(PS2N_LOCK_FILE "${CMAKE_CURRENT_LIST_DIR}/../deps.lock.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PS2N_LOCK_FILE}")
file(READ "${PS2N_LOCK_FILE}" _ps2n_lock)
string(JSON PS2N_PS2RECOMP_URL GET "${_ps2n_lock}" ps2recomp url)
string(JSON PS2N_PS2RECOMP_COMMIT GET "${_ps2n_lock}" ps2recomp commit)

set(_ps2n_submodule "${CMAKE_CURRENT_LIST_DIR}/../external/ps2recomp")
if(EXISTS "${_ps2n_submodule}/ps2xRuntime/CMakeLists.txt")
    set(_ps2n_default_source "${_ps2n_submodule}")
else()
    set(_ps2n_default_source "")
endif()
set(PS2N_PS2RECOMP_SOURCE_DIR "${_ps2n_default_source}" CACHE PATH
    "PS2Recomp checkout at the pinned commit (default: the external/ps2recomp submodule; empty: fetch it)")
if(PS2N_PS2RECOMP_SOURCE_DIR)
    set(_ps2recomp "${PS2N_PS2RECOMP_SOURCE_DIR}")
else()
    FetchContent_Declare(ps2recomp GIT_REPOSITORY "${PS2N_PS2RECOMP_URL}" GIT_TAG "${PS2N_PS2RECOMP_COMMIT}"
        GIT_PROGRESS FALSE SOURCE_SUBDIR ps2n-no-configure)
    FetchContent_MakeAvailable(ps2recomp)
    set(_ps2recomp "${ps2recomp_SOURCE_DIR}")
endif()

find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_ps2recomp}" rev-parse HEAD
    OUTPUT_VARIABLE _actual OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0 OR NOT _actual STREQUAL PS2N_PS2RECOMP_COMMIT)
    message(FATAL_ERROR "PS2Recomp at ${_ps2recomp} is ${_actual}; deps.lock.json pins ${PS2N_PS2RECOMP_COMMIT}")
endif()
# As with ReXGlue, accept only the patched files and exact bytes in the lock.
set(_patched_files "")
string(JSON _patch_count LENGTH "${_ps2n_lock}" ps2recomp patches)
if(_patch_count GREATER 0)
    math(EXPR _last_patch "${_patch_count} - 1")
    foreach(_i RANGE ${_last_patch})
        string(JSON _patch GET "${_ps2n_lock}" ps2recomp patches ${_i})
        string(JSON _file GET "${_patch}" file)
        string(JSON _want GET "${_patch}" sha256)
        file(READ "${PROJECT_SOURCE_DIR}/${_file}" _text)
        string(REPLACE "\r\n" "\n" _text "${_text}")
        string(SHA256 _have "${_text}")
        if(NOT _have STREQUAL _want)
            message(FATAL_ERROR "PS2Recomp patch hash mismatch: ${_file}")
        endif()
        string(JSON _files GET "${_patch}" files)
        string(JSON _file_count LENGTH "${_files}")
        math(EXPR _last_file "${_file_count} - 1")
        foreach(_j RANGE ${_last_file})
            string(JSON _path MEMBER "${_files}" ${_j})
            # Patches apply in order; a file touched by several must match the last result.
            string(JSON "_want_${_path}" GET "${_files}" "${_path}")
            list(APPEND _patched_files "${_path}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${PROJECT_SOURCE_DIR}/${_file}")
            # CMake already tracks the SDK's own scripts; listing them again duplicates a Ninja output.
            if(NOT _path MATCHES "(CMakeLists\\.txt|\\.cmake)$")
                set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_ps2recomp}/${_path}")
            endif()
        endforeach()
    endforeach()
    list(REMOVE_DUPLICATES _patched_files)
    foreach(_path IN LISTS _patched_files)
        file(READ "${_ps2recomp}/${_path}" _text)
        string(REPLACE "\r\n" "\n" _text "${_text}")
        string(SHA256 _have "${_text}")
        if(NOT _have STREQUAL "${_want_${_path}}")
            message(FATAL_ERROR "PS2Recomp patch missing/modified: ${_path}. Run scripts/apply-sdk-patches.ps1")
        endif()
    endforeach()
endif()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${_ps2recomp}" diff HEAD --name-only
    OUTPUT_VARIABLE _changes OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "Cannot inspect PS2Recomp working tree")
endif()
string(REPLACE "\n" ";" _changes "${_changes}")
foreach(_path IN LISTS _changes)
    if(NOT _path IN_LIST _patched_files)
        message(FATAL_ERROR "Unrecorded PS2Recomp change: ${_path}")
    endif()
endforeach()
set(PS2N_PS2RECOMP_DIR "${_ps2recomp}")

# ARM64 hosts: PS2Recomp's SSE code goes through sse2neon, pinned in deps.lock.json host_libraries.
set(_ps2n_sse2neon "${PROJECT_SOURCE_DIR}/external/sse2neon")
set(_ps2n_cpu "${CMAKE_SYSTEM_PROCESSOR}")
if(MSVC)
    set(_ps2n_cpu "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
endif()
if(_ps2n_cpu MATCHES "^(aarch64|arm64|ARM64)$")
    if(NOT EXISTS "${_ps2n_sse2neon}/sse2neon.h")
        message(FATAL_ERROR "sse2neon missing; run scripts/fetch-pcsx2-components.py --group host_libraries")
    endif()
    include_directories(SYSTEM "${_ps2n_sse2neon}")
    add_compile_definitions(USE_SSE2NEON)
    if(MSVC)
        add_compile_options($<$<COMPILE_LANGUAGE:C,CXX>:/Zc:preprocessor>)  # sse2neon rejects the traditional preprocessor
    endif()
elseif(NOT MSVC)
    # PS2Recomp's 128-bit code uses SSE4.1 intrinsics; MSVC x64 accepts them without a flag.
    add_compile_options(-msse4.1)
endif()

# Recompiler and analyzer: the upstream top-level build, tools only.
set(PS2N_PS2RECOMP_TOOLS_DIR "${CMAKE_BINARY_DIR}/ps2recomp-tools")
ExternalProject_Add(ps2recomp_tools
    SOURCE_DIR "${_ps2recomp}"
    BINARY_DIR "${PS2N_PS2RECOMP_TOOLS_DIR}"
    CMAKE_ARGS -DCMAKE_BUILD_TYPE=Release -DPS2X_BUILD_RUNTIME=OFF -DPS2X_BUILD_TEST=OFF -DPS2X_BUILD_STUDIO=OFF
        -DCMAKE_C_COMPILER=${CMAKE_C_COMPILER} -DCMAKE_CXX_COMPILER=${CMAKE_CXX_COMPILER}
        "-DFETCHCONTENT_SOURCE_DIR_SSE2NEON=${_ps2n_sse2neon}"
    BUILD_COMMAND "${CMAKE_COMMAND}" --build "${PS2N_PS2RECOMP_TOOLS_DIR}" --config Release --target ps2_recomp ps2_analyzer
    INSTALL_COMMAND ""
    BUILD_ALWAYS ON
    BUILD_BYPRODUCTS "${PS2N_PS2RECOMP_TOOLS_DIR}/ps2xRecomp/ps2_recomp${CMAKE_EXECUTABLE_SUFFIX}"
        "${PS2N_PS2RECOMP_TOOLS_DIR}/ps2xAnalyzer/ps2_analyzer${CMAKE_EXECUTABLE_SUFFIX}")
set(PS2N_RECOMP_EXE "${PS2N_PS2RECOMP_TOOLS_DIR}/ps2xRecomp/ps2_recomp${CMAKE_EXECUTABLE_SUFFIX}")
set(PS2N_ANALYZER_EXE "${PS2N_PS2RECOMP_TOOLS_DIR}/ps2xAnalyzer/ps2_analyzer${CMAKE_EXECUTABLE_SUFFIX}")

# Runtime: the debug UI and verbose logs are upstream developer options.
set(PS2X_ENABLE_DEBUG_UI OFF CACHE BOOL "" FORCE)
set(PS2X_ENABLE_SCCACHE OFF CACHE BOOL "" FORCE)
set(PS2X_ENABLE_AGRESSIVE_LOGS OFF CACHE BOOL "" FORCE)
add_subdirectory("${_ps2recomp}/ps2xIOP" ps2recomp/iop EXCLUDE_FROM_ALL)
add_subdirectory("${_ps2recomp}/ps2xRuntime" ps2recomp/runtime EXCLUDE_FROM_ALL)

# One executable per prepared game: the generated PS2Recomp sources, the
# ps2-native host entry point and the hash-verified ps2_runtime library.
function(ps2n_add_iop_modules target disc_directory boot_elf)
    file(GLOB_RECURSE _irx CONFIGURE_DEPENDS "${disc_directory}/*.irx" "${disc_directory}/*.IRX")
    set(_registration "// Prepared IOP modules; generated by CMake.\n")
    set(_calls "")
    set(_seen "")
    get_filename_component(_content "${disc_directory}" DIRECTORY)
    set(_metadata "${_content}/game.txt")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_metadata}")
    foreach(_key rom0 rom0_sha256 secrman_offset secrman_size secrman_sha256)
        file(STRINGS "${_metadata}" _value REGEX "^${_key}=" LIMIT_COUNT 1)
        string(REGEX REPLACE "^${_key}=" "" _value "${_value}")
        set(_firmware_${_key} "${_value}")
    endforeach()
    if(_firmware_secrman_sha256)
        file(SHA256 "${_firmware_rom0}" _rom_hash)
        if(NOT _rom_hash STREQUAL _firmware_rom0_sha256)
            message(FATAL_ERROR "Selected console ROM0 changed: ${_firmware_rom0}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_firmware_rom0}")
        set(_identity "${_firmware_secrman_sha256}")
        set(_module "ps2n-iop-${_identity}")
        ps2x_add_iop_aot_module(${_module} "${_firmware_rom0}" "${CMAKE_BINARY_DIR}/iop-aot"
            OFFSET "${_firmware_secrman_offset}" SIZE "${_firmware_secrman_size}" IDENTITY "${_identity}")
        target_link_libraries(${target} PRIVATE ${_module})
        list(APPEND _seen "${_identity}")
        string(APPEND _registration "void register_iop_${_identity}();\n")
        string(APPEND _calls "    register_iop_${_identity}();\n")
    endif()
    foreach(_image IN LISTS _irx)
        file(SHA256 "${_image}" _identity)
        if(_identity IN_LIST _seen)
            continue()
        endif()
        list(APPEND _seen "${_identity}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_image}")
        set(_module "ps2n-iop-${_identity}")
        ps2x_add_iop_aot_module(${_module} "${_image}" "${CMAKE_BINARY_DIR}/iop-aot")
        target_link_libraries(${target} PRIVATE ${_module})
        string(APPEND _registration "void register_iop_${_identity}();\n")
        string(APPEND _calls "    register_iop_${_identity}();\n")
    endforeach()
    if(EXISTS "${boot_elf}")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${boot_elf}")
        ps2x_find_embedded_iop_modules("${boot_elf}" _embedded)
        string(JSON _embedded_count LENGTH "${_embedded}")
        if(_embedded_count GREATER 0)
            math(EXPR _last_embedded "${_embedded_count} - 1")
            foreach(_index RANGE 0 ${_last_embedded})
                string(JSON _identity GET "${_embedded}" ${_index} identity)
                if(_identity IN_LIST _seen)
                    continue()
                endif()
                list(APPEND _seen "${_identity}")
                string(JSON _offset GET "${_embedded}" ${_index} offset)
                string(JSON _size GET "${_embedded}" ${_index} size)
                set(_module "ps2n-iop-${_identity}")
                ps2x_add_iop_aot_module(${_module} "${boot_elf}" "${CMAKE_BINARY_DIR}/iop-aot"
                    OFFSET "${_offset}" SIZE "${_size}" IDENTITY "${_identity}")
                target_link_libraries(${target} PRIVATE ${_module})
                string(APPEND _registration "void register_iop_${_identity}();\n")
                string(APPEND _calls "    register_iop_${_identity}();\n")
            endforeach()
        endif()
    endif()
    string(APPEND _registration "void ps2n_register_iop_modules() {\n${_calls}}\n")
    set(_registration_source "${CMAKE_BINARY_DIR}/generated/${target}-iop.cpp")
    file(GENERATE OUTPUT "${_registration_source}" CONTENT "${_registration}")
    set_source_files_properties("${_registration_source}" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
    target_sources(${target} PRIVATE "${_registration_source}")
endfunction()

function(ps2n_add_ee_modules target content_directory)
    set(_registration "#include \"runtime/ee_scheduler.h\"\n#include \"ps2native/sha256.hpp\"\n")
    set(_calls "")
    # exec/current.txt: the executable ExecPS2 starts; ee-load/*.txt: code the game links into RAM itself.
    file(GLOB _receipts CONFIGURE_DEPENDS "${content_directory}/exec/current.txt" "${content_directory}/ee-load/*.txt")
    foreach(_receipt IN LISTS _receipts)
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_receipt}")
        file(STRINGS "${_receipt}" _identity REGEX "^sha256=" LIMIT_COUNT 1)
        string(REGEX REPLACE "^sha256=" "" _identity "${_identity}")
        string(LENGTH "${_identity}" _length)
        if(NOT _length EQUAL 64 OR NOT _identity MATCHES "^[0-9a-f]+$")
            message(FATAL_ERROR "Invalid prepared EE identity: ${_receipt}")
        endif()
        if(NOT EXISTS "${CMAKE_BINARY_DIR}/ee-aot/${_identity}/g/register_functions.cpp")
            message(FATAL_ERROR "Prepare the EE module before building this content: ${_identity}")
        endif()
        target_link_libraries(${target} PRIVATE ps2n-ee-${_identity})
        string(APPEND _registration "extern const EeAotModule g_ps2EeAot_${_identity};\n")
        string(APPEND _calls "    {\n    const auto& module = g_ps2EeAot_${_identity};\n"
            "    if (ps2native::sha256_hex(std::span(module.image, module.imageSize)) != module.identity)\n"
            "        throw std::runtime_error(\"Prepared EE descriptor identity differs from its content\");\n"
            "    scheduler.registerAotModule(module);\n    }\n")
    endforeach()
    string(APPEND _registration "void ps2n_register_ee_modules(EeScheduler& scheduler) {\n${_calls}}\n")
    set(_source "${CMAKE_BINARY_DIR}/generated/${target}-ee.cpp")
    file(GENERATE OUTPUT "${_source}" CONTENT "${_registration}")
    set_source_files_properties("${_source}" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON
        INCLUDE_DIRECTORIES "${PROJECT_SOURCE_DIR}/include")
    target_sources(${target} PRIVATE "${_source}")
endfunction()

# VU1 blocks that ps2n translated from the game's recorded microprograms
# (vu1/blocks_<n>.cpp); each defines ps2n_vu1_blocks_<n>(), which registers them.
function(ps2n_add_vu1_blocks target content_directory)
    file(GLOB _blocks CONFIGURE_DEPENDS "${content_directory}/vu1/blocks_*.cpp")
    set(_registration "")
    set(_calls "")
    foreach(_block IN LISTS _blocks)
        get_filename_component(_name "${_block}" NAME_WE)
        string(APPEND _registration "void ps2n_vu1_${_name}();\n")
        string(APPEND _calls "    ps2n_vu1_${_name}();\n")
    endforeach()
    if(_blocks)
        target_sources(${target} PRIVATE ${_blocks})
        set_source_files_properties(${_blocks} PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON
            INCLUDE_DIRECTORIES "${_ps2recomp}/ps2xRuntime/src/lib/vu_pcsx2;${_ps2recomp}/ps2xRuntime/src/lib")
    endif()
    string(APPEND _registration "void ps2n_register_vu1_blocks() {\n${_calls}}\n")
    set(_source "${CMAKE_BINARY_DIR}/generated/${target}-vu1.cpp")
    file(GENERATE OUTPUT "${_source}" CONTENT "${_registration}")
    set_source_files_properties("${_source}" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
    target_sources(${target} PRIVATE "${_source}")
endfunction()

function(ps2n_add_game id generated)
    file(GLOB _sources CONFIGURE_DEPENDS "${generated}/*.cpp")
    add_executable(ps2n-game-${id} EXCLUDE_FROM_ALL ${_sources} "${PROJECT_SOURCE_DIR}/tools/ps2n_game_main.cpp"
        "${PROJECT_SOURCE_DIR}/tools/ps2n_hw_watch.cpp")
    target_include_directories(ps2n-game-${id} PRIVATE "${generated}")
    target_link_libraries(ps2n-game-${id} PRIVATE ps2_runtime ps2n_pcsx2_audio ps2n_gs_host_link)
    # Link the content archive without exporting its flags/includes to generated EE code.
    target_link_libraries(ps2n-game-${id} PRIVATE "$<TARGET_FILE:ps2n_content>")
    add_dependencies(ps2n-game-${id} ps2n_content)
    get_filename_component(_game_directory "${generated}" DIRECTORY)
    file(STRINGS "${_game_directory}/game.txt" _boot_elf REGEX "^elf=" LIMIT_COUNT 1)
    string(REGEX REPLACE "^elf=" "" _boot_elf "${_boot_elf}")
    ps2n_add_iop_modules(ps2n-game-${id} "${_game_directory}/cd" "${_game_directory}/cd/${_boot_elf}")
    ps2n_add_ee_modules(ps2n-game-${id} "${_game_directory}")
    ps2n_add_vu1_blocks(ps2n-game-${id} "${_game_directory}")
    set_target_properties(ps2n-game-${id} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 32)
    # The host reads the runtime's SIF RPC history (an SDK-internal header) for its opt-in trace.
    set_source_files_properties("${PROJECT_SOURCE_DIR}/tools/ps2n_game_main.cpp" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON
        INCLUDE_DIRECTORIES "${_ps2recomp}/ps2xRuntime/src/lib;${PROJECT_SOURCE_DIR}/include")
    if(MSVC)
        target_compile_options(ps2n-game-${id} PRIVATE /FS /bigobj)
        # Same workaround as ps2EntryRunner: WinAPI and raylib both define CloseWindow.
        target_link_options(ps2n-game-${id} PRIVATE /FORCE:MULTIPLE)
    endif()
    if(COMMAND ps2x_stage_ffmpeg_runtime_dlls)
        ps2x_stage_ffmpeg_runtime_dlls(ps2n-game-${id})
    endif()
    if(COMMAND EnableFastReleaseMode AND CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo)$")
        EnableFastReleaseMode(ps2n-game-${id})
    endif()
endfunction()
