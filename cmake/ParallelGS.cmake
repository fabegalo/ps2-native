option(PS2N_PARALLEL_GS "Build the optional paraLLEl-GS Vulkan device" OFF)
add_library(ps2n_parallel_gs STATIC "${PROJECT_SOURCE_DIR}/src/host/parallel_gs.cpp")
target_include_directories(ps2n_parallel_gs PUBLIC "${PROJECT_SOURCE_DIR}/src/host")
target_link_libraries(ps2n_parallel_gs PRIVATE ps2_runtime)
# LINK_ONLY belongs in the interface (also supported by CMake 3.21).
add_library(ps2n_gs_host_link INTERFACE)
target_link_libraries(ps2n_gs_host_link INTERFACE "$<LINK_ONLY:ps2n_parallel_gs>")
if(NOT PS2N_PARALLEL_GS)
    return()
endif()

execute_process(COMMAND "${Python3_EXECUTABLE}" "${PROJECT_SOURCE_DIR}/scripts/fetch-pcsx2-components.py"
    --group graphics_devices --check RESULT_VARIABLE _graphics_check)
if(NOT _graphics_check EQUAL 0)
    message(FATAL_ERROR "Pinned graphics sources missing or modified; see device verification output")
endif()

function(ps2n_add_parallel_gs)
    set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded$<$<CONFIG:Debug>:Debug>DLL")
    set(PARALLEL_GS_STANDALONE ON CACHE BOOL "" FORCE)
    foreach(_feature IN ITEMS TOOLS AUDIO FFMPEG FFMPEG_VULKAN TARGET_NATIVE FAST_MATH
            RENDERDOC_CAPTURE VULKAN_DXGI_INTEROP INSTALL_TARGETS INSTALL_EXE_TARGETS)
        set(GRANITE_${_feature} OFF CACHE BOOL "" FORCE)
    endforeach()
    add_subdirectory("${PROJECT_SOURCE_DIR}/external/parallel-gs" parallel-gs EXCLUDE_FROM_ALL)
    target_compile_definitions(ps2n_parallel_gs PRIVATE PS2N_PARALLEL_GS=1)
    target_include_directories(ps2n_parallel_gs PRIVATE "${PS2N_PS2RECOMP_DIR}/ps2xRuntime/src/lib/gs")
    target_link_libraries(ps2n_parallel_gs PRIVATE parallel-gs)
    if(BUILD_TESTING)
        add_executable(ps2n-parallel-gs-tests EXCLUDE_FROM_ALL "${PROJECT_SOURCE_DIR}/tests/parallel_gs_tests.cpp")
        target_link_libraries(ps2n-parallel-gs-tests PRIVATE parallel-gs ps2_runtime ps2n_parallel_gs)
        target_include_directories(ps2n-parallel-gs-tests PRIVATE "${PS2N_PS2RECOMP_DIR}/ps2xRuntime/src/lib/gs")
        add_test(NAME parallel-gs-device COMMAND ps2n-parallel-gs-tests)
        set_tests_properties(parallel-gs-device PROPERTIES TIMEOUT 60 LABELS "gpu")
    endif()
endfunction()
ps2n_add_parallel_gs()
