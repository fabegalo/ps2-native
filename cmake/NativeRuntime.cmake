# One AOT-only runtime and one shared console state for every executable.
add_library(ps2n_core_native ALIAS ps2n_core)
if(BUILD_TESTING)
    if(MSVC)
        get_filename_component(ps2n_linker_directory "${CMAKE_LINKER}" DIRECTORY)
        find_program(PS2N_DUMPBIN_EXECUTABLE dumpbin HINTS "${ps2n_linker_directory}")
        if(PS2N_DUMPBIN_EXECUTABLE)
            add_test(NAME native-runtime-no-interpreters COMMAND "${CMAKE_COMMAND}"
                "-DDUMPBIN=${PS2N_DUMPBIN_EXECUTABLE}" "-DNATIVE=$<TARGET_FILE:ps2n_core_native>"
                -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/native_symbols.cmake")
        endif()
    endif()
    add_executable(ps2n-ee-system-fixture tests/ee_system_make_fixture.cpp)
    target_link_libraries(ps2n-ee-system-fixture PRIVATE ps2n_core)
    set(EE_SYSTEM_IMAGE "${FIXTURE_DIR}/ee-system.elf")
    set(EE_SYSTEM_SOURCE "${FIXTURE_DIR}/ee_system_aot.cpp")
    add_custom_command(OUTPUT "${EE_SYSTEM_IMAGE}"
        COMMAND $<TARGET_FILE:ps2n-ee-system-fixture> "${EE_SYSTEM_IMAGE}"
        DEPENDS ps2n-ee-system-fixture VERBATIM)
    add_custom_command(OUTPUT "${EE_SYSTEM_SOURCE}"
        COMMAND $<TARGET_FILE:ps2n-aot> "${EE_SYSTEM_IMAGE}" "${EE_SYSTEM_SOURCE}" --hybrid --execution-alias=0x80000000 --entry=0x80000180
        DEPENDS ps2n-aot "${EE_SYSTEM_IMAGE}" VERBATIM)
    add_executable(ps2n-ee-system-native tests/ee_system_aot.cpp "${EE_SYSTEM_SOURCE}")
    target_link_libraries(ps2n-ee-system-native PRIVATE ps2n_core_native)
    add_test(NAME native-ee-system COMMAND ps2n-ee-system-native "${EE_SYSTEM_IMAGE}")
endif()
add_library(ps2n_frontend_native ALIAS ps2n_frontend)
if(BUILD_TESTING)
    add_executable(ps2n-session-native-tests tests/session.cpp)
    target_link_libraries(ps2n-session-native-tests PRIVATE ps2n_frontend)
    add_test(NAME session-supervisor-native COMMAND ps2n-session-native-tests
        "${CMAKE_CURRENT_BINARY_DIR}/session-supervisor-native")
    set_tests_properties(session-supervisor-native PROPERTIES TIMEOUT 30)
    add_executable(ps2n-sdk-runtime-tests tests/ps2recomp_runtime.cpp "${FIXTURE_AOT}")
    target_link_libraries(ps2n-sdk-runtime-tests PRIVATE ps2n_sdk_runtime)
    add_test(NAME sdk-runtime-owner COMMAND ps2n-sdk-runtime-tests "${FIXTURE_ELF}"
        "${CMAKE_CURRENT_BINARY_DIR}/runtime-owner-integration")
    set_tests_properties(sdk-runtime-owner PROPERTIES TIMEOUT 120)
    if(PS2N_DUMPBIN_EXECUTABLE)
        add_test(NAME sdk-runtime-no-interpreters COMMAND "${CMAKE_COMMAND}"
            "-DDUMPBIN=${PS2N_DUMPBIN_EXECUTABLE}" "-DNATIVE=$<TARGET_FILE:ps2n_core>"
            -P "${CMAKE_CURRENT_SOURCE_DIR}/tests/native_symbols.cmake")
    endif()
endif()
add_executable(ps2n-native tools/ps2n-boot.cpp)
target_link_libraries(ps2n-native PRIVATE ps2n_sdk_runtime)
add_executable(ps2n-run-native tools/ps2n-run.cpp)
target_link_libraries(ps2n-run-native PRIVATE ps2n_sdk_runtime)
if(PS2N_ELF_AOT_SOURCE)
    target_link_libraries(ps2n-run-native PRIVATE ps2n_elf_aot)
    target_compile_definitions(ps2n-run-native PRIVATE PS2N_RUN_WITH_AOT=1)
endif()
if(PS2N_BIOS_AOT_SOURCE)
    target_link_libraries(ps2n-native PRIVATE ps2n_bios_aot)
    target_compile_definitions(ps2n-native PRIVATE PS2N_BOOT_WITH_AOT=1)
endif()
if(PS2N_IOP_AOT_SOURCES OR PS2N_VU1_AOT_SOURCES OR PS2N_VU0_AOT_SOURCES)
    add_library(ps2n_native_modules OBJECT)
    target_link_libraries(ps2n_native_modules PUBLIC ps2n_core_native)
    foreach(source IN LISTS PS2N_IOP_AOT_SOURCES PS2N_VU1_AOT_SOURCES PS2N_VU0_AOT_SOURCES)
        ps2n_target_aot_source(ps2n_native_modules "${source}")
    endforeach()
    foreach(target IN ITEMS ps2n-boot ps2n-boot-hybrid ps2n-run ps2n-run-hybrid ps2n-native ps2n-run-native)
        if(TARGET ${target})
            target_link_libraries(${target} PRIVATE ps2n_native_modules)
        endif()
    endforeach()
endif()
