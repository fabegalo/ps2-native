# Native code modules import the one shared runtime, never a static runtime copy.
file(GLOB_RECURSE native_contract_files CONFIGURE_DEPENDS
    "${CMAKE_SOURCE_DIR}/include/ps2native/*.hpp"
    "${CMAKE_SOURCE_DIR}/cmake/*.cmake")
list(APPEND native_contract_files "${CMAKE_SOURCE_DIR}/CMakeLists.txt" "${CMAKE_SOURCE_DIR}/src/sdk/iop_module_interface.hpp"
    "${CMAKE_SOURCE_DIR}/src/iop_aot.cpp")
list(APPEND native_contract_files "${PS2N_PS2RECOMP_SOURCE_DIR}/ps2xRuntime/include/ps2_runtime_macros.h")
set(_sdk_context_header "${PS2N_PS2RECOMP_SOURCE_DIR}/ps2xRuntime/include/ps2_runtime.h")
file(READ "${_sdk_context_header}" _sdk_context)
string(REPLACE "\r\n" "\n" _sdk_context "${_sdk_context}")
string(FIND "${_sdk_context}" "\nclass PS2Runtime\n" _sdk_context_end)
if(_sdk_context_end LESS 0)
    message(FATAL_ERROR "SDK native context declaration boundary changed")
endif()
# Generated code uses the context type and an opaque PS2Runtime pointer only.
# Adding a private service interface does not change a game's imported ABI.
string(SUBSTRING "${_sdk_context}" 0 ${_sdk_context_end} _sdk_context)
string(SHA256 _sdk_context_hash "${_sdk_context}")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_sdk_context_header}")
list(SORT native_contract_files)
set(native_contract "ps2n-native-module-v1;${_sdk_context_hash};${PS2N_SDK_SPU2_STATE_SHA256};${PS2N_PS2RECOMP_CODEGEN_LOCK_SHA256};${PS2N_PS2RECOMP_BACKEND_SHA256};${CMAKE_CXX_COMPILER_ID};${CMAKE_CXX_COMPILER_VERSION};${CMAKE_CXX_COMPILER_ARCHITECTURE_ID};${CMAKE_GENERATOR_PLATFORM};${CMAKE_SYSTEM_NAME};${CMAKE_SYSTEM_PROCESSOR};${CMAKE_SIZEOF_VOID_P};${CMAKE_CXX_FLAGS};${CMAKE_CXX_FLAGS_RELEASE};${CMAKE_CXX_FLAGS_DEBUG};${CMAKE_CXX_FLAGS_RELWITHDEBINFO};${CMAKE_CXX_FLAGS_MINSIZEREL};${CMAKE_MSVC_RUNTIME_LIBRARY};${PS2N_ENABLE_PROFILING};${PS2N_ENABLE_VULKAN};${PS2N_ENABLE_DIRECTX}")
foreach(path IN LISTS native_contract_files)
    file(SHA256 "${path}" hash)
    file(RELATIVE_PATH name "${CMAKE_SOURCE_DIR}" "${path}")
    string(APPEND native_contract "\n${name} ${hash}")
endforeach()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${native_contract_files})
string(SHA256 native_contract_hash "${native_contract}")
set(native_abi "${native_contract_hash}-$<CONFIG>")
target_sources(ps2n_core PRIVATE src/native_module.cpp)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/generated/$<CONFIG>/ps2native/native_module_abi.hpp"
    CONTENT "#pragma once\n#define PS2N_HOST_NATIVE_ABI \"${native_abi}\"\n")
target_include_directories(ps2n_core PUBLIC "${CMAKE_BINARY_DIR}/generated/$<CONFIG>")
target_sources(ps2n_frontend PRIVATE src/frontend/native_module.cpp)
target_link_libraries(ps2n_frontend PRIVATE nlohmann_json::nlohmann_json ${CMAKE_DL_LIBS})
target_link_libraries(ps2n-dev PRIVATE ps2n_frontend ps2n_sdk_runtime)
target_compile_definitions(ps2n-dev PRIVATE PS2N_CORE_FILE="$<TARGET_FILE:ps2n_core>")
foreach(target IN ITEMS ps2n-run ps2n-run-native ps2n-run-hybrid)
    if(TARGET ${target})
        target_link_libraries(${target} PRIVATE ps2n_frontend)
    endif()
endforeach()
target_compile_definitions(ps2n-dev PRIVATE PS2N_MODULE_SUFFIX="${CMAKE_SHARED_MODULE_SUFFIX}")
target_compile_definitions(ps2n-dev PRIVATE PS2N_DEV_BUILD="${CMAKE_BINARY_DIR}" PS2N_DEV_CONFIG="$<CONFIG>")
target_include_directories(ps2n-dev PRIVATE "${CMAKE_BINARY_DIR}/generated" "${CMAKE_SOURCE_DIR}/src")
target_include_directories(ps2n_frontend PRIVATE "${CMAKE_SOURCE_DIR}/src")
if(MSVC AND (NOT "$ENV{INCLUDE}" STREQUAL ""))
    file(CONFIGURE OUTPUT "${CMAKE_BINARY_DIR}/generated/native_toolchain.hpp" CONTENT
        "#pragma once\n#define PS2N_COMPILER_INCLUDE R\"ps2n($ENV{INCLUDE})ps2n\"\n#define PS2N_COMPILER_LIB R\"ps2n($ENV{LIB})ps2n\"\n#define PS2N_COMPILER_LIBPATH R\"ps2n($ENV{LIBPATH})ps2n\"\n#define PS2N_COMPILER_PATH R\"ps2n($ENV{PATH})ps2n\"\n")
endif()
if(BUILD_TESTING)
    target_link_libraries(ps2n-sdk-prepare-tests PRIVATE ps2n_frontend ps2_recomp_lib)
    set_tests_properties(sdk-prepare-pipeline PROPERTIES RUN_SERIAL TRUE TIMEOUT 360)
    foreach(kind IN ITEMS valid incompatible)
        add_library(ps2n-module-${kind} MODULE tools/native_module_export.cpp "${FIXTURE_AOT}")
        target_link_libraries(ps2n-module-${kind} PRIVATE ps2n_core)
        if(kind STREQUAL "valid")
            target_compile_definitions(ps2n-module-${kind} PRIVATE PS2N_NATIVE_ABI="${native_abi}")
        else()
            target_compile_definitions(ps2n-module-${kind} PRIVATE PS2N_NATIVE_ABI="incompatible")
        endif()
        set_target_properties(ps2n-module-${kind} PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/native-module-tests"
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/native-module-tests")
        add_library(ps2n-iop-module-${kind} MODULE tools/native_module_export.cpp tests/native_iop_module.cpp)
        target_include_directories(ps2n-iop-module-${kind} PRIVATE "${CMAKE_SOURCE_DIR}/src")
        target_link_libraries(ps2n-iop-module-${kind} PRIVATE ps2n_core_native)
        target_compile_definitions(ps2n-iop-module-${kind} PRIVATE PS2N_IOP_LOADABLE_MODULE=1)
        if(kind STREQUAL "valid")
            target_compile_definitions(ps2n-iop-module-${kind} PRIVATE PS2N_NATIVE_ABI="${native_abi}")
        else()
            target_compile_definitions(ps2n-iop-module-${kind} PRIVATE PS2N_NATIVE_ABI="incompatible")
        endif()
        set_target_properties(ps2n-iop-module-${kind} PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/native-module-tests"
            RUNTIME_OUTPUT_DIRECTORY "${CMAKE_BINARY_DIR}/native-module-tests")
    endforeach()
    add_executable(ps2n-native-module-tests tests/native_module.cpp)
    target_link_libraries(ps2n-native-module-tests PRIVATE ps2n_frontend nlohmann_json::nlohmann_json)
    target_include_directories(ps2n-native-module-tests PRIVATE "${CMAKE_SOURCE_DIR}/src")
    add_dependencies(ps2n-native-module-tests ps2n-module-valid ps2n-module-incompatible ps2n-iop-module-valid ps2n-iop-module-incompatible)
    add_test(NAME native-module-loading COMMAND ps2n-native-module-tests
        $<TARGET_FILE:ps2n-module-valid> $<TARGET_FILE:ps2n-module-incompatible> "${FIXTURE_ELF}"
        $<TARGET_FILE:ps2n-iop-module-valid> $<TARGET_FILE:ps2n-iop-module-incompatible>)
    set_tests_properties(native-module-loading PROPERTIES TIMEOUT 30)
endif()
set(PS2N_CONTENT_RECEIPT "" CACHE FILEPATH "Verified offline SDK translation for a loadable code module")
set(PS2N_CONTENT_OUTPUT "" CACHE PATH "Native content cache directory")
if(PS2N_CONTENT_RECEIPT)
    if(NOT PS2N_CONTENT_OUTPUT)
        message(FATAL_ERROR "PS2N_CONTENT_OUTPUT is required for a native content module")
    endif()
    add_library(ps2n_content_module MODULE EXCLUDE_FROM_ALL tools/native_module_export.cpp)
    ps2n_target_sdk_source(ps2n_content_module "${PS2N_CONTENT_RECEIPT}")
    if(MSVC)
        # Keep fixed-word native specializations; bound cold preparation's inliner cost.
        target_compile_options(ps2n_content_module PRIVATE /Ob0)
    endif()
    target_compile_definitions(ps2n_content_module PRIVATE PS2N_NATIVE_ABI="${native_abi}")
    set_target_properties(ps2n_content_module PROPERTIES PREFIX "" OUTPUT_NAME native-game
        CXX_SCAN_FOR_MODULES OFF
        LIBRARY_OUTPUT_DIRECTORY "${PS2N_CONTENT_OUTPUT}" RUNTIME_OUTPUT_DIRECTORY "${PS2N_CONTENT_OUTPUT}")
    foreach(config IN ITEMS RELEASE DEBUG RELWITHDEBINFO MINSIZEREL)
        set_target_properties(ps2n_content_module PROPERTIES
            LIBRARY_OUTPUT_DIRECTORY_${config} "${PS2N_CONTENT_OUTPUT}" RUNTIME_OUTPUT_DIRECTORY_${config} "${PS2N_CONTENT_OUTPUT}")
    endforeach()
endif()

set(PS2N_IOP_CONTENT_SOURCE "" CACHE FILEPATH "Offline relocated IOP AOT source")
set(PS2N_IOP_CONTENT_OUTPUT "" CACHE PATH "Native IOP code cache directory")
if(PS2N_IOP_CONTENT_SOURCE)
    if(NOT PS2N_IOP_CONTENT_OUTPUT)
        message(FATAL_ERROR "PS2N_IOP_CONTENT_OUTPUT is required for an IOP code module")
    endif()
    add_library(ps2n_iop_content_module MODULE EXCLUDE_FROM_ALL tools/native_module_export.cpp)
    ps2n_target_aot_source(ps2n_iop_content_module "${PS2N_IOP_CONTENT_SOURCE}")
    target_include_directories(ps2n_iop_content_module PRIVATE "${CMAKE_SOURCE_DIR}/src")
    target_link_libraries(ps2n_iop_content_module PRIVATE ps2n_core_native)
    target_compile_definitions(ps2n_iop_content_module PRIVATE PS2N_IOP_LOADABLE_MODULE=1 PS2N_NATIVE_ABI="${native_abi}")
    if(MSVC)
        target_compile_options(ps2n_iop_content_module PRIVATE /Ob0)
    endif()
    set_target_properties(ps2n_iop_content_module PROPERTIES PREFIX "" OUTPUT_NAME native-iop CXX_SCAN_FOR_MODULES OFF
        LIBRARY_OUTPUT_DIRECTORY "${PS2N_IOP_CONTENT_OUTPUT}" RUNTIME_OUTPUT_DIRECTORY "${PS2N_IOP_CONTENT_OUTPUT}")
    foreach(config IN ITEMS RELEASE DEBUG RELWITHDEBINFO MINSIZEREL)
        set_target_properties(ps2n_iop_content_module PROPERTIES LIBRARY_OUTPUT_DIRECTORY_${config} "${PS2N_IOP_CONTENT_OUTPUT}"
            RUNTIME_OUTPUT_DIRECTORY_${config} "${PS2N_IOP_CONTENT_OUTPUT}")
    endforeach()
endif()
