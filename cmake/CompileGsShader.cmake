cmake_minimum_required(VERSION 3.21)
foreach(required PS2N_GLSLC_EXECUTABLE PS2N_GS_SHADER_SOURCE PS2N_GS_SHADER_BINARY PS2N_GS_SHADER_INCLUDE)
    if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
        message(FATAL_ERROR "${required} is required")
    endif()
endforeach()
execute_process(COMMAND "${PS2N_GLSLC_EXECUTABLE}" -O --target-env=vulkan1.1
    "${PS2N_GS_SHADER_SOURCE}" -o "${PS2N_GS_SHADER_BINARY}"
    RESULT_VARIABLE result COMMAND_ERROR_IS_FATAL ANY)
file(READ "${PS2N_GS_SHADER_BINARY}" bytes HEX)
string(LENGTH "${bytes}" length)
math(EXPR remainder "${length} % 8")
if(remainder OR length LESS 40)
    message(FATAL_ERROR "The shader compiler produced an invalid SPIR-V word stream")
endif()
set(text "// Generated from shaders/gs_flat.comp with glslc -O --target-env=vulkan1.1.\n// Original shader source is BSD-3-Clause; regenerate after shader changes.\n")
set(offset 0)
set(column 0)
while(offset LESS length)
    string(SUBSTRING "${bytes}" ${offset} 2 a)
    math(EXPR index "${offset}+2")
    string(SUBSTRING "${bytes}" ${index} 2 b)
    math(EXPR index "${offset}+4")
    string(SUBSTRING "${bytes}" ${index} 2 c)
    math(EXPR index "${offset}+6")
    string(SUBSTRING "${bytes}" ${index} 2 d)
    string(APPEND text "0x${d}${c}${b}${a}u,")
    math(EXPR column "(${column}+1)%8")
    if(column EQUAL 0)
        string(APPEND text "\n")
    else()
        string(APPEND text " ")
    endif()
    math(EXPR offset "${offset}+8")
endwhile()
if(NOT column EQUAL 0)
    string(STRIP "${text}" text)
    string(APPEND text "\n")
endif()
file(WRITE "${PS2N_GS_SHADER_INCLUDE}" "${text}")
