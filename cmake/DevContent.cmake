# Content identities supplement timestamps in managed builds. Per-source
# definitions change the compiler command on every generator, including Visual
# Studio (which does not support the OBJECT_DEPENDS source property).
option(PS2N_DEV_CONTENT_TRACKING "Track source/header content in managed developer builds" OFF)
if(PS2N_DEV_CONTENT_TRACKING)
    file(GLOB_RECURSE dev_headers CONFIGURE_DEPENDS
        "${CMAKE_CURRENT_SOURCE_DIR}/include/*.hpp" "${CMAKE_CURRENT_SOURCE_DIR}/include/*.h")
    list(SORT dev_headers)
    set(dev_header_content "")
    foreach(header IN LISTS dev_headers)
        file(SHA256 "${header}" hash)
        string(APPEND dev_header_content "${header}:${hash}\n")
    endforeach()
    string(SHA256 dev_header_hash "${dev_header_content}")
    file(GLOB_RECURSE dev_tool_headers CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/tools/*.hpp")
    list(SORT dev_tool_headers)
    set(dev_tool_content "")
    foreach(header IN LISTS dev_tool_headers)
        file(SHA256 "${header}" hash)
        string(APPEND dev_tool_content "${header}:${hash}\n")
    endforeach()
    string(SHA256 dev_tool_hash "${dev_tool_content}")
    set(dev_seen_sources "")
    get_property(dev_targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
    foreach(target IN LISTS dev_targets)
        get_target_property(dev_sources ${target} SOURCES)
        foreach(source IN LISTS dev_sources)
            if(source MATCHES "\\.cpp$" AND NOT source MATCHES "^\\$<")
                get_filename_component(original "${source}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
                if(EXISTS "${original}" AND NOT original IN_LIST dev_seen_sources)
                    list(APPEND dev_seen_sources "${original}")
                    file(SHA256 "${original}" content)
                    set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_DEFINITIONS
                        PS2N_DEV_SOURCE_CONTENT="${content}" PS2N_DEV_HEADER_CONTENT="${dev_header_hash}")
                    if(original MATCHES "/tools/")
                        set_property(SOURCE "${source}" APPEND PROPERTY COMPILE_DEFINITIONS PS2N_DEV_TOOL_CONTENT="${dev_tool_hash}")
                    endif()
                endif()
            endif()
        endforeach()
    endforeach()
endif()
