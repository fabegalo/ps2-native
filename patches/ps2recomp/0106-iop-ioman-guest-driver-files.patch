+        // Original IOMAN file table: iop_io_file_t {mode, unit, device, privdata} in IOP RAM,
+        // so the guest drivers own and update the same records as on the console.
+        static constexpr uint32_t kMaxFiles = 16u;
+        static constexpr uint32_t kFileSize = 16u;
+        const Device *findDevice(uint32_t path, uint32_t &unit, uint32_t &rest) const;
+        uint32_t fileRecord(uint32_t fd) const { return m_files + fd * kFileSize; }
