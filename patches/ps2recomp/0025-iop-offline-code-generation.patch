+        if rs == 4: return f'cpu.cop0[{rd}] = {t};'
+        if rs == 16 and fn == 16: return 'cpu.cop0[12] = (cpu.cop0[12] & ~0x0fu) | ((cpu.cop0[12] >> 2) & 0x0fu);'
+    elif op in (32, 33, 34, 35, 36, 37, 38, 40, 41, 42, 43, 46):
