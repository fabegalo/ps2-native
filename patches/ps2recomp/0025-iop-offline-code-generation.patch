+            body = f'f.load({rt}, {value});'
+        elif op in (40, 41, 43):
+            width = {40: 8, 41: 16, 43: 32}[op]
+            body = f'memory.write{width}(address, uint{width}_t({t}));'
+        elif op in (34, 38):
+            left = op == 34
+            masks = '0x00ffffffu,0x0000ffffu,0x000000ffu,0u' if left else '0u,0xff000000u,0xffff0000u,0xffffff00u'
+            shifts = '24,16,8,0' if left else '0,8,16,24'
+            body = f'''constexpr uint32_t masks[] = {{{masks}}}, shifts[] = {{{shifts}}};
+const uint32_t lane = address & 3;
+f.load({rt}, (f.mergeValue({rt}) & masks[lane]) | (memory.read32(address & ~3u) {"<<" if left else ">>"} shifts[lane]));'''
+        else:
+            masks = '0xffffff00u,0xffff0000u,0xff000000u,0u' if op == 42 else '0u,0x000000ffu,0x0000ffffu,0x00ffffffu'
+            shifts = '24,16,8,0' if op == 42 else '0,8,16,24'
+            body = f'''constexpr uint32_t masks[] = {{{masks}}}, shifts[] = {{{shifts}}};
+const uint32_t lane = address & 3, aligned = address & ~3u;
+memory.write32(aligned, (memory.read32(aligned) & masks[lane]) | ({t} {">>" if op == 42 else "<<"} shifts[lane]));'''
+        return begin + '{ ' + body + ' }'
+    return 'f.trap(10);'
+
+def unpack(fmt, data, offset):
+    if offset < 0 or offset + struct.calcsize(fmt) > len(data):
+        raise ValueError('truncated ELF')
+    return struct.unpack_from(fmt, data, offset)
+
+def parse(data):
+    h = unpack('<16sHHIIIIIHHHHHH', data, 0)
+    if h[0][:7] != b'\x7fELF\x01\x01\x01' or h[2] != 8 or len(data) > 16 * 1024 * 1024:
+        raise ValueError('not a little-endian MIPS ELF32')
+    if h[12] and h[11] < 40 or h[10] and h[9] < 32:
+        raise ValueError('invalid ELF tables')
+    sections = [unpack('<10I', data, h[6] + i * h[11]) for i in range(h[12])]
+    programs = [unpack('<8I', data, h[5] + i * h[9]) for i in range(h[10])]
+    allocated = [s for s in sections if s[2] & 2 and s[5]]
+    segments = [p for p in programs if p[0] == 1 and p[5]]
+    addresses = [p[2] for p in segments] + [s[3] for s in allocated]
+    base = min(addresses, default=0)
+    code = {}
+    for s in sections:
+        if s[1] != 1 or not s[2] & 4: continue
+        if not s[2] & 2 or s[3] & 3 or s[5] & 3 or s[4] + s[5] > len(data):
+            raise ValueError('invalid executable section')
+        for off in range(0, s[5], 4):
+            address = s[3] - base + off
+            if address in code: raise ValueError('overlapping code sections')
+            code[address] = (unpack('<I', data, s[4] + off)[0], 0)
+    if not code: raise ValueError('no executable sections; code boundaries required')
+    for s in sections:
+        if s[1] not in (4, 9): continue
+        if s[7] >= len(sections): raise ValueError('invalid relocation target section')
+        target = sections[s[7]]
+        stride = max(s[9], 12 if s[1] == 4 else 8)
+        if s[5] % stride: raise ValueError('truncated relocations')
+        for off in range(0, s[5], stride):
+            address, info = unpack('<II', data, s[4] + off)
+            if h[1] not in (0xff80, 0xff81): address += target[3]
+            address -= base
+            if address not in code: continue
+            kind = info & 255
+            mask = {0: 0, 1: 0xffff, 4: 0x03ffffff, 5: 0xffff, 6: 0xffff}.get(kind)
+            if mask is None: raise ValueError('full-word relocation in executable section is unsupported')
+            word, previous = code[address]
+            if previous: raise ValueError('overlapping instruction relocations')
+            code[address] = word, mask
+    return code
+
+def changed(path, data):
+    data = data.encode()
+    if path.exists() and path.read_bytes() == data: return
+    temporary = path.with_suffix(path.suffix + '.tmp')
+    temporary.write_bytes(data)
+    temporary.replace(path)
+
+def generate(source, output):
+    data = source.read_bytes()
+    code = parse(data)
+    identity = hashlib.sha256(data).hexdigest()
+    output.mkdir(parents=True, exist_ok=True)
+    instructions = sorted(set(code.values()))
+    names = {(w, m): f'iop_{identity}_{w:08x}_{m:08x}' for w, m in instructions}
+    prefix = '#include "emulator/services/iop_aot_frame.h"\nusing namespace ps2x::iop::detail;\n'
+    for bucket in range(16):
+        functions = []
+        for word, mask in instructions:
+            if ((word >> 8) ^ word) % 16 != bucket: continue
+            functions.append(f'bool {names[word, mask]}(IopCpuState& cpu, IopMemory& memory, uint32_t) {{\nIopAotFrame f(cpu, memory);\n' + operation(word, mask) + '\nreturn f.finish();\n}\n')
+        changed(output / f'ops_{bucket:02d}.cpp', prefix + ''.join(functions))
+    declarations = ''.join(f'extern bool {name}(IopCpuState&, IopMemory&, uint32_t);\n' for name in names.values())
+    image = ','.join(str(x) for x in data)
+    entries = ',\n'.join(f'{{{off}u, {names[word, mask]}, 0x{word:08x}u, 0x{mask:08x}u}}' for off, (word, mask) in sorted(code.items()))
+    descriptor = prefix + '#include "ps2x/iop/iop_aot.h"\n' + declarations
+    descriptor += f'void register_iop_{identity}() {{ ps2x::iop::registerIopAotModule({{{{{image}}}, {{\n{entries}\n}}}}); }}\n'
+    changed(output / 'module.cpp', descriptor)
+    return {'identity': identity, 'instructions': len(code), 'functions': len(instructions)}
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument('source', type=Path)
+    parser.add_argument('output', type=Path)
+    args = parser.parse_args()
+    print(json.dumps(generate(args.source, args.output)))
+
+if __name__ == '__main__':
+    main()
