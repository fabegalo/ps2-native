+        alignment = 1 if op in (33, 37, 41) else 3 if op in (35, 43) else 0
+        if alignment: begin += f'if (address & {alignment}) {{ f.trap({5 if op >= 40 else 4}, address); }} else '
+        if op in (32, 33, 35, 36, 37):
