+#!/usr/bin/env python3
+"""Offline R3000A -> C++ for the pinned PS2Recomp IOP loader. GPL-3.0-or-later.
+Instruction semantics derive from ps2xIOP's iop_cpu.cpp; no guest decoding is
+performed by the emitted functions. Originals are only read.
+"""
+import argparse
+import hashlib
+import json
+from pathlib import Path
+import struct
+
+def operation(word, relocation=0):
+    op, rs, rt, rd, sa, fn = word >> 26, (word >> 21) & 31, (word >> 16) & 31, (word >> 11) & 31, (word >> 6) & 31, word & 63
+    r, t = f'cpu.gpr[{rs}]', f'cpu.gpr[{rt}]'
+    imm = '(memory.read32(cpu.pc) & 0xffffu)' if relocation & 0xffff else f'{word & 65535}u'
+    simm = f'int32_t(int16_t({imm}))'
+    write = lambda reg, value: f'f.write({reg}, {value});'
+    branch = lambda cond: f'f.branch({cond}, {simm});'
+    if op == 0:
+        values = {
+            0: f'{t} << {sa}', 2: f'{t} >> {sa}', 3: f'uint32_t(int32_t({t}) >> {sa})',
+            4: f'{t} << ({r} & 31)', 6: f'{t} >> ({r} & 31)', 7: f'uint32_t(int32_t({t}) >> ({r} & 31))',
+            16: 'cpu.hi', 18: 'cpu.lo', 33: f'{r} + {t}', 35: f'{r} - {t}',
+            36: f'{r} & {t}', 37: f'{r} | {t}', 38: f'{r} ^ {t}', 39: f'~({r} | {t})',
+            42: f'int32_t({r}) < int32_t({t})', 43: f'{r} < {t}',
+        }
+        if fn in values: return write(rd, values[fn])
+        if fn == 8: return f'f.jump({r});'
+        if fn == 9: return f'const uint32_t target = {r}; ' + write(rd, 'f.pc + 8') + ' f.jump(target);'
+        if fn in (12, 13): return f'f.trap({8 if fn == 12 else 9});'
+        if fn in (17, 19): return f'cpu.{"hi" if fn == 17 else "lo"} = {r};'
+        if fn in (24, 25):
+            value = f'int64_t(int32_t({r})) * int64_t(int32_t({t}))' if fn == 24 else f'uint64_t({r}) * {t}'
+            return f'const uint64_t value = uint64_t({value}); cpu.lo = uint32_t(value); cpu.hi = uint32_t(value >> 32);'
+        if fn == 26:
+            return f'''const int32_t a = int32_t({r}), b = int32_t({t});
+if (!b) {{ cpu.lo = a >= 0 ? 0xffffffffu : 1; cpu.hi = uint32_t(a); }}
+else if (a == std::numeric_limits<int32_t>::min() && b == -1) {{ cpu.lo = uint32_t(a); cpu.hi = 0; }}
+else {{ cpu.lo = uint32_t(a / b); cpu.hi = uint32_t(a % b); }}'''
+        if fn == 27: return f'if (!{t}) {{ cpu.lo = 0xffffffffu; cpu.hi = {r}; }} else {{ cpu.lo = {r} / {t}; cpu.hi = {r} % {t}; }}'
+        if fn in (32, 34): return f'f.overflow(int64_t(int32_t({r})) {"+" if fn == 32 else "-"} int64_t(int32_t({t})), {rd});'
+    elif op == 1:
+        if rt in (0, 1, 16, 17):
+            return f'const bool take = int32_t({r}) {"<" if not rt & 1 else ">="} 0; ' + (write(31, 'f.pc + 8') if rt & 16 else '') + branch('take')
+    elif op in (2, 3):
+        target = '(memory.read32(cpu.pc) & 0x03ffffffu)' if relocation else f'{word & 0x03ffffff}u'
+        return (write(31, 'f.pc + 8') if op == 3 else '') + f'f.jump((f.nextPc & 0xf0000000u) | ({target} << 2));'
+    elif op in (4, 5): return branch(f'{r} {"==" if op == 4 else "!="} {t}')
+    elif op in (6, 7): return branch(f'int32_t({r}) {"<=" if op == 6 else ">"} 0')
+    elif op == 8: return f'f.overflow(int64_t(int32_t({r})) + {simm}, {rt});'
+    elif op in (9, 10, 11, 12, 13, 14, 15):
+        value = {9: f'{r} + uint32_t({simm})', 10: f'int32_t({r}) < {simm}', 11: f'{r} < uint32_t({simm})',
