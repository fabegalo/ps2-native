+#pragma once
+// R3000A pipeline helpers for emitted operations. No instruction fetch or decoder.
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+#include <limits>
+
+namespace ps2x::iop::detail {
+struct IopAotFrame {
+    IopCpuState& cpu;
+    IopMemory& memory;
+    const uint32_t pc, nextPc, priorBranchTarget;
+    const bool wasDelaySlot;
+    uint32_t writtenReg = 0, scheduledReg = 0, scheduledValue = 0, newBranchTarget = 0;
+    bool scheduledLoad = false, newBranch = false;
+    IopAotFrame(IopCpuState& c, IopMemory& m)
+        : cpu(c), memory(m), pc(c.pc), nextPc(c.pc + 4),
+          priorBranchTarget(c.branchTarget), wasDelaySlot(c.branchPending) {
+        cpu.branchPending = false; cpu.exception = false; cpu.yielded = false;
+    }
+    void write(uint32_t r, uint32_t value) {
+        if (r) { cpu.gpr[r] = value; writtenReg = r; }
+    }
+    void load(uint32_t r, uint32_t value) {
+        if (r) { scheduledLoad = true; scheduledReg = r; scheduledValue = value; }
+    }
+    void jump(uint32_t target) { newBranch = true; newBranchTarget = target; }
+    void branch(bool condition, int32_t displacement) {
+        jump(condition ? nextPc + (uint32_t(displacement) << 2) : pc + 8);
+    }
+    void trap(uint32_t code, std::optional<uint32_t> badAddress = std::nullopt) {
+        IopCpuCore(memory).raiseException(cpu, code, pc, wasDelaySlot, badAddress);
+    }
+    void overflow(int64_t value, uint32_t r) {
+        if (value < std::numeric_limits<int32_t>::min() ||
+            value > std::numeric_limits<int32_t>::max()) trap(12);
+        else write(r, uint32_t(value));
+    }
+    uint32_t mergeValue(uint32_t r) const {
+        return cpu.pendingLoad && cpu.pendingLoadReg == r ? cpu.pendingLoadValue : cpu.gpr[r];
+    }
+    bool finish() {
+        cpu.gpr[0] = 0;
+        if (cpu.exception) return !cpu.stopped;
+        if (cpu.pendingLoad && cpu.pendingLoadReg && cpu.pendingLoadReg != writtenReg)
+            cpu.gpr[cpu.pendingLoadReg] = cpu.pendingLoadValue;
+        cpu.pendingLoad = scheduledLoad;
+        if (scheduledLoad) { cpu.pendingLoadReg = scheduledReg; cpu.pendingLoadValue = scheduledValue; }
+        cpu.gpr[0] = 0;
+        if (wasDelaySlot) { cpu.pc = priorBranchTarget; cpu.branchPending = false; }
+        else { cpu.pc = nextPc; cpu.branchPending = newBranch; cpu.branchTarget = newBranchTarget; }
+        return !cpu.stopped;
+    }
+};
+}
