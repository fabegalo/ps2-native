+        uint32_t invokeBootCallback(const BootCallback& callback, uint32_t next, uint32_t delayed)
+        {
+            const auto argument = allocate(sizeof(uint32_t));
+            if (!argument) throw std::runtime_error("Cannot allocate IOP post-boot callback argument");
+            memory.write32(argument, next);
+            try
+            {
+                const auto result = executeGuestFunction(callback.function, argument, delayed, 0, 0, callback.gp);
+                freeAllocation(argument);
+                return result;
+            }
+            catch (...) { freeAllocation(argument); throw; }
+        }
+
+        void finishBootstrap()
+        {
+            if (bootState == BootState::Complete) return;
+            if (bootState != BootState::Pending)
+                throw std::runtime_error("IOP bootstrap callbacks are not pending");
+            bootState = BootState::Completing;
+            try
+            {
+                for (bootPriority = 0; bootPriority < 4; ++bootPriority)
+                {
+                    for (size_t i = 0; i < bootCallbacks.size(); ++i)
+                    {
+                        const auto callback = bootCallbacks[i]; // Registration may append during a callback.
+                        if (callback.priority != bootPriority) continue;
+                        const auto& next = bootCallbacks[bootPriority == 3 ? i : 0];
+                        invokeBootCallback(callback, next.function | next.priority, 1);
+                    }
+                    if (bootPriority == 2)
+                        while (!bootCallbacks.empty() && bootCallbacks.back().priority != 3)
+                            bootCallbacks.pop_back();
+                }
+                bootCallbacks.clear();
+                bootState = BootState::Complete;
+            }
+            catch (...) { bootState = BootState::Failed; throw; }
         }
 
