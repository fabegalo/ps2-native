@@ -0,0 +1,14 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+#include <utility>
+
+// Leaves guest state intact; the session supervisor receives the request after worker join.
+struct GuestExecutableRequest final : std::runtime_error {
+    const uint32_t syscall, sourcePc;
+    const std::array<uint32_t, 4> arguments;
+    GuestExecutableRequest(uint32_t number, uint32_t pc, std::array<uint32_t, 4> values, std::string detail)
+        : std::runtime_error(std::move(detail)), syscall(number), sourcePc(pc), arguments(values) {}
+};
