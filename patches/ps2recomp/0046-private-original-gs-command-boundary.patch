--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_command_backend.h
@@ -0,0 +1,36 @@
+#pragma once
+#include "runtime/gs/gs_backend.h"
+
+// Optional command device: preserve original packets instead of rebuilding them
+// from raster batches. The public runtime and generated EE ABI stay unchanged.
+class GSCommandBackend
+{
+public:
+    virtual ~GSCommandBackend() = default;
+    virtual void submitGsPacket(const uint8_t* data, uint32_t size) = 0;
+    virtual void writeGsRegister(uint8_t address, uint64_t value) = 0;
+    void notifyGsRegister(uint8_t address, uint64_t value) {
+        if (!m_mirrorDepth) writeGsRegister(address, value);
+    }
+    bool mirroringGsPacket() const { return m_mirrorDepth != 0; }
+private:
+    friend class GSCommandPacketScope;
+    unsigned m_mirrorDepth = 0;
+};
+
+class GSCommandPacketScope
+{
+public:
+    GSCommandPacketScope(GSRasterBackend* raster, const uint8_t* data, uint32_t size)
+        : m_commands(dynamic_cast<GSCommandBackend*>(raster)) {
+        if (m_commands) {
+            m_commands->submitGsPacket(data, size);
+            ++m_commands->m_mirrorDepth;
+        }
+    }
+    ~GSCommandPacketScope() { if (m_commands) --m_commands->m_mirrorDepth; }
+    GSCommandPacketScope(const GSCommandPacketScope&) = delete;
+    GSCommandPacketScope& operator=(const GSCommandPacketScope&) = delete;
+private:
+    GSCommandBackend* m_commands;
+};
