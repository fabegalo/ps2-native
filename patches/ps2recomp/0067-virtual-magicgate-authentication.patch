+MgBlock xorBlock(MgBlock a,const MgBlock& b) { for(unsigned i=0;i<8;++i)a[i]^=b[i]; return a; }
+MgBlock cbc(const MgKey& key,const MgBlock& input,const MgBlock& iv,bool decrypt=false) {
+    return decrypt?xorBlock(mgTripleDes(key,input,true),iv):mgTripleDes(key,xorBlock(input,iv));
+}
+MgKey derive(const std::array<uint8_t,72>& identity,const MgBlock& iv,const MgBlock& material) {
+    MgKey left{},right{}; MgBlock liv{},riv{};
+    std::copy_n(identity.begin(),16,left.begin()); std::copy_n(identity.begin()+16,8,liv.begin());
+    std::copy_n(identity.begin()+24,16,right.begin()); std::copy_n(identity.begin()+40,8,riv.begin());
+    const auto block=xorBlock(iv,material); const auto a=cbc(left,block,liv),b=cbc(right,block,riv);
+    MgKey result{}; std::copy(a.begin(),a.end(),result.begin()); std::copy(b.begin(),b.end(),result.begin()+8); return result;
+}
+MgBlock challengeIv(const std::array<uint8_t,72>& identity) { MgBlock result{};std::copy_n(identity.begin()+48,8,result.begin());return result; }
+void random(IopHost& host,std::span<uint8_t> bytes) { if(!host.randomBytes(bytes.data(),bytes.size())) throw std::runtime_error("MagicGate requires host entropy"); }
+}
+MgBlock mgTripleDes(const MgKey& key,const MgBlock& block,bool decrypt) {
+    const auto a=number(std::span(key).first<8>()),b=number(std::span(key).last<8>());
+    auto value=des(a,number(block),decrypt); value=des(b,value,!decrypt); value=des(a,value,decrypt);
+    MgBlock result{};for(unsigned i=0;i<8;++i)result[7-i]=uint8_t(value>>(i*8));return result;
+}
+void IopMagicGate::reset() { m_cards={};m_mecha={}; }
+IopMagicGate::Card& IopMagicGate::identity(IopHost& host,unsigned port) {
+    if(port>=m_cards.size()) throw std::runtime_error("MagicGate port is unsupported");
+    auto& c=m_cards[port];
+    if(!c.identityLoaded) {
+        if(!host.memoryCardKeyset(int(port),c.identity.data(),c.identity.size())) throw std::runtime_error("MagicGate virtual identity is unavailable");
+        c.identityLoaded=true;
+    }
+    return c;
+}
+bool IopMagicGate::card(IopHost& host,unsigned port,uint8_t command,uint8_t mode,std::span<const uint8_t> input,MgBlock& output) {
+    auto& c=identity(host,port); output={};
+    const auto fail=[&] { c.phase=0;c.authenticated=false;return false; };
+    if(command==0xf3) { c.phase=0;c.authenticated=false;return true; }
+    if(command==0xf7) { if(mode!=1)return fail();c.phase=0;c.authenticated=false;return true; }
+    if(command!=0xf0 || mode>0x14 || c.phase!=mode) return fail();
+    if(mode==0) {
+        c.authenticated=false; std::copy_n(c.identity.begin()+56,8,c.iv.begin());std::copy_n(c.identity.begin()+64,8,c.material.begin());random(host,c.nonce);random(host,c.session);
+        c.key=derive(c.identity,c.iv,c.material); c.challenges={};c.responses={};
+    } else if(mode==1) output=c.iv;
+    else if(mode==2) output=c.material;
+    else if(mode==4) output=c.nonce;
+    else if(mode==6 || mode==7 || mode==0xb) {
+        if(input.size()!=8)return fail();
+        const unsigned index=mode==6?2:mode==7?1:0;
+        std::copy(input.begin(),input.end(),c.challenges[index].begin());
+    } else if(mode==8) {
+        if(cbc(c.key,c.challenges[2],c.challenges[1],true)!=c.iv)return fail();
+    } else if(mode==0xc) {
+        if(cbc(c.key,c.challenges[1],c.challenges[0],true)!=c.nonce)return fail();
+        c.mechaNonce=cbc(c.key,c.challenges[0],challengeIv(c.identity),true);
+        c.responses[0]=cbc(c.key,c.nonce,challengeIv(c.identity));
+        c.responses[1]=cbc(c.key,c.mechaNonce,c.responses[0]);
+        c.responses[2]=cbc(c.key,c.session,c.responses[1]);
+    } else if(mode==0xf || mode==0x11 || mode==0x13) output=c.responses[(mode-0xf)/2];
+    else if(mode==0x14)c.authenticated=true;
+    ++c.phase;return true;
+}
+bool IopMagicGate::mecha(IopHost& host,uint8_t command,std::span<const uint8_t> input,std::vector<uint8_t>& output) {
+    auto& m=m_mecha; output={0};
+    const auto fail=[&] { m.phase=0;m.authenticated=false;output={0x80};return true; };
