+template<size_t N> uint64_t rearrange(uint64_t value,unsigned bits,const uint8_t(&table)[N]) {
+    uint64_t result=0; for(auto bit:table) result=(result<<1)|((value>>(bits-bit))&1); return result;
+}
+uint64_t number(std::span<const uint8_t> bytes) { uint64_t v=0; for(auto b:bytes) v=(v<<8)|b; return v; }
+uint64_t des(uint64_t key,uint64_t value,bool decrypt) {
+    const auto k=rearrange(key,64,pc1); uint32_t c=uint32_t(k>>28),d=uint32_t(k)&0xfffffff;
+    std::array<uint64_t,16> rounds{};
