+    value=rearrange(value,64,ip); uint32_t l=uint32_t(value>>32),r=uint32_t(value);
+    for(unsigned i=0;i<16;++i) {
+        const auto expanded=rearrange(r,32,expand)^rounds[decrypt?15-i:i]; uint32_t sub=0;
+        for(unsigned j=0;j<8;++j) { const auto b=unsigned((expanded>>(42-j*6))&63); const auto row=((b&32)>>4)|(b&1); sub=(sub<<4)|box[j][row*16+((b>>1)&15)]; }
