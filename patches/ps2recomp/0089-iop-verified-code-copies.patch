+IopCodeOrigin IopAotRegistry::origin(uint32_t address, uint32_t word) const {
+    address = IopMemory::physicalAddress(address);
+    const auto* entry = find(address);
+    if (!entry || !entry->execute || entry->instruction != word) return {};
+    return {entry->source, entry->generation};
+}
+
+void IopAotRegistry::copy(IopCodeOrigin origin, uint32_t destination, uint32_t word) {
+    destination = IopMemory::physicalAddress(destination);
+    if (!origin.generation || (destination & 3u) || destination >= IopMemory::RamSize) return;
+    const auto* source = find(origin.address);
+    if (!source || !source->execute || source->generation != origin.generation) return;
+    const bool patched = source->instruction != word;
+    if (patched && (!source->copyExecute || ((source->instruction ^ word) & ~source->copyMask))) return;
+    const auto* existing = find(destination);
+    // Loaded module code retains its original validation; only copied code can replace an alias.
+    if (existing && existing->execute && existing->source == destination) return;
+    auto entry = *source;
+    if (patched) { entry.execute = source->copyExecute; entry.instruction = word; }
+    auto& page = pages[destination >> 12];
+    if (!page) page = std::make_unique<BoundEntry[]>(1024);
+    auto& target = page[(destination & 0xfffu) >> 2];
+    if (!target.execute) ++count;
+    target = entry;
+}
