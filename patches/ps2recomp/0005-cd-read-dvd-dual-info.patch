+    void sceCdReadDvdDualInfo(uint8_t *rdram, R5900Context *ctx, PS2Runtime *runtime)
+    {
+        // int sceCdReadDvdDualInfo(int *on_dual, u_int *layer1_start). A dual-layer
+        // image holds a second ISO volume at the first volume's size; layer 1
+        // starts 16 sectors before that volume descriptor.
+        int32_t onDual = 0;
+        uint32_t layer1Start = 0u;
+        uint8_t sector[kCdSectorSize];
+        if (readCdSectors(16u, 1u, sector, sizeof(sector)) && std::memcmp(sector + 1, "CD001", 5) == 0)
+        {
+            uint32_t volumeSectors = 0u;
+            std::memcpy(&volumeSectors, sector + 80, sizeof(volumeSectors));
+            uint64_t totalSectors = 0u;
+            if (volumeSectors > 16u && tryGetCdImageTotalSectors(totalSectors) && totalSectors > volumeSectors &&
+                readCdSectors(volumeSectors, 1u, sector, sizeof(sector)) && sector[0] == 1u &&
+                std::memcmp(sector + 1, "CD001", 5) == 0)
+            {
+                onDual = 1;
+                layer1Start = volumeSectors - 16u;
+            }
+        }
+        g_lastCdError = 0;
+        if (uint8_t *dual = getMemPtr(rdram, getRegU32(ctx, 4)))
+        {
+            std::memcpy(dual, &onDual, sizeof(onDual));
+        }
+        if (uint8_t *start = getMemPtr(rdram, getRegU32(ctx, 5)))
+        {
+            std::memcpy(start, &layer1Start, sizeof(layer1Start));
+        }
+        setReturnS32(ctx, 1);
+    }
