+    // Bytes of whole GIF tags (tag + payload) at the start of a PATH3 stream.
+    uint32_t completeGifTagBytes(const uint8_t *data, uint32_t sizeBytes)
+    {
+        uint32_t offset = 0;
+        while (sizeBytes - offset >= 16u)
+        {
+            uint64_t tag = 0;
+            std::memcpy(&tag, data + offset, sizeof(tag));
+            const uint64_t loops = tag & 0x7FFFu, format = (tag >> 58u) & 3u;
+            const uint64_t registers = ((tag >> 60u) & 15u) ? ((tag >> 60u) & 15u) : 16u;
+            const uint64_t payload = format == 0u ? loops * registers * 16u :
+                format == 1u ? ((loops * registers * 8u + 15u) & ~15ull) : loops * 16u;
+            if (sizeBytes - offset - 16u < payload)
+                break;
+            offset += 16u + static_cast<uint32_t>(payload);
+        }
+        return offset;
+    }
+}
