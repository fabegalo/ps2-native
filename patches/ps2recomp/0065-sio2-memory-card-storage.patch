+}
+void Image::import(const std::filesystem::path& directory,const std::string& path) {
+    for(const auto& item:std::filesystem::directory_iterator(directory)) {
+        if(item.path()==m_path||item.path()==std::filesystem::path(m_path.native()+std::filesystem::path(".lock").native())) continue;
+        if(item.is_symlink()) throw Error(-5,"Memory-card import refuses symbolic links");
+        const auto utf8=item.path().filename().u8string(); const std::string name(utf8.begin(),utf8.end());
+        const auto child=path=="/"?path+name:path+"/"+name;
+        const auto modified=std::chrono::time_point_cast<std::chrono::system_clock::duration>(
+            item.last_write_time()-std::filesystem::file_time_type::clock::now()+std::chrono::system_clock::now());
+        if(item.is_directory()) { create(child,true); import(item.path(),child); }
+        else if(item.is_regular_file()) {
+            const auto size=item.file_size(); if(size>Pages*PageBytes) throw Error(-7,"Legacy save exceeds memory-card capacity");
+            std::vector<uint8_t> bytes(size); std::ifstream input(item.path(),std::ios::binary);
+            if(size&&!input.read(reinterpret_cast<char*>(bytes.data()),size)) throw Error(-5,"Cannot import existing memory-card save");
+            create(child,false); write(child,0,bytes);
+        } else throw Error(-5,"Unsupported file type in memory-card import");
+        const auto when=std::chrono::system_clock::to_time_t(modified); std::tm t{};
+#ifdef _WIN32
+        gmtime_s(&t,&when);
+#else
+        gmtime_r(&when,&t);
+#endif
+        auto metadata=stat(child); auto* date=metadata.bytes.data()+8;
+        date[0]=0; date[1]=uint8_t(t.tm_sec); date[2]=uint8_t(t.tm_min); date[3]=uint8_t(t.tm_hour);
+        date[4]=uint8_t(t.tm_mday); date[5]=uint8_t(t.tm_mon+1); date[6]=uint8_t((t.tm_year+1900)&255); date[7]=uint8_t((t.tm_year+1900)>>8);
+        std::copy_n(date,8,metadata.bytes.data()+24); update(metadata);
+    }
+}
+void Image::flush() {
+    if(!m_dirty) return;
+    auto temporary=m_path; temporary += ".pending";
+    std::ofstream output(temporary,std::ios::binary|std::ios::trunc);
+    if(!output.write(reinterpret_cast<const char*>(m_raw.data()),m_raw.size())||!output.flush()) throw Error(-5,"Cannot persist memory-card data");
+    output.close(); if(!output) throw Error(-5,"Cannot close memory-card transaction");
+#ifdef _WIN32
+    if(!MoveFileExW(temporary.c_str(),m_path.c_str(),MOVEFILE_REPLACE_EXISTING|MOVEFILE_WRITE_THROUGH)) throw Error(-5,"Cannot publish memory-card transaction");
+#else
+    const int fd=open(temporary.c_str(),O_RDONLY);
+    if(fd<0) throw Error(-5,"Cannot open memory-card transaction for synchronization");
+    const bool synced=fsync(fd)==0; close(fd); if(!synced) throw Error(-5,"Cannot synchronize memory-card transaction");
+    std::filesystem::rename(temporary,m_path);
+#endif
+    m_dirty=false;
+}
