+            std::ifstream input(m_path,std::ios::binary);
+            if(!input.read(reinterpret_cast<char*>(m_raw.data()),m_raw.size())) throw Error(-5,"Cannot read memory-card image");
+        } else {
+            format(); import(m_path.parent_path(),"/"); flush();
+        }
+    } catch(...) { unlock(m_lock); m_lock=-1; throw; }
+}
+Image::~Image() {
+    try { flush(); } catch(const std::exception& error) { std::fprintf(stderr,"[memory-card] flush failed: %s\n",error.what()); }
+    unlock(m_lock);
+}
+void Image::readRaw(uint32_t address,std::span<uint8_t> output) const {
+    if(address>m_raw.size()||output.size()>m_raw.size()-address) throw Error(-5,"Memory-card read outside NAND");
+    std::copy_n(m_raw.begin()+address,output.size(),output.begin());
+}
+void Image::writeRaw(uint32_t address,std::span<const uint8_t> input) {
+    if(address>m_raw.size()||input.size()>m_raw.size()-address) throw Error(-5,"Memory-card write outside NAND");
+    for(size_t i=0;i<input.size();++i) m_raw[address+i]&=input[i];
+    m_dirty=true;
+}
+void Image::eraseBlock(uint32_t page) {
+    if(page%16||page>Pages-16) throw Error(-5,"Unaligned or out-of-range memory-card erase");
+    std::fill_n(m_raw.begin()+page*RawPageBytes,16*RawPageBytes,0xff); m_dirty=true;
+}
+void Image::data(uint32_t address,std::span<uint8_t> output) const {
+    if(address>Pages*PageBytes||output.size()>Pages*PageBytes-address) throw Error(-5,"Memory-card filesystem address outside data area");
+    while(!output.empty()) {
+        const size_t count=std::min<size_t>(PageBytes-address%PageBytes,output.size());
+        std::copy_n(m_raw.begin()+(address/PageBytes)*RawPageBytes+address%PageBytes,count,output.begin());
+        address+=uint32_t(count); output=output.subspan(count);
+    }
+}
+void Image::data(uint32_t address,std::span<const uint8_t> input) {
+    if(address>Pages*PageBytes||input.size()>Pages*PageBytes-address) throw Error(-5,"Memory-card filesystem write outside data area");
+    while(!input.empty()) {
+        const auto page=address/PageBytes; const size_t count=std::min<size_t>(PageBytes-address%PageBytes,input.size());
+        auto* raw=m_raw.data()+page*RawPageBytes;
+        std::copy_n(input.begin(),count,raw+address%PageBytes);
+        for(unsigned quarter=0;quarter<4;++quarter) ecc(raw+PageBytes+quarter*3,raw+quarter*128);
+        address+=uint32_t(count); input=input.subspan(count);
+    }
+    m_dirty=true;
+}
+uint32_t Image::word(uint32_t address) const { std::array<uint8_t,4> v{}; data(address,std::span<uint8_t>(v)); return get(v.data()); }
+void Image::word(uint32_t address,uint32_t value) { std::array<uint8_t,4> v{}; put(v.data(),value); data(address,std::span<const uint8_t>(v)); }
+bool Image::formatted() const {
+    static constexpr char magic[]="Sony PS2 Memory Card Format ";
+    return std::equal(magic,magic+27,m_raw.begin()) && word(0x28)==0x00020200 && word(0x30)==8192;
