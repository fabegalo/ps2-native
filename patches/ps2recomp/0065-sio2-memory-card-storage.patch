+uint32_t get(const uint8_t* p) { return p[0] | uint32_t(p[1]) << 8 | uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24; }
+void put(uint8_t* p, uint32_t v) { for (unsigned i = 0; i < 4; ++i) p[i] = uint8_t(v >> (8*i)); }
+void stamp(uint8_t* p) {
+    const auto now = std::time(nullptr); std::tm t{};
+#ifdef _WIN32
+    gmtime_s(&t, &now);
+#else
+    gmtime_r(&now, &t);
+#endif
+    p[0]=0; p[1]=uint8_t(t.tm_sec); p[2]=uint8_t(t.tm_min); p[3]=uint8_t(t.tm_hour);
+    p[4]=uint8_t(t.tm_mday); p[5]=uint8_t(t.tm_mon+1); p[6]=uint8_t((t.tm_year+1900)&255); p[7]=uint8_t((t.tm_year+1900)>>8);
+}
+// PS2 NAND ECC: parity of each 128-byte quarter-page, including row parity.
+void ecc(uint8_t* out, const uint8_t* bytes) {
+    static constexpr uint8_t parity[8] = {0x87,0x96,0xa5,0xb4,0xc3,0xd2,0xe1,0xf0};
+    uint8_t a=0,b=0,c=0;
+    for (unsigned i=0;i<128;++i) {
+        uint8_t column=0;
+        for(unsigned bit=0;bit<8;++bit) if(bytes[i]&(1u<<bit)) column^=parity[bit];
+        a^=column;
+        if(column&0x80) { b^=uint8_t(~i); c^=uint8_t(i); }
+    }
+    out[0]=uint8_t(~a)&0x77; out[1]=uint8_t(~b)&0x7f; out[2]=uint8_t(~c)&0x7f;
+}
+std::pair<std::string,std::string> split(const std::string& path) {
+    if(path.size()>1024) throw Error(-5,"Memory-card path is too long");
+    const auto end=path.find_last_of('/');
+    const auto name=path.substr(end==std::string::npos?0:end+1);
+    if(name.empty()||name=="."||name==".."||name.size()>31||name.find('\\')!=std::string::npos)
+        throw Error(-5,"Invalid PS2 memory-card name");
+    return {end==std::string::npos||end==0?"/":path.substr(0,end),name};
+}
+void unlock(intptr_t value) {
+    if(value==-1) return;
+#ifdef _WIN32
+    CloseHandle(reinterpret_cast<HANDLE>(value));
+#else
+    close(int(value));
+#endif
+}
+}
+uint32_t Image::Entry::mode() const { return get(bytes.data()); }
+uint32_t Image::Entry::size() const { return get(bytes.data()+4); }
+uint32_t Image::Entry::cluster() const { return get(bytes.data()+16); }
+std::string Image::Entry::name() const {
+    const auto first=bytes.begin()+64, last=std::find(first,first+32,0);
+    if(last==first+32) throw Error(-5,"Unterminated memory-card directory name");
+    return std::string(first,last);
