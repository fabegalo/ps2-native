+#else
+    m_lock=open(lockPath.c_str(),O_CREAT|O_RDWR,0600);
+    if(m_lock==-1||flock(int(m_lock),LOCK_EX|LOCK_NB)!=0) { unlock(m_lock); m_lock=-1; throw Error(-5,"Memory card is already in use or inaccessible"); }
+#endif
+    try {
+        auto pending=m_path; pending += ".pending";
+        if(std::filesystem::exists(pending)) throw Error(-5,"Unfinished memory-card transaction; preserving recovery files");
+        if(std::filesystem::exists(m_path)) {
