+std::filesystem::path cardNativePath(const std::filesystem::path& path) {
+    if(path.empty()||path.native().find(std::filesystem::path::value_type{})!=std::filesystem::path::string_type::npos)
+        throw Error(-5,"Memory-card root is empty or contains NUL");
+#ifdef _WIN32
+    if(path.native().starts_with(L"\\\\?\\")) {
+        if(path.native().size()>=32767) throw Error(-5,"Memory-card path exceeds the Windows path limit");
+        return path;
+    }
+    auto native=std::filesystem::absolute(path).lexically_normal().native();
+    if(native.starts_with(L"\\\\.\\")) throw Error(-5,"Memory-card path cannot name a Windows device");
+    if(!native.starts_with(L"\\\\?\\")) native=native.starts_with(L"\\\\")?L"\\\\?\\UNC\\"+native.substr(2):L"\\\\?\\"+native;
+    if(native.size()>=32767) throw Error(-5,"Memory-card path exceeds the Windows path limit");
+    return std::filesystem::path(native);
+#else
+    return path;
+#endif
