+        if(name=="."||name=="..") throw Error(-5,"Unnormalized memory-card path");
+        bool found=false;
+        for(const auto& child:entries(current)) if((child.mode()&0x8000)&&child.name()==name) { current=child; found=true; break; }
+        if(!found) throw Error(-4,"Memory-card path does not exist");
+    }
+    return current;
