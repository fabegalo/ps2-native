+Image::Image(const std::filesystem::path& root) : m_path(cardNativePath(root) / ".ps2n-card.raw"), m_raw(Pages*RawPageBytes,0xff) {
+    std::filesystem::create_directories(m_path.parent_path());
+    auto lockPath=m_path; lockPath += ".lock";
+#ifdef _WIN32
+    const auto handle=CreateFileW(lockPath.c_str(),GENERIC_READ|GENERIC_WRITE,0,nullptr,OPEN_ALWAYS,FILE_ATTRIBUTE_NORMAL,nullptr);
+    if(handle==INVALID_HANDLE_VALUE) throw Error(-5,"Memory card is already in use or inaccessible");
