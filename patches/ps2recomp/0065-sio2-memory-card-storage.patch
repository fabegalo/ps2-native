+size_t Image::read(const std::string& path,uint32_t offset,std::span<uint8_t> output) const {
+    const auto file=stat(path); if(file.directory()) throw Error(-5,"Cannot read a memory-card directory as a file");
+    if(offset>=file.size()) return 0;
+    const auto count=std::min<size_t>(output.size(),file.size()-offset); const auto clusters=chain(file.cluster());
+    if(file.size()>clusters.size()*1024) throw Error(-5,"Memory-card file exceeds its allocation");
+    size_t done=0;
+    while(done<count) { const auto chunk=std::min<size_t>(1024-offset%1024,count-done); data(clusterAddress(clusters[offset/1024])+offset%1024,output.subspan(done,chunk)); done+=chunk; offset+=uint32_t(chunk); }
