+        int32_t readMcHandleLocked(int fd,void* output,size_t size) {
+            auto& file=mcFile(fd);
+            if((!output&&size)||size>INT32_MAX||(file.flags&PS2_FIO_O_RDWR)==PS2_FIO_O_WRONLY) return -5;
+            const auto count=file.image->read(file.guestPath,file.cursor,std::span<uint8_t>(static_cast<uint8_t*>(output),size));
+            file.cursor+=uint32_t(count); return int32_t(count);
+        }
+        int32_t writeMcHandleLocked(int fd,const void* input,size_t size) {
+            auto& file=mcFile(fd); const auto access=file.flags&PS2_FIO_O_RDWR;
+            if((!input&&size)||size>INT32_MAX||(access!=PS2_FIO_O_WRONLY&&access!=PS2_FIO_O_RDWR)) return -5;
+            if(file.flags&PS2_FIO_O_APPEND) file.cursor=file.image->stat(file.guestPath).size();
+            file.image->write(file.guestPath,file.cursor,std::span<const uint8_t>(static_cast<const uint8_t*>(input),size));
+            file.image->flush(); file.cursor+=uint32_t(size); return int32_t(size);
+        }
+        int32_t seekMcHandleLocked(int fd,int64_t offset,int whence) {
+            auto& file=mcFile(fd); int64_t base=0;
+            if(whence==SEEK_CUR) base=file.cursor;
+            else if(whence==SEEK_END) base=file.image->stat(file.guestPath).size();
