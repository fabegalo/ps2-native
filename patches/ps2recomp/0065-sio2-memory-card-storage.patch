+    if(input.empty()) return;
+    const auto size=std::max<size_t>(file.size(),offset+input.size()); auto clusters=chain(file.cluster()); const auto needed=(size+1023)/1024;
+    if(file.size()>clusters.size()*1024) throw Error(-5,"Memory-card file exceeds its allocation");
