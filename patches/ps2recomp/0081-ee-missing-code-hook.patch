+namespace
+{
+    EeMissingCodeHook &eeMissingCodeHook()
+    {
+        static EeMissingCodeHook hook;
+        return hook;
+    }
+}
+
+void ps2SetEeMissingCodeHook(EeMissingCodeHook hook)
+{
+    eeMissingCodeHook() = std::move(hook);
+}
+
+bool ps2RunEeMissingCodeHook(PS2Runtime &runtime, uint32_t target)
+{
+    const auto &hook = eeMissingCodeHook();
+    return hook && hook(runtime, target) && runtime.hasFunction(target);
+}
