+#include <cstdint>
+#include <functional>
+
+class PS2Runtime;
+
+// Host hook for guest control reaching an address without a translation, such as code the
+// game loaded itself. It returns true only after making a translation available there (for
+// example by binding a prepared EE module), so the dispatcher retries the lookup.
+using EeMissingCodeHook = std::function<bool(PS2Runtime &runtime, uint32_t target)>;
+
+void ps2SetEeMissingCodeHook(EeMissingCodeHook hook);
+bool ps2RunEeMissingCodeHook(PS2Runtime &runtime, uint32_t target);
