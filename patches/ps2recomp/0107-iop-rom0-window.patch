+    // ROM0 as the IOP sees it at 0x1FC00000: each ROMDIR file at its console offset (16-byte
+    // aligned, in directory order), so the original ROMDRV finds RESET/ROMDIR and its files.
+    const std::vector<uint8_t>& IopMemory::rom0() const
+    {
+        if (m_rom0Loaded || !m_host)
+            return m_rom0;
+        m_rom0Loaded = true;
+        const auto readFile = [&](const std::string &name, std::vector<uint8_t> &bytes)
+        {
+            const uint64_t handle = m_host->openHostFile("rom0:" + name);
+            if (!handle)
+                return false;
+            uint64_t size = 0u;
+            size_t got = 0u;
+            bool ok = m_host->hostFileSize(handle, size) && size <= Rom0Size;
+            if (ok)
+            {
+                bytes.resize(static_cast<size_t>(size));
+                ok = size == 0u || (m_host->readHostFile(handle, 0u, bytes.data(), bytes.size(), got) && got == size);
+            }
+            m_host->closeHostFile(handle);
+            return ok;
+        };
+        std::vector<uint8_t> directory;
+        if (!readFile("ROMDIR", directory))
+            return m_rom0;
+        std::vector<uint8_t> image(Rom0Size, 0u);
+        uint32_t offset = 0u;
+        for (size_t at = 0; at + 16u <= directory.size() && offset < Rom0Size; at += 16u)
+        {
+            const uint8_t *entry = directory.data() + at;
+            if (std::all_of(entry, entry + 16, [](uint8_t byte) { return byte == 0u; }))
+                break;
+            size_t length = 0u;
+            while (length < 10u && entry[length])
+                ++length;
+            uint32_t size;
+            std::memcpy(&size, entry + 12, sizeof(size));
+            if (size > Rom0Size - offset)
+                return m_rom0;
+            std::vector<uint8_t> bytes;
+            if (size && readFile(std::string(reinterpret_cast<const char *>(entry), length), bytes) && bytes.size() == size)
+                std::memcpy(image.data() + offset, bytes.data(), size);
+            offset += (size + 15u) & ~15u;
+        }
+        m_rom0 = std::move(image);
+        return m_rom0;
+    }
