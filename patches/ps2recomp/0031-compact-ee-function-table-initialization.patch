Initialize the same dense EE dispatch table from compact immutable binding ranges.
Preserve every slot and null hole without compiling a giant unrolled constructor.
No runtime ABI, instruction semantics or lookup changes.

--- a/ps2xRecomp/include/ps2recomp/Emitters/function_table_emitter.h
+++ b/ps2xRecomp/include/ps2recomp/Emitters/function_table_emitter.h
@@ -5,6 +5,7 @@
 #include <map>
 #include <string>
 #include <vector>
+#include <utility>
 
 namespace ps2recomp
 {
@@ -17,6 +18,22 @@
         explicit FunctionTableEmitter(CodeGenerator &codeGenerator);
 
         std::string emit(const std::vector<Function> &functions, const std::map<uint32_t, std::string> &stubs);
+        struct Range { uint32_t first, count; std::string name; };
+        // Entries are sorted, unique guest addresses. Holes remain null.
+        static std::vector<Range> compact(const std::vector<std::pair<uint32_t, std::string>>& entries,
+                                          uint32_t base) {
+            std::vector<Range> ranges;
+            for (const auto& [address, name] : entries) {
+                const uint32_t slot = (address - base) >> 2;
+                if (!ranges.empty() && ranges.back().first + ranges.back().count == slot &&
+                    ranges.back().name == name)
+                    ++ranges.back().count;
+                else
+                    ranges.push_back({slot, 1u, name});
+            }
+            return ranges;
+        }
+
 
     private:
         CodeGenerator &m_codeGenerator;
