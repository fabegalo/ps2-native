+#pragma once
+#include <cstdint>
+namespace ps2x::iop {
+class IopSpu2Backend {
+public:
+ virtual ~IopSpu2Backend() = default;
+ virtual void reset(uint8_t* ram, uint32_t size, uint64_t cycle) = 0;
+ virtual uint16_t read16(uint32_t address, uint64_t cycle) = 0;
+ virtual void write16(uint32_t address, uint16_t value, uint64_t cycle) = 0;
+ virtual void dma(int core, uint16_t* ram, uint32_t halfwords, uint32_t madr, bool write, uint64_t cycle) = 0;
+ virtual uint32_t madr(int core) = 0;
+ virtual void advance(uint64_t cycle) = 0;
+ virtual uint64_t nextEvent() = 0;
+ // bit 0: INTC9, bits 1/2: DMA4/7. Deliver after leaving device callbacks.
+ virtual uint32_t takeEvents() = 0;
+};
+}
