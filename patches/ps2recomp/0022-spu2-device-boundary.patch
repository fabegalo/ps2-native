+#pragma once
+#include "ps2x/iop/iop_spu2.h"
+#include <mutex>
+#include <unordered_map>
+#include <stdexcept>
+// Registration precedes guest execution; removal follows the joined guest thread.
+// Kept outside the AOT-visible console layout to preserve existing objects.
+struct PS2HostDevices { ps2x::iop::IopSpu2Backend* spu2 = nullptr; };
+inline std::mutex ps2HostDevicesMutex;
+inline std::unordered_map<const void*, PS2HostDevices*> ps2HostDevicesMap;
+inline void ps2SetHostDevices(const void* owner, PS2HostDevices* devices) {
+ std::lock_guard lock(ps2HostDevicesMutex);
+ if (!devices) ps2HostDevicesMap.erase(owner);
+ else if (!ps2HostDevicesMap.emplace(owner, devices).second)
+  throw std::logic_error("Console devices already attached");
+}
+inline PS2HostDevices* ps2GetHostDevices(const void* owner) {
+ std::lock_guard lock(ps2HostDevicesMutex);
+ const auto it = ps2HostDevicesMap.find(owner);
+ return it == ps2HostDevicesMap.end() ? nullptr : it->second;
+}
