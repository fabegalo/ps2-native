+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+#include <string>
+
+class PS2Runtime;
+struct R5900Context;
+
+struct EeAotBinding
+{
+    uint32_t offset;
+    uint32_t count;
+    void (*function)(uint8_t*, R5900Context*, PS2Runtime*);
+};
+
+// Flat images have no relocation records; offsets describe bindings at linkedBase only.
+struct EeAotModule
+{
+    const char* identity;
+    uint32_t linkedBase;
+    uint32_t entryOffset;
+    const uint8_t* image;
+    size_t imageSize;
+    const EeAotBinding* bindings;
+    size_t bindingCount;
+};
+
+inline void ps2CheckEeAotInstruction(const uint8_t* ram, uint32_t address, uint32_t expected)
+{
+    if (!ram || address > 0x02000000u - 4u || (address & 3u))
+        throw std::runtime_error("Invalid EE AOT instruction address");
+    const auto* p = ram + address;
+    const uint32_t actual = uint32_t(p[0]) | uint32_t(p[1]) << 8 |
+                            uint32_t(p[2]) << 16 | uint32_t(p[3]) << 24;
+    if (actual != expected)
+        throw std::runtime_error("EE AOT code changed at " + std::to_string(address));
+}
