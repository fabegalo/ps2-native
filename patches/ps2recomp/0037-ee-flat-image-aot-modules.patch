+# Native EE modules prepared by the SDK recompiler. Content identity and
+# preparation receipts belong to the caller's content/preparation boundary.
+function(ps2x_add_ee_aot_module target generated)
+    file(GLOB _sources CONFIGURE_DEPENDS "${generated}/*.cpp")
+    if(NOT _sources OR NOT EXISTS "${generated}/register_functions.cpp")
+        message(FATAL_ERROR "EE module has no prepared native sources: ${generated}")
+    endif()
+    add_library(${target} STATIC EXCLUDE_FROM_ALL ${_sources})
+    target_include_directories(${target} PRIVATE "${generated}")
+    target_link_libraries(${target} PRIVATE ps2_runtime)
+    set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 32)
+    if(MSVC)
+        target_compile_options(${target} PRIVATE /bigobj /FS)
+    endif()
+    if(COMMAND EnableFastReleaseMode AND CMAKE_BUILD_TYPE MATCHES "^(Release|RelWithDebInfo)$")
+        EnableFastReleaseMode(${target})
+    endif()
+endfunction()
