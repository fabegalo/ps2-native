+    bool IopRpcBridge::startServerCall(const RpcServer& server, uint32_t function, uint32_t size)
+    {
+        const auto queue = m_queueThreads.find(server.queue);
+        auto* loop = queue == m_queueThreads.end() ? nullptr : m_kernel.findThread(queue->second);
+        if (!loop || loop->state != IopThreadState::Sleep || m_call.active) return false;
+        m_call = {};
+        m_call.active = true;
+        m_call.thread = loop->id;
+        m_call.savedCpu = loop->cpu;
+        auto& cpu = loop->cpu;
+        cpu.pc = server.function;
+        cpu.gpr[4] = function;
+        cpu.gpr[5] = server.buffer;
+        cpu.gpr[6] = size;
+        cpu.gpr[7] = 0u;
+        cpu.gpr[28] = server.gp;
+        cpu.gpr[29] = (m_call.savedCpu.gpr[29] - 64u) & ~15u;
+        cpu.gpr[31] = kRpcReturnSentinel;
+        cpu.branchPending = cpu.pendingLoad = false;
+        cpu.stopped = cpu.yielded = cpu.exception = false;
+        loop->state = IopThreadState::Ready;
+        return true;
+    }
+
+    uint32_t IopRpcBridge::heapRpc(uint32_t function, uint32_t argument)
+    {
+        if (function == 1u) return m_memory.allocate(argument, 64u);
+        if (function == 2u) return m_memory.freeAllocation(argument) ? 0u : 0xFFFFFFFFu;
+        throw std::runtime_error("Unsupported IOP heap RPC function");
+    }
+
+    void IopRpcBridge::ensureHeapServer()
+    {
+        if (m_servers.contains(0x80000003u)) return;
+        // The existing HLE heap service shares sysmem; expose its real IOP endpoint to native clients.
+        const uint32_t data = m_memory.allocate(68u, 16u);
+        const uint32_t buffer = data ? m_memory.allocate(16u, 16u) : 0u;
+        if (!buffer) {
+            if (data) (void)m_memory.freeAllocation(data);
+            throw std::runtime_error("Cannot allocate IOP heap RPC endpoint");
+        }
+        (void)m_memory.zeroRam(data, 68u);
+        m_memory.write32(data, 0x80000003u);
+        m_memory.write32(data + 8u, buffer);
+        RpcServer server{};
+        server.sid = 0x80000003u;
+        server.serverData = data;
+        server.buffer = buffer;
+        m_servers.emplace(server.sid, server);
+    }
+
+    void IopRpcBridge::queueRpcReply(const RpcPacket& request, const RpcServer* server, uint32_t dataSize)
+    {
+        // PS2SDK sifrpc-common.h: RPC_END preserves the client and identifies the completed command.
+        RpcPacket response{};
+        response[0] = sizeof(response) | (dataSize << 8);
+        response[1] = dataSize ? request[10] : 0u;
+        response[2] = 0x80000008u;
+        response[4] = request[4];
+        response[5] = request[5];
+        response[6] = request[6];
+        response[7] = request[7];
+        response[8] = request[2];
+        if (server) {
+            response[9] = server->serverData;
+            response[10] = server->buffer;
+            response[11] = server->callbackBuffer;
+        }
+        if (request[2] == 0x8000000au && !request[12]) {
+            response[4] = response[6] = 0u;
+            if (!m_host.writeGuest(request[5], response.data(), sizeof(response)))
+                throw std::runtime_error("Invalid native RPC polling completion address");
+            return;
+        }
+        if (m_pendingCommands.size() >= 64u) throw std::runtime_error("IOP SIF command queue exhausted");
+        const auto* begin = reinterpret_cast<const uint8_t*>(response.data());
+        m_pendingCommands.emplace_back(begin, begin + sizeof(response));
+    }
+
+    void IopRpcBridge::advanceNativeRpc()
+    {
+        if (m_pendingCommands.size() >= 64u) return;
+        if (m_nativeCall) {
+            if (!m_call.done) return;
+            const RpcPacket request = *m_nativeCall;
+            if (m_call.result && request[11]) {
+                if (!m_memory.ownsRamRange(m_call.result, request[11]) ||
+                    !m_host.writeGuest(request[10], m_memory.ram().data() + IopMemory::physicalAddress(m_call.result), request[11]))
+                    throw std::runtime_error("Invalid native RPC result buffer");
+            }
+            queueRpcReply(request, nullptr, m_call.result ? request[11] : 0u);
+            m_nativeCall.reset();
+            m_call = {};
+        }
+        if (m_call.active || m_pendingRpc.empty()) return;
+        const auto request = m_pendingRpc.front();
+        const auto server = std::find_if(m_servers.begin(), m_servers.end(), [&](const auto& item) {
+            return item.second.serverData == request[13];
+        });
+        if (server == m_servers.end()) throw std::runtime_error("Native RPC call references an unregistered server");
+        const auto& target = server->second;
+        if (request[9] && !m_memory.ownsRamRange(target.buffer, request[9]))
+            throw std::runtime_error("Invalid native RPC argument buffer");
+        if (target.sid == 0x80000003u && !target.function) {
+            if (request[9] != 4u || request[11] < 4u) throw std::runtime_error("Invalid native IOP heap RPC buffers");
+            const auto reply = heapRpc(request[8], m_memory.read32(target.buffer));
+            if (!m_host.writeGuest(request[10], &reply, sizeof(reply)))
+                throw std::runtime_error("Invalid native IOP heap RPC reply address");
+            queueRpcReply(request, nullptr, sizeof(reply));
+        } else {
+            if (!startServerCall(target, request[8], request[9])) return;
+            m_nativeCall = request;
+        }
+        m_pendingRpc.pop_front();
     }
 
