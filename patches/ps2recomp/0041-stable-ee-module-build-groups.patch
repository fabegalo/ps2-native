--- a/ps2xRuntime/cmake/PS2EEAot.cmake
+++ b/ps2xRuntime/cmake/PS2EEAot.cmake
@@ -8,7 +8,19 @@
     add_library(${target} STATIC EXCLUDE_FROM_ALL ${_sources})
     target_include_directories(${target} PRIVATE "${generated}")
     target_link_libraries(${target} PRIVATE ps2_runtime)
-    set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_BATCH_SIZE 32)
+    # Stable groups keep newly learned functions from shifting later unity batches.
+    foreach(_source IN LISTS _sources)
+        get_filename_component(_name "${_source}" NAME)
+        if(_name STREQUAL "register_functions.cpp")
+            set_source_files_properties("${_source}" PROPERTIES SKIP_UNITY_BUILD_INCLUSION ON)
+        else()
+            string(SHA256 _hash "${_name}")
+            string(SUBSTRING "${_hash}" 0 2 _prefix)
+            math(EXPR _group "0x${_prefix} % 64")
+            set_source_files_properties("${_source}" PROPERTIES UNITY_GROUP "ee_${_group}")
+        endif()
+    endforeach()
+    set_target_properties(${target} PROPERTIES UNITY_BUILD ON UNITY_BUILD_MODE GROUP)
     if(MSVC)
         target_compile_options(${target} PRIVATE /bigobj /FS)
     endif()
