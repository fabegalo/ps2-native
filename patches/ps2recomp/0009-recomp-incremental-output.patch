+    // Sources of functions that no longer exist would still be compiled; remove what this run did not write.
+    void PS2Recompiler::removeStaleOutputs()
+    {
+        std::error_code error;
+        for (const auto &entry : fs::directory_iterator(m_config.outputPath, error))
+        {
+            const auto extension = entry.path().extension();
+            if (!entry.is_regular_file() || (extension != ".cpp" && extension != ".h"))
+                continue;
+            if (!m_writtenFiles.contains(fs::absolute(entry.path()).lexically_normal().string()))
+                fs::remove(entry.path(), error);
+        }
+    }
