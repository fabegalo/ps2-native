@@ -0,0 +1,180 @@
+#include "gs_async_backend.h"
+#include <utility>
+#include <vector>
+
+namespace
+{
+    // Bound how far the EE may run ahead of rasterization.
+    constexpr size_t kMaxQueuedCommands = 65536u;
+    constexpr size_t kMaxQueuedBytes = 64u * 1024u * 1024u;
+}
+
+GSAsyncBackend::GSAsyncBackend(std::unique_ptr<GSRasterBackend> inner)
+    : m_inner(std::move(inner)), m_thread([this] { worker(); })
+{
+}
+
+GSAsyncBackend::~GSAsyncBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stop = true;
+    }
+    m_pending.notify_all();
+    m_thread.join();
+}
+
+void GSAsyncBackend::worker()
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    for (;;)
+    {
+        m_pending.wait(lock, [this] { return m_stop || !m_queue.empty(); });
+        if (m_queue.empty())
+            return;
+        Command command = std::move(m_queue.front());
+        m_queue.pop_front();
+        const bool failed = static_cast<bool>(m_error);
+        lock.unlock();
+        std::exception_ptr error;
+        if (!failed)
+        {
+            try
+            {
+                command.run();
+            }
+            catch (...)
+            {
+                error = std::current_exception();
+            }
+        }
+        command.run = nullptr;
+        lock.lock();
+        if (error && !m_error)
+            m_error = error;
+        m_queuedBytes -= command.bytes;
+        ++m_completed;
+        m_completedChanged.notify_all();
+    }
+}
+
+void GSAsyncBackend::post(std::function<void()> run, size_t bytes)
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    m_completedChanged.wait(lock, [this] {
+        return m_error || (m_queue.size() < kMaxQueuedCommands && m_queuedBytes < kMaxQueuedBytes);
+    });
+    if (m_error)
+        std::rethrow_exception(m_error);
+    m_queue.push_back({std::move(run), bytes});
+    m_queuedBytes += bytes;
+    ++m_posted;
+    lock.unlock();
+    m_pending.notify_one();
+}
+
+void GSAsyncBackend::drain() const
+{
+    std::unique_lock<std::mutex> lock(m_mutex);
+    const uint64_t target = m_posted;
+    m_completedChanged.wait(lock, [this, target] { return m_completed >= target; });
+    if (m_error)
+        std::rethrow_exception(m_error);
+}
+
+void GSAsyncBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    drain();
+    m_inner->Initialize(vram, vramSize);
+    m_hasLocalMemory = vram != nullptr;
+}
+
+void GSAsyncBackend::Reset()
+{
+    drain();
+    m_inner->Reset();
+}
+
+void GSAsyncBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    post([this, batch] { m_inner->Submit(batch); }, sizeof(batch));
+}
+
+void GSAsyncBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    post([this, tex0, texclut] { m_inner->LoadClut(tex0, texclut); }, sizeof(tex0) + sizeof(texclut));
+}
+
+void GSAsyncBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    post([this, command] { m_inner->BeginTransfer(command); }, sizeof(command));
+}
+
+void GSAsyncBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    std::vector<uint8_t> bytes(data, data + sizeBytes);
+    post([this, bytes = std::move(bytes)] { m_inner->UploadImage(bytes.data(), static_cast<uint32_t>(bytes.size())); },
+         sizeBytes);
+}
+
+void GSAsyncBackend::Flush()
+{
+    post([this] { m_inner->Flush(); }, 0u);
+}
+
+void GSAsyncBackend::TextureFlush()
+{
+    post([this] { m_inner->TextureFlush(); }, 0u);
+}
+
+void GSAsyncBackend::Sync(GSSyncReason reason)
+{
+    drain();
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSAsyncBackend::Present(const GSPresentationRequest &request)
+{
+    drain();
+    return m_inner->Present(request);
+}
+
+bool GSAsyncBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    // Queued like a draw: the EE clears every frame and must not wait for the
+    // previous frame. The result is the raster contract, which depends only on
+    // initialized local memory and the frame format, never on VRAM contents.
+    post([this, context, rgba] { m_inner->ClearFramebuffer(context, rgba); }, sizeof(context));
+    const uint32_t psm = context.frame.psm;
+    return m_hasLocalMemory && context.frame.fbw != 0u &&
+           (psm == GS_PSM_CT32 || psm == GS_PSM_CT24 || psm == GS_PSM_CT16 || psm == GS_PSM_CT16S);
+}
+
+uint32_t GSAsyncBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    drain();
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSAsyncBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    drain();
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSAsyncBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    post([this, psm, base, bw, x, y, value] { m_inner->WriteVram(psm, base, bw, x, y, value); }, 0u);
+}
+
+void GSAsyncBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    drain();
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSAsyncBackend::GetTransferSnapshot() const
+{
+    drain();
+    return m_inner->GetTransferSnapshot();
+}
