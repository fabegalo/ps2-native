MOVZ/MOVN low-64 correction adapted from Vnnc1/gow-native-pc, GPL-3.0,
commit d28a63d3fd0f2a412ff9018b52d2a9a3cbdb18fd, engine/patches/06-recompiler-movn-movz-64bit.patch.
Original patch credits the God of War II port commit ddcc548; authors and upstream credits:
https://github.com/Vnnc1/gow-native-pc/blob/d28a63d3fd0f2a412ff9018b52d2a9a3cbdb18fd/CREDITS.md
Native-view bindings retain canonical register uncertainty. Writes to $zero remain no-ops.

--- a/ps2xRecomp/src/lib/special_translator.cpp
+++ b/ps2xRecomp/src/lib/special_translator.cpp
@@ -121,9 +121,12 @@
         case SPECIAL_SLTU:
             return fmt::format("SET_GPR_U64(ctx, {}, ((uint64_t)GPR_U64(ctx, {}) < (uint64_t)GPR_U64(ctx, {})) ? 1 : 0);", inst.rd, inst.rs, inst.rt);
         case SPECIAL_MOVZ:
-            return fmt::format("if (GPR_U64(ctx, {}) == 0) SET_GPR_VEC(ctx, {}, GPR_VEC(ctx, {}));", inst.rt, inst.rd, inst.rs);
+            // gow-native-pc patch 06: R5900 conditional moves preserve the upper 64 bits.
+            if (!inst.rd) return ";";
+            return fmt::format("if (GPR_U64(ctx, {}) == 0) SET_GPR_U64(ctx, {}, GPR_U64(ctx, {}));", inst.rt, inst.rd, inst.rs);
         case SPECIAL_MOVN:
-            return fmt::format("if (GPR_U64(ctx, {}) != 0) SET_GPR_VEC(ctx, {}, GPR_VEC(ctx, {}));", inst.rt, inst.rd, inst.rs);
+            if (!inst.rd) return ";";
+            return fmt::format("if (GPR_U64(ctx, {}) != 0) SET_GPR_U64(ctx, {}, GPR_U64(ctx, {}));", inst.rt, inst.rd, inst.rs);
         case SPECIAL_MFSA:
             return fmt::format("SET_GPR_U32(ctx, {}, ctx->sa);", inst.rd);
         case SPECIAL_MTSA:
--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -1044,6 +1044,8 @@
 template<class T> inline std::array<T,4> Ps2Prot3w(const std::array<T,4>& rt) { return {rt[1],rt[2],rt[0],rt[3]}; }
 #define PS2_PEXEW(rt) Ps2Pexew(rt)
 #define PS2_PROT3W(rt) Ps2Prot3w(rt)
+#define GPR_U64(ctx, reg) ((ctx)->gpr_word(reg))
+#define SET_GPR_U64(ctx, reg, value) ((ctx)->set_gpr_word(reg, value))
 #define GPR_VEC(ctx, reg) ((ctx)->gpr_vec(reg))
 #define SET_GPR_VEC(ctx, reg, value) ((ctx)->set_gpr_vec(reg, value))
 #endif // !PS2_SCALAR_FLOAT_ONLY
