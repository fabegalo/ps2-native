+#pragma once
+#include <cstdint>
+#include <span>
+#include <vector>
+
+namespace ps2x::iop {
+namespace detail { struct IopCpuState; class IopMemory; }
+
+// One emitted instruction, including its R3000A load/branch-delay semantics.
+// The existing executor still owns interrupts, cycles, DMA and scheduling.
+using IopAotInstruction = bool (*)(detail::IopCpuState&, detail::IopMemory&, uint32_t moduleBase);
+struct IopAotEntry {
+    uint32_t offset;
+    IopAotInstruction execute;
+};
+struct IopAotModule {
+    // Exact original bytes: neither a filename nor a load address identifies code.
+    std::vector<uint8_t> image;
+    std::vector<IopAotEntry> entries;
+};
+// Register before starting a console. Catalog data is immutable and shared;
+// loaded addresses, instruction validation and lifetime belong to each console.
+void registerIopAotModule(IopAotModule module);
+}
