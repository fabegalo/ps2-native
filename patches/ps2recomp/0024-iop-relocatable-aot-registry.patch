+#pragma once
+#include "ps2x/iop/iop_aot.h"
+#include <map>
+#include <optional>
+#include <span>
+#include <vector>
+
+namespace ps2x::iop::detail {
+class IopAotRegistry {
+public:
+    size_t bind(std::span<const uint8_t> image, uint32_t base, uint32_t size,
+                bool relocationsComplete, const IopMemory& memory);
+    std::optional<bool> execute(IopCpuState& cpu, IopMemory& memory) const;
+    void eraseRange(uint32_t base, uint32_t size);
+    void clear() { entries.clear(); }
+private:
+    struct BoundEntry {
+        uint32_t base, instruction;
+        IopAotInstruction execute;
+    };
+    std::map<uint32_t, BoundEntry> entries;
+};
+}
