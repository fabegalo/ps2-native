@@ -0,0 +1,81 @@
+#include "iop_aot_registry.h"
+#include "../core/iop_cpu.h"
+#include "../core/iop_memory.h"
+#include <algorithm>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+
+namespace ps2x::iop {
+namespace {
+struct Catalog {
+    std::mutex mutex;
+    std::vector<std::shared_ptr<const IopAotModule>> modules;
+};
+Catalog& catalog() { static Catalog value; return value; }
+}
+void registerIopAotModule(IopAotModule module) {
+    if (module.image.empty() || module.entries.empty())
+        throw std::invalid_argument("IOP AOT requires content and emitted instructions");
+    std::sort(module.entries.begin(), module.entries.end(),
+              [](const auto& a, const auto& b) { return a.offset < b.offset; });
+    for (size_t i = 0; i < module.entries.size(); ++i) {
+        const auto& e = module.entries[i];
+        if ((e.offset & 3u) || !e.execute ||
+            (i && e.offset == module.entries[i - 1].offset))
+            throw std::invalid_argument("Invalid or duplicate IOP AOT entry");
+    }
+    auto prepared = std::make_shared<const IopAotModule>(std::move(module));
+    auto& c = catalog();
+    std::lock_guard lock(c.mutex);
+    for (const auto& existing : c.modules)
+        if (existing->image == prepared->image)
+            throw std::invalid_argument("IOP AOT content already registered");
+    c.modules.push_back(std::move(prepared));
+}
+
+namespace detail {
+size_t IopAotRegistry::bind(std::span<const uint8_t> image, uint32_t base,
+                          uint32_t size, bool relocationsComplete, const IopMemory& memory) {
+    std::shared_ptr<const IopAotModule> module;
+    {
+        auto& c = catalog();
+        std::lock_guard lock(c.mutex);
+        for (const auto& candidate : c.modules)
+            if (std::equal(image.begin(), image.end(), candidate->image.begin(), candidate->image.end())) {
+                module = candidate;
+                break;
+            }
+    }
+    if (!module) return 0;
+    if (!relocationsComplete || (base & 3u) ||
+        base >= IopMemory::RamSize || size > IopMemory::RamSize - base)
+        throw std::runtime_error("IOP AOT cannot bind an incomplete or invalid relocation");
+    // Validate every entry before publishing any of them.
+    for (const auto& e : module->entries)
+        if (size < 4u || e.offset > size - 4u || entries.contains(base + e.offset))
+            throw std::runtime_error("IOP AOT entry outside image or overlapping loaded code");
+    for (const auto& e : module->entries) {
+        const auto address = base + e.offset;
+        entries.emplace(address, BoundEntry{base, memory.read32(address), e.execute});
+    }
+    return module->entries.size();
+}
+
+std::optional<bool> IopAotRegistry::execute(IopCpuState& cpu, IopMemory& memory) const {
+    if (entries.empty()) return std::nullopt;
+    const auto address = IopMemory::physicalAddress(cpu.pc);
+    const auto it = entries.find(address);
+    if (it == entries.end()) return std::nullopt;
+    if (memory.read32(address) != it->second.instruction)
+        throw std::runtime_error("IOP AOT code changed; offline preparation required");
+    return it->second.execute(cpu, memory, it->second.base);
+}
+
+void IopAotRegistry::eraseRange(uint32_t base, uint32_t size) {
+    auto it = entries.lower_bound(base);
+    while (it != entries.end() && uint64_t(it->first) < uint64_t(base) + size)
+        it = entries.erase(it);
+}
+}
+}
