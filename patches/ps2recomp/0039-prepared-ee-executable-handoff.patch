+bool EeScheduler::transferExecutable(const GuestExecutableRequest& request)
+{
+    if (request.syscall != 7) return false;
+    const auto* module = executableModule(request.arguments[0], m_rdram);
+    if (!module) return false;
+    const auto* caller = currentThread();
+    if (!caller || caller->id <= 0 || !caller->invocations.empty())
+        throw std::runtime_error("ExecPS2 requires an ordinary EE thread");
+    const uint32_t argc = request.arguments[2], argv = request.arguments[3];
+    if (argc > 16) throw std::runtime_error("ExecPS2 argument count exceeds the CRT contract");
+    const uint32_t table = argv & 0x1fffffffu;
+    if (argc && (!argv || table > PS2_RAM_SIZE - argc * 4u))
+        throw std::runtime_error("ExecPS2 argv table is outside EE RAM");
+    std::vector<std::string> arguments;
+    size_t remaining = 256;
+    for (uint32_t i = 0; i < argc; ++i)
+    {
+        uint32_t pointer = 0;
+        std::memcpy(&pointer, m_rdram + table + i * 4u, 4);
+        const uint32_t physical = pointer & 0x1fffffffu;
+        if (!pointer || physical >= PS2_RAM_SIZE)
+            throw std::runtime_error("ExecPS2 argument is outside EE RAM");
+        std::string argument;
+        size_t offset = 0;
+        while (offset < remaining && offset < PS2_RAM_SIZE - physical && m_rdram[physical + offset])
+            argument += static_cast<char>(m_rdram[physical + offset++]);
+        if (offset >= remaining || offset >= PS2_RAM_SIZE - physical)
+            throw std::runtime_error("ExecPS2 argument is unterminated or exceeds the CRT payload");
+        remaining -= offset + 1;
+        arguments.push_back(std::move(argument));
+    }
+    validateExecutableArguments(arguments);
+    // Pending device ownership cannot be transferred by this HLE path yet.
+    static constexpr uint32_t channels[] = {0x10008000, 0x10009000, 0x1000a000, 0x1000b000,
+        0x1000b400, 0x1000c000, 0x1000c400, 0x1000c800, 0x1000d000, 0x1000d400};
+    for (uint32_t channel : channels)
+        if (m_runtime.memory().readIORegister(channel) & 0x100u)
+            throw std::runtime_error("[guest-exec:unsupported] active EE DMA at ExecPS2");
+    if (m_runtime.memory().isPath3Masked() || !m_runtime.gifArbiter().empty())
+        throw std::runtime_error("[guest-exec:unsupported] queued GIF ownership at ExecPS2");
+    const uint64_t end = uint64_t(module->linkedBase) + module->imageSize;
+    if (end > PS2_RAM_SIZE - 0x1000u)
+        throw std::runtime_error("[guest-exec:unsupported] executable leaves no default EE stack space");
+    R5900Context next;
+    next.pc = request.arguments[0];
+    next.cop0_count = readCop0Count();
+    next.fcr31 = 0x01000001u;
+    SET_GPR_U32(&next, 28, request.arguments[1]);
+    SET_GPR_U32(&next, 29, PS2_RAM_SIZE - 0x10u);
+    SET_GPR_U32(&next, 4, argc);
+    SET_GPR_U32(&next, 5, argv);
+    const int retainedThread = caller->id;
+    bindAotModule(*module, module->linkedBase, m_rdram);
+    setExecutableArguments(std::move(arguments));
+    m_runtime.configureGuestHeap(static_cast<uint32_t>(end));
+    m_runtime.gs().reset();
+    m_runtime.vu0().reset();
+    m_runtime.vu1().reset();
+    m_runtime.memory().writeIORegister(0x10003810u, 1u);
+    m_runtime.memory().writeIORegister(0x10003c10u, 1u);
+    std::memset(m_runtime.memory().getScratchpad(), 0, PS2_SCRATCHPAD_SIZE);
+    m_mainThreadId = retainedThread;
+    resetKernelObjects(m_rdram, next, true);
+    noteControlTransfer();
+    copyMainContextToRuntime();
+    std::cerr << "[guest-exec:handoff] module=" << module->identity << " entry=0x" << std::hex
+              << next.pc << std::dec << " argc=" << argc << " thread=" << retainedThread
+              << " ee_cycle=" << m_eeCycle << '\n';
+    return true;
 }
 
