+// Bands match the sequential draw only while the cached texture page still
+// equals VRAM; each band then starts from that same cache. Region
+// clamp/repeat can address up to texel 1023 on either axis.
+bool GSCpuBackend::CanDrawTextureInBands(const GSDrawState &state, int x1, int y0, int y1)
+{
+    const auto &tex = state.context.tex0;
+    const uint64_t clamp = state.context.clamp;
+    const uint32_t texSpanW = (clamp & 0x2u) ? 1024u : static_cast<uint32_t>(state.textureWidth);
+    const uint32_t texSpanH = (clamp & 0x8u) ? 1024u : static_cast<uint32_t>(state.textureHeight);
+    const VramSpan texture = vramSpan(tex.tbp0, tex.psm, tex.tbw, texSpanW, texSpanH);
+    bool bands = m_vram && canDrawInBands(state, x1, y0, y1, &texture);
+    for (uint64_t page = texture.begin & ~uint64_t(8191u); bands && page < texture.end; page += 8192u)
+    {
+        GSMem::TexturePageCache probe = m_texturePageCache;
+        const uint32_t address = static_cast<uint32_t>(page);
+        bands = std::memcmp(probe.Resolve(m_vram, address), m_vram + address, 8192u) == 0;
+    }
+    return bands;
+}
