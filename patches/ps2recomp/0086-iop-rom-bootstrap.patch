+    std::vector<std::string> IopModuleLoader::readBootModules(IopHost &host, std::string_view arguments)
+    {
+        const auto fail = [](const char* reason) -> void {
+            throw std::runtime_error(std::string("[IOP-BOOT] ") + reason);
+        };
+        std::string config = "rom0:IOPBTCONF";
+        if (!arguments.empty())
+        {
+            std::istringstream command{std::string(arguments)};
+            std::string loader, extra;
+            if (!(command >> loader >> config) || command >> extra || loader != "rom0:UDNL" ||
+                !config.starts_with("rom0:") || config.find_first_of("/\\", 5) != std::string::npos)
+                fail("unsupported RESET command line");
+        }
+        std::vector<uint8_t> image;
+        if (!readWholeHostFile(host, config, image) || image.size() > 64u * 1024u)
+            fail("original boot configuration unavailable or oversized");
+        std::span<const uint8_t> text = image;
+        if (image.size() >= 16 && std::memcmp(image.data(), "RESET\0\0\0\0\0", 10) == 0)
+        {
+            // UDNL overlays the ROM directory; OSDCNF carries its own IOPBTCONF.
+            size_t offset = 0, directoryBytes = 0;
+            bool terminated = false, found = false;
+            for (size_t at = 0; at + 16 <= image.size(); at += 16)
+            {
+                const auto* entry = image.data() + at;
+                if (!entry[0]) { terminated = true; break; }
+                size_t length = 0;
+                while (length < 10 && entry[length]) ++length;
+                if (length == 10 || std::any_of(entry + length, entry + 10, [](uint8_t c) { return c != 0; }))
+                    fail("malformed boot ROMDIR name");
+                const std::string name(reinterpret_cast<const char*>(entry), length);
+                uint32_t size = 0;
+                std::memcpy(&size, entry + 12, 4);
+                if (offset > image.size() || size > image.size() - offset)
+                    fail("boot ROMDIR resource outside original image");
+                if (name == "ROMDIR")
+                {
+                    if (offset != 0 || directoryBytes || size % 16 || size < at + 32)
+                        fail("malformed boot ROMDIR extent");
+                    directoryBytes = size;
+                }
+                if (name == "IOPBTCONF")
+                {
+                    if (found) fail("duplicate IOPBTCONF");
+                    text = std::span<const uint8_t>(image).subspan(offset, size);
+                    found = true;
+                }
+                offset += (uint64_t(size) + 15u) & ~uint64_t(15u);
+                if (directoryBytes && at + 32 > directoryBytes)
+                    fail("unterminated boot ROMDIR");
+            }
+            if (!terminated || !directoryBytes || !found) fail("boot ROMDIR lacks IOPBTCONF");
+        }
+        if (!text.empty() && text.back() == 0) text = text.first(text.size() - 1);
+        if (std::find(text.begin(), text.end(), 0) != text.end()) fail("embedded NUL in IOPBTCONF");
+        std::istringstream lines{std::string(reinterpret_cast<const char*>(text.data()), text.size())};
+        std::vector<std::string> modules;
+        std::string line;
+        if (!std::getline(lines, line)) fail("empty IOPBTCONF");
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line != "@800") fail("unsupported IOPBTCONF bootstrap address");
+        while (std::getline(lines, line))
+        {
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            if (line.empty()) continue;
+            if (line.size() > 10 || !std::all_of(line.begin(), line.end(), [](unsigned char c) {
+                return (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_';
+            })) fail("unsupported IOPBTCONF directive or module name");
+            if (std::find(modules.begin(), modules.end(), line) != modules.end()) fail("duplicate boot module");
+            modules.push_back(line);
+            if (modules.size() > 128) fail("too many boot modules");
+        }
+        if (modules.empty()) fail("IOPBTCONF has no modules");
+        return modules;
+    }
