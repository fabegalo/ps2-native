+                    if (scmdEventFlagId == 0)
+                        scmdEventFlagId = kernel.createInternalEventFlag(kEventFlagMulti, 0u, 1u);
+                    cpu.gpr[2] = static_cast<uint32_t>(scmdEventFlagId);
