+                if(!memory.ownsRamRange(a0,4) || !memory.readRam(a0,input.data(),input.size()) ||
+                   !memory.applyScmd(0x1a,input,output) || output.empty()) {cpu.gpr[2]=0;return true;}
+                cpu.gpr[2]=output[0]==1 ? 1u : 0u;return true;
+            }
