Answer sceCdSC(-25) with the S-command lock event flag (ps2sdk cdvdman g_scmd_evfid,
created multi with bit 0 set); XCDVDFSV waited on id 0 forever, so its RPC never replied.
Serve sceCdBootCertify (XCDVDMAN export 70) through mechacon S-command 0x1A, which accepts
the 4-byte ROM name as PCSX2 does, instead of the original export polling absent CDVD registers.

--- a/ps2xIOP/src/emulator/core/iop_magicgate.cpp
+++ b/ps2xIOP/src/emulator/core/iop_magicgate.cpp
@@ -100,6 +100,10 @@ bool IopMagicGate::mecha(IopHost& host,uint8_t command,std::span<const uint8_t>
         if(input.size()!=1 || input[0]>1)return fail();
         m={};m.port=input[0];(void)identity(host,m.port);m.phase=1;return true;
     }
+    if(command==0x1a) { // BootCertify(romname[4]): the mechacon accepts the console's own ROM (PCSX2: 1 = success)
+        if(input.size()!=4)return fail();
+        output={1};return true;
+    }
     if(command<0x81 || command>0x88) {
         if(command==0x8f) { if(!input.empty() || m.phase<4)return fail();return true; }
         return false;
