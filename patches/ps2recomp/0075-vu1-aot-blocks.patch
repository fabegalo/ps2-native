+// SPDX-FileCopyrightText: 2002-2026 PCSX2 Dev Team
+// SPDX-License-Identifier: GPL-3.0+
+//
+// Included only by generated VU1 block sources (ps2-native). Each instruction pair is VU1microInterp.cpp's _vu1Exec
+// with the pair's words as template constants, so the compiler resolves fetch and opcode dispatch. The interpreter's
+// operations are compiled into a private namespace of the generated unit; they act on the same global VURegs state.
+#pragma once
+
+#include "Common.h"
+#include "VUmicro.h"
+#include "GS.h"
+#include "Gif_Unit.h"
+#include "MTVU.h"
+#include "pcsx2_vu1_aot.h"
+
+#include <cfenv>
+#include <cmath>
+#include <float.h>
+
+// The private copies of functions the headers also declare globally get their own names, so argument-dependent
+// lookup on VURegs* does not see both.
+#define VU_MACx_UPDATE aot_VU_MACx_UPDATE
+#define VU_MACy_UPDATE aot_VU_MACy_UPDATE
+#define VU_MACz_UPDATE aot_VU_MACz_UPDATE
+#define VU_MACw_UPDATE aot_VU_MACw_UPDATE
+#define VU_MACx_CLEAR aot_VU_MACx_CLEAR
+#define VU_MACy_CLEAR aot_VU_MACy_CLEAR
+#define VU_MACz_CLEAR aot_VU_MACz_CLEAR
+#define VU_MACw_CLEAR aot_VU_MACw_CLEAR
+#define VU_STAT_UPDATE aot_VU_STAT_UPDATE
+#define GET_VU_MEM aot_GET_VU_MEM
+#define _vuClearFMAC aot_vuClearFMAC
+#define _vuTestPipes aot_vuTestPipes
+#define _vuTestUpperStalls aot_vuTestUpperStalls
+#define _vuTestLowerStalls aot_vuTestLowerStalls
+#define _vuAddUpperStalls aot_vuAddUpperStalls
+#define _vuAddLowerStalls aot_vuAddLowerStalls
+#define _vuXGKICKTransfer aot_vuXGKICKTransfer
+#define _vuFlushAll aot_vuFlushAll
+
+namespace pcsx2vu1_aot_ops
+{
+    // What the headers declare for the originals, for uses ahead of the definitions.
+    u32 *GET_VU_MEM(VURegs *VU, u32 addr);
+    void _vuClearFMAC(VURegs *VU);
+    void _vuTestPipes(VURegs *VU);
+    void _vuTestUpperStalls(VURegs *VU, _VURegsNum *VUregsn);
+    void _vuTestLowerStalls(VURegs *VU, _VURegsNum *VUregsn);
+    void _vuAddUpperStalls(VURegs *VU, _VURegsNum *VUregsn);
+    void _vuAddLowerStalls(VURegs *VU, _VURegsNum *VUregsn);
+    void _vuXGKICKTransfer(s32 cycles, bool flush);
+    void _vuFlushAll(VURegs *VU);
+
+#include "VUflags.cpp"
+#include "VUops.cpp"
+
+    template <u32 Upper, u32 Lower>
+    inline void step(VURegs *VU)
+    {
+        _VURegsNum lregs;
+        _VURegsNum uregs;
+
+        VU->VI[REG_TPC].UL += 8;
+
+        if constexpr ((Upper & 0x40000000u) != 0u) // E flag
+            VU->ebit = 2;
+        if constexpr ((Upper & 0x10000000u) != 0u) // D flag
+        {
+            if (VU0.VI[REG_FBRST].UL & 0x400)
+            {
+                VU0.VI[REG_VPU_STAT].UL |= 0x200;
+                hwIntcIrq(INTC_VU1);
+                VU->ebit = 1;
+            }
+        }
+        if constexpr ((Upper & 0x08000000u) != 0u) // T flag
+        {
+            if (VU0.VI[REG_FBRST].UL & 0x800)
+            {
+                VU0.VI[REG_VPU_STAT].UL |= 0x400;
+                hwIntcIrq(INTC_VU1);
+                VU->ebit = 1;
+            }
+        }
+
+        VU->code = Upper;
+        VU1regs_UPPER_OPCODE[Upper & 0x3f](&uregs);
+
+        u32 cyclesBeforeOp = VU1.cycle - 1;
+
+        _vuTestUpperStalls(VU, &uregs);
+
+        if constexpr ((Upper & 0x80000000u) != 0u) // I flag: the lower word is a float
+        {
+            _vuTestPipes(VU);
+
+            if (VU->VIBackupCycles > 0)
+                VU->VIBackupCycles -= std::min((u8)(VU1.cycle - cyclesBeforeOp), VU->VIBackupCycles);
+
+            VU->code = Upper;
+            VU1_UPPER_OPCODE[Upper & 0x3f]();
+
+            VU->VI[REG_I].UL = Lower;
+            memset(&lregs, 0, sizeof(lregs));
+        }
+        else
+        {
+            VECTOR _VF;
+            VECTOR _VFc;
+            REG_VI _VI;
+            REG_VI _VIc;
+            int vfreg = 0;
+            int vireg = 0;
+            int discard = 0;
+
+            VU->code = Lower;
+            lregs.cycles = 0;
+            VU1regs_LOWER_OPCODE[Lower >> 25](&lregs);
+
+            _vuTestLowerStalls(VU, &lregs);
+            _vuTestPipes(VU);
+
+            if (VU->VIBackupCycles > 0)
+                VU->VIBackupCycles -= std::min((u8)(VU1.cycle - cyclesBeforeOp), VU->VIBackupCycles);
+
+            if (uregs.VFwrite)
+            {
+                if (lregs.VFwrite == uregs.VFwrite)
+                    discard = 1;
+                if (lregs.VFread0 == uregs.VFwrite || lregs.VFread1 == uregs.VFwrite)
+                {
+                    _VF = VU->VF[uregs.VFwrite];
+                    vfreg = uregs.VFwrite;
+                }
+            }
+            if (uregs.VIwrite & (1 << REG_CLIP_FLAG))
+            {
+                if (lregs.VIwrite & (1 << REG_CLIP_FLAG))
+                    discard = 1;
+                if (lregs.VIread & (1 << REG_CLIP_FLAG))
+                {
+                    _VI = VU->VI[REG_CLIP_FLAG];
+                    vireg = REG_CLIP_FLAG;
+                }
+            }
+
+            VU->code = Upper;
+            VU1_UPPER_OPCODE[Upper & 0x3f]();
+
+            if (discard == 0)
+            {
+                if (vfreg)
+                {
+                    _VFc = VU->VF[vfreg];
+                    VU->VF[vfreg] = _VF;
+                }
+                if (vireg)
+                {
+                    _VIc = VU->VI[vireg];
+                    VU->VI[vireg] = _VI;
+                }
+
+                VU->code = Lower;
+                VU1_LOWER_OPCODE[Lower >> 25]();
+
+                if (vfreg)
+                    VU->VF[vfreg] = _VFc;
+                if (vireg)
+                    VU->VI[vireg] = _VIc;
+            }
+        }
+        if (uregs.pipe == VUPIPE_FMAC || lregs.pipe == VUPIPE_FMAC)
+            _vuClearFMAC(VU);
+
+        _vuAddUpperStalls(VU, &uregs);
+        _vuAddLowerStalls(VU, &lregs);
+
+        if (VU->branch > 0)
+        {
+            if (VU->branch-- == 1)
+            {
+                VU->VI[REG_TPC].UL = VU->branchpc;
+
+                if (VU->takedelaybranch)
+                {
+                    VU->branch = 1;
+                    VU->branchpc = VU->delaybranchpc;
+                    VU->takedelaybranch = false;
+                }
+            }
+        }
+
+        if (VU->ebit > 0)
+        {
+            if (VU->ebit-- == 1)
+            {
+                VU->VIBackupCycles = 0;
+                _vuFlushAll(VU);
+                VU0.VI[REG_VPU_STAT].UL &= ~0x100;
+                vif1Regs.stat.VEW = false;
+
+                if (VU1.xgkickenable)
+                    _vuXGKICKTransfer(0, true);
+                if (INSTANT_VU1)
+                    VU1.xgkicklastcycle = cpuRegs.cycle;
+            }
+        }
+
+        if (uregs.pipe == VUPIPE_FMAC || lregs.pipe == VUPIPE_FMAC)
+            VU->fmacwritepos = (VU->fmacwritepos + 1) & 3;
+    }
+
+    // One pair of a block (vu1Exec): true while the next pair of the block follows.
+    template <u32 Pc, u32 Upper, u32 Lower>
+    inline bool pair(VURegs *VU, u64 budgetEnd)
+    {
+        VU->cycle++;
+        step<Upper, Lower>(VU);
+        return VU->VI[REG_TPC].UL == Pc + 8u && (VU0.VI[REG_VPU_STAT].UL & 0x100u) != 0u && VU->cycle < budgetEnd;
+    }
+}
