+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+
+struct VURegs;
+
+// Ahead-of-time VU1 blocks (ps2-native, 2026-11-14). A block is the code from a start pc up to a branch or E-bit
+// pair plus its delay pair; it is identified by its pc and bytes. Generated blocks run PCSX2's VU1 interpreter step
+// with the instruction words as compile-time constants on the same VURegs state, so control can pass between a block
+// and the interpreter at any pair boundary. Blocks without a translation run interpreted, are counted and recorded.
+namespace pcsx2vu1::aot
+{
+    // Runs the block's pairs while TPC follows them, VU1 runs and the cycle budget lasts; returns pairs executed.
+    using BlockFn = uint32_t (*)(VURegs *vu, uint64_t budgetEnd);
+
+    struct Block
+    {
+        uint64_t key; // blockKey(pc, bytes)
+        uint32_t pc;
+        uint32_t pairs;
+        BlockFn run;
+    };
+
+    // Pairs in the block starting at pc: up to and including the delay pair after a branch/jump or E-bit pair.
+    uint32_t blockPairs(const uint8_t *micro, uint32_t pc);
+    // FNV-1a 64 over the little-endian pc and the block bytes.
+    uint64_t blockKey(uint32_t pc, const uint8_t *bytes, uint32_t size);
+
+    void registerBlocks(const Block *blocks, size_t count);
+    // Appends each untranslated block, once, as a text line "pc word0 word1 ..." (hex) to this file.
+    void setRecordPath(const char *utf8Path);
+}
