Select sse2neon before the MSVC intrinsics header, so Windows ARM64 gets SSE types.

--- a/ps2xRuntime/include/ps2_runtime.h
+++ b/ps2xRuntime/include/ps2_runtime.h
@@ -7,10 +7,10 @@
 #include <string>
 #include <string_view>
 #include <functional>
-#if defined(_MSC_VER)
+#if defined(USE_SSE2NEON)
+#include "sse2neon.h"
+#elif defined(_MSC_VER)
 #include <intrin.h>
-#elif defined(USE_SSE2NEON)
-#include "sse2neon.h"
 #else
 #include <immintrin.h> // For SSE/AVX instructions
 #include <smmintrin.h> // For SSE4.1 instructions
