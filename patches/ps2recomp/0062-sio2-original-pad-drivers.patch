+    void IopMemory::startSio2Dma(uint32_t address, uint32_t value)
+    {
+        const bool receive = address == 0x1f801558u;
+        if (value != (receive ? 0x41000200u : 0x01000201u))
+            throw std::runtime_error("Unsupported SIO2 DMA mode");
+        const auto madr = readHardware32(address - 8u) & 0x1fffffu;
+        const auto bcr = readHardware32(address - 4u);
+        const uint32_t blockSize = (bcr & 0xffffu) * 4u;
+        const uint64_t size = uint64_t(blockSize) * (bcr >> 16u);
+        if ((madr & 3u) || size > RamSize - madr) throw std::runtime_error("SIO2 DMA exceeds physical IOP RAM");
+        if (receive) {
+            if (size > m_sio2Output.size()) throw std::runtime_error("SIO2 DMA output FIFO underflow");
+            for (uint64_t i = 0; i < size; ++i) {
+                m_ram[madr + i] = m_sio2Output.front();
+                m_sio2Output.pop_front();
+            }
+            markOwned(madr, static_cast<size_t>(size));
+        } else {
+            m_sio2BlockSize = blockSize;
+            for (uint64_t i = 0; i < size; ++i) {
+                if (m_sio2Command < m_sio2Commands.size() && ((m_sio2Commands[m_sio2Command] >> 8u) & 0x3ffu) > blockSize)
+                    throw std::runtime_error("SIO2 descriptor exceeds its DMA block");
+                writeSio2(m_ram[madr + i]);
+            }
+        }
+        m_hardware[address - 8u] = madr + static_cast<uint32_t>(size);
+        m_hardware[address] = value;
+        m_dmaStart = DmaStart{receive ? 0x2d : 0x2c, size / 16u};
+    }
