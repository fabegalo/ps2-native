+    bool IopMemory::completeSio2Dma(int irq)
+    {
+        if (irq == 0x2c || irq == 0x2d) {
+            m_hardware[irq == 0x2c ? 0x1f801548u : 0x1f801558u] &= ~kDmaStart;
+            const auto bit = irq == 0x2c ? 4u : 5u;
