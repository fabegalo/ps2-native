IOP SIF boot primitives: preserve MSFLAG clear / SMFLAG set semantics and a real system-status event.
References: ps2dev/ps2sdk sifman.c, threadman thcommon.c/thbase.c; PCSX2 IopMem.cpp.

--- a/ps2xIOP/src/emulator/services/iop_rpc.cpp
+++ b/ps2xIOP/src/emulator/services/iop_rpc.cpp
@@ -134,6 +134,25 @@
         case 8: // sceSifDmaStat
             setV0(0xFFFFFFFFu);
             return true;
+        case 21: // sceSifGetMSFlag
+            setV0(readSifRegister(3));
+            return true;
+        case 22: // IOP writes clear MSFLAG bits (PCSX2 IopMem.cpp).
+        {
+            const uint32_t value = readSifRegister(3) & ~cpu.gpr[4];
+            writeSifRegister(3, value);
+            setV0(value);
+            return true;
+        }
+        case 23: // sceSifGetSMFlag: the IOP sees its own pending boot flag.
+        case 24: // IOP writes set SMFLAG bits; the EE boot gate is separate.
+        {
+            const auto found = m_sifRegisters.find(4);
+            uint32_t value = found == m_sifRegisters.end() ? 0x00020000u : found->second;
+            if (ordinal == 24) { value |= cpu.gpr[4]; writeSifRegister(4, value); }
+            setV0(value);
+            return true;
+        }
         case 29: // sceSifCheckInit
             setV0(m_sifInitialized ? 1u : 0u);
             return true;
--- a/ps2xIOP/src/emulator/core/iop_kernel.cpp
+++ b/ps2xIOP/src/emulator/core/iop_kernel.cpp
@@ -31,6 +31,7 @@
         m_nextThreadId = 1;
         m_nextSemaphoreId = 1;
         m_nextEventFlagId = 1;
+        m_systemStatusFlag = 0;
         m_currentThread = nullptr;
         m_preemptedThread = 0;
     }
@@ -293,8 +294,9 @@
             setV0(0);
             return true;
         }
-        case 41:
-            setV0(0);
+        case 41: // GetSystemStatusFlag: one real shared event flag, initially clear (PS2SDK thcommon.c).
+            if (!m_systemStatusFlag) m_systemStatusFlag = createInternalEventFlag(2, 0, 0);
+            setV0(m_systemStatusFlag);
             return true;
         case 43: // GetSystemTimeLow
             setV0(static_cast<int32_t>(static_cast<uint32_t>(currentCycle)));
--- a/ps2xIOP/src/emulator/core/iop_kernel.h
+++ b/ps2xIOP/src/emulator/core/iop_kernel.h
@@ -104,6 +104,7 @@
         uint32_t m_nextThreadId = 1;
         uint32_t m_nextSemaphoreId = 1;
         uint32_t m_nextEventFlagId = 1;
+        int m_systemStatusFlag = 0;
         IopThread *m_currentThread = nullptr;
         int m_preemptedThread = 0;
     };
