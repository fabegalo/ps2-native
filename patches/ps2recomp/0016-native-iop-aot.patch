+namespace ps2x::iop::native {
+// Transient operand observations, never a CPU register file.
+struct Word {
+    std::uint32_t value=0,known=~0u;
+    std::string origin;
+    std::uint64_t epoch=0;
+};
+inline Word add(Word a,Word b,bool subtract=false) {
+    const auto unknown=~a.known|~b.known;
+    const auto known=unknown ? (unknown&(0u-unknown))-1u : ~0u;
+    return {(subtract ? a.value-b.value : a.value+b.value)&known,known,
+        a.known!=~0u ? a.origin : b.origin};
+}
+inline Word bit_and(const Word& a,const Word& b) {
+    const auto known=(a.known&b.known)|(a.known&~a.value)|(b.known&~b.value);
+    constexpr auto remote=std::uint64_t{1}<<63u;
+    const auto epoch=b.known==~0u && (b.value|1u)==~0u && (a.epoch&remote) ? a.epoch :
+        a.known==~0u && (a.value|1u)==~0u && (b.epoch&remote) ? b.epoch : 0u;
+    return {a.value&b.value&known,known,a.known!=~0u ? a.origin : b.origin,epoch};
+}
+inline Word bit_or(const Word& a,const Word& b) {
+    const auto known=(a.known&b.known)|(a.known&a.value)|(b.known&b.value);
+    constexpr auto remote=std::uint64_t{1}<<63u;
+    const auto epoch=b.known==~0u && !(b.value&~((a.epoch&remote) ? 1u : 0xDu)) ? a.epoch :
+        a.known==~0u && !(a.value&~((b.epoch&remote) ? 1u : 0xDu)) ? b.epoch : 0u;
+    return {(a.value|b.value)&known,known,a.known!=~0u ? a.origin : b.origin,epoch};
+}
+inline Word shift(Word a,unsigned amount,bool left,bool arithmetic=false) {
+    if(!amount)return a;
+    if(left) {a.known=(a.known<<amount)|((1u<<amount)-1u);a.value=(a.value<<amount)&a.known;}
+    else {
+        const auto fill=~0u<<(32u-amount);
+        const auto sign_known=(a.known&0x80000000u)!=0;
+        const auto sign=(a.value&0x80000000u)!=0;
+        a.known=(a.known>>amount)|(!arithmetic || sign_known ? fill : 0u);
+        a.value=((a.value>>amount)|(arithmetic && sign ? fill : 0u))&a.known;
+    }
+    a.epoch=0;return a;
+}
+struct Cpu {
+    template<std::uint32_t Instruction,class Host> static void execute(Host& host) {
+        using Pending=typename Host::PendingLoad;
+        using Observation=typename Host::NativeObservedWord;
+        using Error=typename Host::NativeExecutionStop;
+        const auto pc=host.pc_;
+        const bool wasDelaySlot=host.in_delay_slot_;
+        const auto priorBranchTarget=host.branch_target_;
+        host.write_.reset();host.undefined_load_.reset();host.undefined_known_=0;host.undefined_sio2_epoch_=0;
+        const auto delayed=std::exchange(host.pending_load_,std::nullopt);
+        constexpr unsigned opcode=Instruction>>26u,rs=(Instruction>>21u)&31u,rt=(Instruction>>16u)&31u;
+        constexpr unsigned rd=(Instruction>>11u)&31u,sa=(Instruction>>6u)&31u,funct=Instruction&63u;
+        constexpr auto imm=Instruction&0xFFFFu;
+        constexpr auto simm=static_cast<std::int32_t>(static_cast<std::int16_t>(imm));
+        constexpr auto signedImmediate=static_cast<std::uint32_t>(simm);
+        bool newBranch=false;std::uint32_t newBranchTarget=pc+8u;
+        std::optional<unsigned> exception;
+        const auto read=[&](unsigned r)->Word {
+            if(!r)return {};
