+        }
+        default:throw unsupported();
+        }
+        if(newBranch && wasDelaySlot)throw Error{"SDK IOP branch or jump in a delay slot (undefined)"};
+        if(delayed)host.commit(*delayed);
+        if(exception)return host.enter_exception(*exception,pc,wasDelaySlot);
+        if(host.write_)host.commit(*host.write_);
+        if(wasDelaySlot){host.pc_=*priorBranchTarget;host.in_delay_slot_=false;host.branch_target_.reset();}
+        else if(newBranch){host.pc_=pc+4u;host.in_delay_slot_=true;host.branch_target_=newBranchTarget;}
+        else host.pc_=pc+4u;
+    }
+};
+} // namespace ps2x::iop::native
