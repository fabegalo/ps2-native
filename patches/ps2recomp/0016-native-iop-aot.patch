+            return {host.gpr_[r],(host.gpr_defined_&(1u<<r)) ? ~0u : host.gpr_known_[r],host.gpr_origin_[r],host.gpr_sio2_epoch_[r]};
+        };
+        const auto consume=[&](const Word& word,std::uint32_t mask=~0u) {
+            if((word.known&mask)!=mask)throw Error{"SDK IOP consumes unknown operand bits: "+word.origin};
+            return word.value&mask;
+        };
+        const auto write=[&](unsigned r,const Word& word) {
+            if(r)host.write_=Pending{r,word.value&word.known,word.known==~0u,word.origin,word.known,word.known==~0u ? 0u : word.epoch};
+        };
+        const auto equal=[&](const Word& a,const Word& b) {
+            if((a.value^b.value)&a.known&b.known)return false;
+            return consume(a)==consume(b);
+        };
+        const auto branch=[&](bool condition) {
+            // Even a not-taken branch has a delay slot (including exception BD).
+            newBranch=true;newBranchTarget=condition ? pc+4u+(signedImmediate<<2u) : pc+8u;
+        };
+        const auto overflow=[&](const Word& a,const Word& b,unsigned destination,bool subtract) {
+            const auto lhs=static_cast<std::int32_t>(consume(a)),rhs=static_cast<std::int32_t>(consume(b));
+            const std::int64_t result=subtract ? std::int64_t{lhs}-rhs : std::int64_t{lhs}+rhs;
+            if(result>std::numeric_limits<std::int32_t>::max() || result<std::numeric_limits<std::int32_t>::min())exception=12u;
+            else write(destination,{static_cast<std::uint32_t>(result)});
+        };
+        const auto address=[&] {return consume(read(rs))+signedImmediate;};
+        const auto load=[&](unsigned r,std::uint32_t at,unsigned bytes,const char* operation,bool sign) {
+            if(at&(bytes-1u)){host.cop0_[8]=at;exception=4u;return;}
+            auto value=host.load(at,bytes,operation);
+            if(sign && bytes==1u)value=static_cast<std::uint32_t>(static_cast<std::int32_t>(static_cast<std::int8_t>(value)));
+            if(sign && bytes==2u)value=static_cast<std::uint32_t>(static_cast<std::int32_t>(static_cast<std::int16_t>(value)));
+            host.load_reg(r,value);
+        };
+        const auto store=[&](std::uint32_t at,unsigned bytes,const Word& word,const char* operation) {
+            if(at&(bytes-1u)){host.cop0_[8]=at;exception=5u;return;}
+            const auto mask=bytes==4u ? ~0u : (1u<<(bytes*8u))-1u;
+            if((word.known&mask)==mask)host.store(at,bytes,word.value&mask,operation);
+            else {const Observation observed{word.value,~word.known};host.store(at,bytes,std::nullopt,operation,&observed,bytes==4u ? word.epoch : 0u);}
+        };
+        const auto unsupported=[] {return Error{"SDK IOP instruction has no offline native implementation"};};
+        switch(opcode) {
+        case 0x00:
+            switch(funct) {
+            case 0x00:write(rd,shift(read(rt),sa,true));break;
+            case 0x02:write(rd,shift(read(rt),sa,false));break;
+            case 0x03:write(rd,shift(read(rt),sa,false,true));break;
+            case 0x04:write(rd,shift(read(rt),consume(read(rs),31u),true));break;
+            case 0x06:write(rd,shift(read(rt),consume(read(rs),31u),false));break;
+            case 0x07:write(rd,shift(read(rt),consume(read(rs),31u),false,true));break;
+            case 0x08:newBranch=true;newBranchTarget=consume(read(rs));break;
+            case 0x09:newBranch=true;newBranchTarget=consume(read(rs));write(rd,{pc+8u});break;
+            case 0x0C:exception=8u;break;
+            case 0x0D:exception=9u;break;
+            case 0x10:write(rd,{host.hi_.value_or(0u),host.hi_ ? ~0u : 0u,"unknown IOP HI"});break;
+            case 0x11:host.hi_=consume(read(rs));break;
+            case 0x12:write(rd,{host.lo_.value_or(0u),host.lo_ ? ~0u : 0u,"unknown IOP LO"});break;
+            case 0x13:host.lo_=consume(read(rs));break;
+            case 0x18: {
+                const std::int64_t result=std::int64_t{static_cast<std::int32_t>(consume(read(rs)))}*static_cast<std::int32_t>(consume(read(rt)));
+                host.lo_=static_cast<std::uint32_t>(result);host.hi_=static_cast<std::uint32_t>(static_cast<std::uint64_t>(result)>>32u);break;
+            }
+            case 0x19: {
+                const std::uint64_t result=std::uint64_t{consume(read(rs))}*consume(read(rt));
+                host.lo_=static_cast<std::uint32_t>(result);host.hi_=static_cast<std::uint32_t>(result>>32u);break;
+            }
+            case 0x1A: {
+                const auto lhs=static_cast<std::int32_t>(consume(read(rs)));
+                if constexpr(rt==0){host.lo_=lhs>=0 ? 0xFFFFFFFFu : 1u;host.hi_=static_cast<std::uint32_t>(lhs);}
+                else {
+                    const auto rhs=static_cast<std::int32_t>(consume(read(rt)));
+                    if(!rhs){host.lo_=lhs>=0 ? 0xFFFFFFFFu : 1u;host.hi_=static_cast<std::uint32_t>(lhs);}
+                    else if(lhs==std::numeric_limits<std::int32_t>::min() && rhs==-1){host.lo_=static_cast<std::uint32_t>(lhs);host.hi_=0u;}
+                    else {host.lo_=static_cast<std::uint32_t>(lhs/rhs);host.hi_=static_cast<std::uint32_t>(lhs%rhs);}
+                }break;
+            }
+            case 0x1B: {
+                const auto lhs=consume(read(rs));
+                if constexpr(rt==0){host.lo_=~0u;host.hi_=lhs;}
+                else {const auto rhs=consume(read(rt));host.lo_=rhs ? lhs/rhs : ~0u;host.hi_=rhs ? lhs%rhs : lhs;}break;
+            }
+            case 0x20:overflow(read(rs),read(rt),rd,false);break;
+            case 0x21:write(rd,!rs ? read(rt) : !rt ? read(rs) : add(read(rs),read(rt)));break;
+            case 0x22:overflow(read(rs),read(rt),rd,true);break;
+            case 0x23:write(rd,rs==rt ? Word{} : add(read(rs),read(rt),true));break;
+            case 0x24:write(rd,bit_and(read(rs),read(rt)));break;
+            case 0x25:write(rd,bit_or(read(rs),read(rt)));break;
+            case 0x26: {const auto a=read(rs),b=read(rt);const auto known=a.known&b.known;write(rd,rs==rt ? Word{} : Word{(a.value^b.value)&known,known,a.origin});break;}
+            case 0x27: {auto result=bit_or(read(rs),read(rt));result.value=~result.value&result.known;result.epoch=0;write(rd,result);break;}
+            case 0x2A:write(rd,{static_cast<std::uint32_t>(static_cast<std::int32_t>(consume(read(rs)))<static_cast<std::int32_t>(consume(read(rt))))});break;
+            case 0x2B:write(rd,{static_cast<std::uint32_t>(consume(read(rs))<consume(read(rt)))});break;
+            default:throw unsupported();
+            }break;
+        case 0x01: {
+            const bool negative=(consume(read(rs),0x80000000u)!=0);
+            switch(rt) {
+            case 0x00:branch(negative);break;
+            case 0x01:branch(!negative);break;
+            case 0x10:write(31u,{pc+8u});branch(negative);break;
+            case 0x11:write(31u,{pc+8u});branch(!negative);break;
+            default:throw unsupported();
+            }break;
+        }
+        case 0x02:newBranch=true;newBranchTarget=((pc+4u)&0xF0000000u)|((Instruction&0x03FFFFFFu)<<2u);break;
+        case 0x03:write(31u,{pc+8u});newBranch=true;newBranchTarget=((pc+4u)&0xF0000000u)|((Instruction&0x03FFFFFFu)<<2u);break;
+        case 0x04:branch(rs==rt || equal(read(rs),read(rt)));break;
+        case 0x05:branch(rs!=rt && !equal(read(rs),read(rt)));break;
+        case 0x06:branch(static_cast<std::int32_t>(consume(read(rs)))<=0);break;
+        case 0x07:branch(static_cast<std::int32_t>(consume(read(rs)))>0);break;
+        case 0x08:overflow(read(rs),{signedImmediate},rt,false);break;
+        case 0x09:write(rt,!signedImmediate ? read(rs) : add(read(rs),{signedImmediate}));break;
+        case 0x0A:write(rt,{static_cast<std::uint32_t>(static_cast<std::int32_t>(consume(read(rs)))<simm)});break;
+        case 0x0B:write(rt,{static_cast<std::uint32_t>(consume(read(rs))<signedImmediate)});break;
+        case 0x0C:write(rt,bit_and(read(rs),{imm}));break;
+        case 0x0D:write(rt,bit_or(read(rs),{imm}));break;
+        case 0x0E: {auto result=read(rs);result.value=(result.value^imm)&result.known;result.epoch=0;write(rt,result);break;}
+        case 0x0F:write(rt,{imm<<16u});break;
+        case 0x10:
+            if(rs==0)host.load_reg(rt,host.cop0_read(rd));
+            else if(rs==4)host.cop0_write(rd,consume(read(rt)));
+            else if(rs==16 && funct==16){const auto status=host.cop0_read(12);host.cop0_write(12,(status&~0xFu)|((status>>2u)&0xFu));}
+            else throw unsupported();
+            break;
+        case 0x20:load(rt,address(),1,"LB",true);break;
+        case 0x24:load(rt,address(),1,"LBU",false);break;
+        case 0x21:load(rt,address(),2,"LH",true);break;
+        case 0x25:load(rt,address(),2,"LHU",false);break;
+        case 0x23:load(rt,address(),4,"LW",false);break;
+        case 0x22:case 0x26: {
+            const auto at=address(),offset=at&3u,aligned=at&~3u;
+            auto prior=read(rt);
+            if(delayed && delayed->reg==rt)prior={delayed->value,delayed->defined ? ~0u : delayed->known,delayed->origin,delayed->sio2_epoch};
+            const auto first=opcode==0x22 ? 0u : offset,last=opcode==0x22 ? offset+1u : 4u;
+            for(unsigned k=first;k<last;++k) {
+                const auto bit=8u*(opcode==0x22 ? k+3u-offset : k-offset);
+                host.undefined_load_.reset();host.undefined_known_=0;
+                const auto byte=host.load(aligned+k,1,opcode==0x22 ? "LWL" : "LWR");
+                const auto known=host.undefined_load_ ? host.undefined_known_&0xFFu : 0xFFu;
+                if(known!=0xFFu)prior.origin=*host.undefined_load_;
+                prior.value=(prior.value&~(0xFFu<<bit))|(byte<<bit);
+                prior.known=(prior.known&~(0xFFu<<bit))|(known<<bit);
+            }
+            if(rt)host.pending_load_=Pending{rt,prior.value&prior.known,prior.known==~0u,prior.origin,prior.known};break;
+        }
+        case 0x28:store(address(),1,read(rt),"SB");break;
+        case 0x29:store(address(),2,read(rt),"SH");break;
+        case 0x2B:store(address(),4,read(rt),"SW");break;
+        case 0x2A:case 0x2E: {
+            const auto at=address(),offset=at&3u,aligned=at&~3u;const auto value=read(rt);
+            const auto first=opcode==0x2A ? 0u : offset,last=opcode==0x2A ? offset+1u : 4u;
+            for(unsigned k=first;k<last;++k){const auto bit=8u*(opcode==0x2A ? k+3u-offset : k-offset);
