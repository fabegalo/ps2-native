+// SPDX-License-Identifier: GPL-3.0-only
+// Offline adaptation of PS2Recomp e5636981, ps2xIOP/src/emulator/core/iop_cpu.cpp.
+// Upstream arithmetic, branches, multiply/divide and COP0 run against the host's
+// canonical state. Bus knowledge/provenance and byte-merge adapters retain the
+// original ps2-native BSD-3-Clause terms (see LICENSE and NOTICE).
+#pragma once
+#include <cstdint>
+#include <limits>
+#include <optional>
+#include <string>
+#include <utility>
