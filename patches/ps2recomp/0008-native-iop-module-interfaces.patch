+        case O::Open:handler=sceMcOpen;break;
+        case O::Close:handler=sceMcClose;break;
+        case O::Seek:handler=sceMcSeek;break;
+        case O::Read:handler=sceMcRead;break;
+        case O::Write:handler=sceMcWrite;break;
+        case O::Flush:handler=sceMcFlush;break;
+        case O::Chdir:handler=sceMcChdir;break;
