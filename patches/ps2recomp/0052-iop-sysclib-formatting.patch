+    std::string formatGuestString(const IopMemory &memory, uint32_t format,
+                                  const std::function<uint32_t(uint32_t)> &argument)
+    {
+        const std::string spec = memory.readString(format, 4096u);
+        std::string out;
+        uint32_t next = 0;
+        for (size_t i = 0; i < spec.size(); ++i)
+        {
+            if (spec[i] != '%')
+            {
+                out += spec[i];
+                continue;
+            }
+            // %[flags][width][.precision][length]conversion; '*' takes an argument.
+            std::string piece = "%";
+            size_t j = i + 1;
+            while (j < spec.size() && std::strchr("-+ #0", spec[j]))
+                piece += spec[j++];
+            for (int part = 0; part < 2; ++part)
+            {
+                if (part == 1)
+                {
+                    if (j >= spec.size() || spec[j] != '.')
+                        break;
+                    piece += spec[j++];
+                }
+                if (j < spec.size() && spec[j] == '*')
+                {
+                    piece += std::to_string(static_cast<int32_t>(argument(next++)));
+                    ++j;
+                }
+                while (j < spec.size() && std::isdigit(static_cast<unsigned char>(spec[j])))
+                    piece += spec[j++];
+            }
+            while (j < spec.size() && std::strchr("hlLqjzt", spec[j]))
+                ++j;
+            if (j >= spec.size())
+                break;
+            const char conversion = spec[j];
+            i = j;
+            char buffer[512];
+            switch (conversion)
+            {
+            case '%':
+                out += '%';
+                continue;
+            case 's':
+            {
+                const uint32_t address = argument(next++);
+                const std::string text = address ? memory.readString(address, 4096u) : std::string("(null)");
+                std::snprintf(buffer, sizeof(buffer), (piece + 's').c_str(), text.c_str());
+                break;
+            }
+            case 'c':
+                std::snprintf(buffer, sizeof(buffer), (piece + 'c').c_str(), static_cast<int>(argument(next++) & 0xFFu));
+                break;
+            case 'd':
+            case 'i':
+                std::snprintf(buffer, sizeof(buffer), (piece + 'd').c_str(), static_cast<int32_t>(argument(next++)));
+                break;
+            case 'u':
+            case 'x':
+            case 'X':
+            case 'o':
+                std::snprintf(buffer, sizeof(buffer), (piece + conversion).c_str(), argument(next++));
+                break;
+            case 'p':
+                std::snprintf(buffer, sizeof(buffer), "%x", argument(next++));
+                break;
+            default: // Floating point does not reach IOP printf; keep the text visible.
+                out += piece + conversion;
+                continue;
+            }
+            out += buffer;
+        }
+        return out;
+    }
