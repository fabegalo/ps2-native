+function(ps2x_find_embedded_iop_modules image output)
+    find_package(Python3 COMPONENTS Interpreter REQUIRED)
+    get_filename_component(_iop_root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
+    execute_process(COMMAND "${Python3_EXECUTABLE}" "${_iop_root}/tools/iop_aot.py" --scan-ee "${image}"
