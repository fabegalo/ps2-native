+def elf_extent(data, offset=0, boundary=None):
+    """Logical byte extent used by IopModuleLoader::readElf, relative to offset."""
+    boundary = len(data) if boundary is None else min(boundary, len(data))
+    if offset < 0 or offset + 52 > boundary:
+        raise ValueError('truncated embedded ELF header')
+    h = unpack('<16sHHIIIIIHHHHHH', data, offset)
+    if h[0][:7] != b'\x7fELF\x01\x01\x01' or h[2] != 8 or h[3] != 1 or h[8] < 52:
+        raise ValueError('invalid embedded MIPS ELF32 header')
+    if h[10] and h[9] < 32 or h[12] and h[11] < 40:
+        raise ValueError('invalid embedded ELF table stride')
+    required = max(52, h[5] + h[9] * h[10], h[6] + h[11] * h[12])
+    if required > 16 * 1024 * 1024 or offset + required > boundary:
+        raise ValueError('embedded ELF tables outside source view')
+    for i in range(h[12]):
+        section = unpack('<10I', data, offset + h[6] + i * h[11])
+        if section[1] != 8:
