+#include "ps2_transfer_state.h"
+
+#include <algorithm>
+#include <cstring>
+#include <stdexcept>
+#include <memory>
+
+namespace
+{
+    uint32_t vifCommandBytes(uint32_t command, uint32_t cycle)
+    {
+        const uint32_t op = (command >> 24u) & 0x7Fu;
+        const uint32_t num = ((command >> 16u) & 0xFFu) ? ((command >> 16u) & 0xFFu) : 256u;
+        if (op == 0x20u) return 8u; // STMASK
+        if (op == 0x30u || op == 0x31u) return 20u; // STROW/STCOL
+        if (op == 0x4Au) return 4u + num * 8u; // MPG
+        if (op == 0x50u || op == 0x51u)
+            return 4u + ((command & 0xFFFFu) ? (command & 0xFFFFu) : 65536u) * 16u;
+        if ((op & 0x60u) != 0x60u) return 4u;
+        const uint32_t vn = (op >> 2u) & 3u, vl = op & 3u;
+        const uint32_t bytesPerVector = (vl == 3u && vn == 3u) ? 2u :
+            ((vn + 1u) * (vl == 0u ? 32u : vl == 2u ? 8u : 16u) + 7u) / 8u;
+        const uint32_t cl = std::max(1u, cycle & 0xFFu), wl = std::max(1u, (cycle >> 8u) & 0xFFu);
+        const uint32_t vectors = cl < wl ? (num / wl) * cl + std::min(num % wl, cl) : num;
+        return 4u + ((vectors * bytesPerVector + 3u) & ~3u);
+    }
+}
