+PS2Memory::TransferState *PS2Memory::transferState(bool remove)
+{
+    // Preserve the SDK's exported object layout; each instance owns its entry through ctor/dtor.
+    static std::mutex mutex;
+    static std::unordered_map<PS2Memory *, std::unique_ptr<TransferState>> states;
+    std::lock_guard lock(mutex);
+    if (remove) { states.erase(this); return nullptr; }
+    auto entry = states.find(this);
+    if (entry == states.end()) entry = states.emplace(this, std::make_unique<TransferState>()).first;
+    return entry->second.get();
+}
+
+void PS2Memory::processVifStream(uint32_t channel, const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || !sizeBytes) return;
+    auto &pending = transferState()->vif[channel];
+    while (sizeBytes || !pending.empty())
+    {
+        const bool image = channel == 1u && m_vif1PendingPath2ImageQwc != 0u;
+        uint32_t required = image ? m_vif1PendingPath2ImageQwc * 16u : 4u;
+        if (!image && pending.size() >= 4u)
+        {
+            uint32_t command = 0;
+            std::memcpy(&command, pending.data(), 4u);
+            required = vifCommandBytes(command, channel ? vif1_regs.cycle : vif0_regs.cycle);
+        }
+        const size_t count = std::min<size_t>(sizeBytes, required - pending.size());
+        pending.insert(pending.end(), data, data + count);
+        data += count;
+        sizeBytes -= static_cast<uint32_t>(count);
+        if (pending.size() < required) return;
+        if (!image && required == 4u)
+        {
+            uint32_t command = 0;
+            std::memcpy(&command, pending.data(), 4u);
+            required = vifCommandBytes(command, channel ? vif1_regs.cycle : vif0_regs.cycle);
+            if (required > 4u) continue;
+        }
+        if (channel) executeVIF1Data(pending.data(), required);
+        else executeVIF0Data(pending.data(), required);
+        (channel ? vif1_regs : vif0_regs).num = 0u;
+        pending.clear();
+    }
+}
