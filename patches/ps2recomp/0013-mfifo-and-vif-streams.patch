+bool PS2Memory::tryProcessMfifoDma(uint32_t channelBase, uint32_t chcr)
+{
+    constexpr uint32_t ctrl = 0x1000E000u, stat = 0x1000E010u;
+    constexpr uint32_t spr = 0x1000D000u, vif = 0x10009000u, gif = 0x1000A000u;
+    auto &state = *transferState();
+    const auto configured = m_ioRegisters.find(ctrl);
+    const uint32_t dctrl = configured == m_ioRegisters.end() ? 1u : configured->second;
+    const uint32_t mode = (dctrl >> 2u) & 3u;
+    const uint32_t drain = mode == 2u ? vif : gif;
+    if (mode != state.mode)
+    {
+        const uint32_t oldDrain = state.mode == 2u ? vif : gif;
+        if (state.consumerActive && (m_ioRegisters[oldDrain] & 0x100u))
+            throw std::runtime_error("MFIFO mode changed during an active transfer");
+        if (!state.gif.empty())
+            throw std::runtime_error("MFIFO mode changed with an incomplete GIF packet");
+        state.mode = mode;
+        state.consumerActive = state.tagLoaded = false;
+    }
+    if (!mode) return false;
+    if (mode == 1u) throw std::runtime_error("Reserved MFIFO drain selection");
+    if (channelBase != ctrl && channelBase != spr && channelBase != drain) return false;
+    if (channelBase == drain)
+    {
+        if (!(chcr & 0x100u))
+        {
+            state.consumerActive = state.tagLoaded = false;
+            return true;
+        }
+        if (!state.consumerActive)
+        {
+            state.consumerActive = true;
+            m_ioRegisters[drain + 0x20u] &= 0xFFFFu;
+            state.tagLoaded = (m_ioRegisters[drain + 0x20u] & 0xFFFFu) != 0u;
+            const uint32_t tag = (chcr >> 28u) & 7u;
+            state.endTag = tag == 0u || tag == 7u || ((chcr & 0x80000080u) == 0x80000080u);
+        }
+    }
+    if (!(dctrl & 1u)) return true;
+    const auto disabled = m_ioRegisters.find(0x1000F590u);
+    if (disabled != m_ioRegisters.end() && (disabled->second & 0x10000u)) return true;
+    if (!(m_ioRegisters[spr] & 0x100u) && !(m_ioRegisters[drain] & 0x100u)) return true;
+    const uint32_t mask = m_ioRegisters[0x1000E040u] & 0x7FFFFFF0u;
+    const uint32_t base = m_ioRegisters[0x1000E050u] & 0x7FFFFFF0u;
+    const uint64_t ringBytes = static_cast<uint64_t>(mask) + 16u;
+    if ((mask & (mask + 16u)) || (base & mask) || base + ringBytes > PS2_RAM_SIZE)
+        throw std::runtime_error("Invalid MFIFO ring range");
+    const auto wrap = [&](uint32_t address) { return base | (address & mask); };
+    const auto inside = [&](uint32_t address) { return address >= base && address < base + ringBytes; };
+    const auto empty = [&]
+    {
+        const bool first = !(m_ioRegisters[stat] & (1u << 14u));
+        m_ioRegisters[stat] |= 1u << 14u;
+        if (m_ioRegisters[stat] & (1u << 30u))
+        {
+            m_ioRegisters[stat] |= 1u << 31u;
+            if (first) queueCompletedDmacCause(14u);
+        }
+    };
+    const auto deliver = [&](const uint8_t *data, uint32_t bytes)
+    {
+        if (drain == vif) { processVIF1Data(data, bytes); return; }
+        auto &pending = state.gif;
+        pending.insert(pending.end(), data, data + bytes);
+        size_t offset = 0;
+        while (pending.size() - offset >= 16u)
+        {
+            uint64_t tag = 0;
+            std::memcpy(&tag, pending.data() + offset, 8u);
+            const uint32_t loops = tag & 0x7FFFu, format = (tag >> 58u) & 3u;
+            const uint32_t registers = ((tag >> 60u) & 15u) ? ((tag >> 60u) & 15u) : 16u;
+            const size_t payload = format == 0u ? loops * registers * 16u :
+                format == 1u ? ((loops * registers * 8u + 15u) & ~15u) : loops * 16u;
+            if (pending.size() - offset < 16u + payload) break;
+            submitGifPacket(GifPathId::Path3, pending.data() + offset, static_cast<uint32_t>(16u + payload));
+            offset += 16u + payload;
+        }
+        pending.erase(pending.begin(), pending.begin() + offset);
+    };
+    uint32_t tags = 0;
+    const auto consume = [&]
+    {
+        if (!(m_ioRegisters[drain] & 0x100u)) return;
+        if (((m_ioRegisters[drain] >> 2u) & 3u) != 1u)
+            throw std::runtime_error("MFIFO drain requires source-chain mode");
