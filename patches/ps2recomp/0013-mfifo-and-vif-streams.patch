+        for (;;)
+        {
+            uint32_t producer = m_ioRegisters[spr + 0x10u] & 0x7FFFFFF0u;
+            if (!inside(producer)) { empty(); return; } // producer not configured/started yet
+            if (!state.tagLoaded)
+            {
+                const uint32_t address = wrap(m_ioRegisters[drain + 0x30u]);
+                m_ioRegisters[drain + 0x30u] = address;
+                if (address == producer) { empty(); return; }
+                if (++tags > (1u << 20u)) throw std::runtime_error("MFIFO chain did not converge");
+                uint32_t words[4];
+                std::memcpy(words, m_rdram + address, sizeof(words));
+                const uint32_t id = (words[0] >> 28u) & 7u, count = words[0] & 0xFFFFu;
+                uint32_t control = m_ioRegisters[drain];
+                control = (control & 0xFFFFu) | (words[0] & 0xFFFF0000u);
+                const uint32_t payload = wrap(address + 16u);
+                const uint32_t next = wrap(payload + count * 16u);
+                const uint32_t reference = words[1] & 0x7FFFFFF0u;
+                const bool ref = id == 0u || id == 3u || id == 4u;
+                uint32_t target = (id == 6u || id == 7u) ? address : payload;
+                state.endTag = id == 0u || id == 7u || ((words[0] & 0x80000000u) && (control & 0x80u));
+                if (id == 2u || id == 5u) target = wrap(reference);
+                if (id == 5u)
+                {
+                    const uint32_t asp = (control >> 4u) & 3u;
+                    if (asp >= 2u) throw std::runtime_error("MFIFO CALL stack overflow");
+                    m_ioRegisters[drain + 0x40u + asp * 16u] = next;
+                    control = (control & ~0x30u) | ((asp + 1u) << 4u);
+                }
+                if (id == 6u)
+                {
+                    const uint32_t asp = (control >> 4u) & 3u;
+                    if (asp > 2u) throw std::runtime_error("Invalid MFIFO return stack");
+                    if (!asp) state.endTag = true;
+                    else
+                    {
+                        target = wrap(m_ioRegisters[drain + 0x40u + (asp - 1u) * 16u]);
+                        control = (control & ~0x30u) | ((asp - 1u) << 4u);
+                    }
+                }
+                const uint32_t stallSource = (dctrl >> 4u) & 3u, stallDrain = (dctrl >> 6u) & 3u;
+                if (id == 4u && stallSource && ((drain == vif && stallDrain == 1u) || (drain == gif && stallDrain == 2u)))
+                    throw std::runtime_error("MFIFO REFS stall control is not implemented");
+                m_ioRegisters[drain] = control;
+                m_ioRegisters[drain + 0x10u] = ref ? (words[1] & 0xFFFFFFF0u) : payload;
+                m_ioRegisters[drain + 0x20u] = count;
+                m_ioRegisters[drain + 0x30u] = target;
+                state.tagLoaded = true;
+                if (drain == vif && (control & 0x40u)) deliver(reinterpret_cast<uint8_t *>(words + 2u), 8u);
+            }
+            uint32_t &qwc = m_ioRegisters[drain + 0x20u];
+            const uint32_t id = (m_ioRegisters[drain] >> 28u) & 7u;
+            const bool ref = id == 0u || id == 3u || id == 4u;
+            if (ref && qwc && m_ioRegisters[drain + 0x30u] == producer) empty();
+            while (qwc)
+            {
+                uint32_t &madr = m_ioRegisters[drain + 0x10u];
+                const uint8_t *source = nullptr;
+                uint32_t count = qwc;
+                if (!ref)
+                {
+                    madr = wrap(madr);
+                    if (madr == producer) { empty(); return; }
+                    const uint32_t available = static_cast<uint32_t>((producer - madr) & (ringBytes - 1u));
+                    count = std::min({qwc, available / 16u, static_cast<uint32_t>((base + ringBytes - madr) / 16u)});
+                    source = m_rdram + madr;
+                }
+                else if (madr & 0x80000000u)
+                {
+                    const uint32_t offset = madr & (PS2_SCRATCHPAD_SIZE - 1u);
+                    count = std::min(qwc, (PS2_SCRATCHPAD_SIZE - offset) / 16u);
+                    source = m_scratchpad + offset;
+                }
+                else
+                {
+                    const uint32_t offset = translateAddress(madr);
+                    if (offset >= PS2_RAM_SIZE || static_cast<uint64_t>(qwc) * 16u > PS2_RAM_SIZE - offset)
+                        throw std::runtime_error("MFIFO reference exceeds RAM");
+                    source = m_rdram + offset;
+                }
+                if (!count) throw std::runtime_error("MFIFO made no progress");
+                deliver(source, count * 16u);
+                madr = !ref ? wrap(madr + count * 16u) : (madr & 0x80000000u) ? (0x80000000u | ((madr + count * 16u) & 0x3FFFu)) : madr + count * 16u;
+                qwc -= count;
+                if (id == 1u) m_ioRegisters[drain + 0x30u] = madr;
+            }
+            state.tagLoaded = false;
+            if (state.endTag)
+            {
+                completeDmacChannel(drain, drain == vif ? 1u : 2u);
+                state.consumerActive = false;
+                return;
+            }
+        }
+    };
+    consume();
+    if (m_ioRegisters[spr] & 0x100u)
+    {
+        if (((m_ioRegisters[spr] >> 2u) & 3u) != 0u)
+            throw std::runtime_error("MFIFO scratchpad producer requires normal mode");
+        uint32_t &qwc = m_ioRegisters[spr + 0x20u];
+        qwc &= 0xFFFFu;
+        while (qwc)
+        {
+            uint32_t &madr = m_ioRegisters[spr + 0x10u], &sadr = m_ioRegisters[spr + 0x80u];
+            madr = wrap(madr);
+            sadr &= 0x3FF0u;
+            std::memcpy(m_rdram + madr, m_scratchpad + sadr, 16u);
+            markModified(madr, 16u);
+            madr = wrap(madr + 16u);
+            sadr = (sadr + 16u) & 0x3FF0u;
+            --qwc;
+            consume();
+        }
+        completeDmacChannel(spr, 8u);
+    }
+    return true;
+}
