+    // CDVD S-command registers, checked against PCSX2 CDVD.cpp cdvdRead/cdvdWrite (0x16-0x18) and
+    // ps2sdk cdvdman cdvdman_send_scmd2: SREADY bit 0x80 = busy, bit 0x40 = no result byte left.
+    uint8_t IopMemory::readScmd(uint32_t phys) const
+    {
+        if (phys == CdvdScmd)
+            return m_scmdCommand;
+        if (phys == CdvdScmd + 1u)
+            return m_scmdResults.empty() ? 0x40u : 0u;
+        if (m_scmdResults.empty())
+            return 0u;
+        const uint8_t value = m_scmdResults.front();
+        m_scmdResults.pop_front();
+        return value;
+    }
+
+    void IopMemory::writeScmd(uint32_t phys, uint8_t value)
+    {
+        if (phys == CdvdScmd + 1u)
+        {
+            if (m_scmdParams.size() >= 16u) // PCSX2: SDATAIN overflow restarts the parameter buffer
+                m_scmdParams.clear();
+            m_scmdParams.push_back(value);
+            return;
+        }
+        if (phys != CdvdScmd)
+            return; // SDATAOUT is read-only
+        m_scmdCommand = value;
+        std::vector<uint8_t> output;
+        const std::vector<uint8_t> input = std::move(m_scmdParams);
+        m_scmdParams.clear();
+        if (!applyScmd(value, input, output))
+        {
+            static constexpr char hex[] = "0123456789abcdef";
+            std::string bytes;
+            for (const uint8_t byte : input)
+                bytes += std::string(" ") + hex[byte >> 4u] + hex[byte & 15u];
+            throw std::runtime_error(std::string("Unsupported CDVD S-command 0x") + hex[value >> 4u] +
+                                     hex[value & 15u] + " (parameters:" + (bytes.empty() ? " none" : bytes) + ")");
+        }
+        m_scmdResults.assign(output.begin(), output.end());
+    }
