+    // Draws the row bands of one large primitive on helper threads; the GS
+    // thread takes bands too and returns once every band is done.
+    class RasterBands
+    {
+    public:
+        static RasterBands &instance()
+        {
+            static RasterBands pool;
+            return pool;
+        }
+        unsigned threads() const { return static_cast<unsigned>(m_workers.size()) + 1u; }
+        void run(unsigned bands, const std::function<void(unsigned)> &job)
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_job = &job;
+                m_bands = bands;
+                m_next = 0u;
+                m_done = 0u;
+                ++m_generation;
+            }
+            m_wake.notify_all();
+            work();
+            std::unique_lock<std::mutex> lock(m_mutex);
+            m_finished.wait(lock, [&] { return m_done == m_bands; });
+            m_job = nullptr;
+        }
+
+    private:
+        RasterBands()
+        {
+            const unsigned count = std::min(8u, std::max(1u, std::thread::hardware_concurrency() / 2u));
+            for (unsigned i = 1u; i < count; ++i)
+                m_workers.emplace_back([this] { loop(); });
+        }
+        ~RasterBands()
+        {
+            {
+                std::lock_guard<std::mutex> lock(m_mutex);
+                m_stop = true;
+            }
+            m_wake.notify_all();
+            for (auto &worker : m_workers)
+                worker.join();
+        }
+        void loop()
+        {
+            uint64_t seen = 0u;
+            for (;;)
+            {
+                std::unique_lock<std::mutex> lock(m_mutex);
+                m_wake.wait(lock, [&] { return m_stop || m_generation != seen; });
+                if (m_stop)
+                    return;
+                seen = m_generation;
+                lock.unlock();
+                work();
+            }
+        }
+        void work()
+        {
+            std::unique_lock<std::mutex> lock(m_mutex);
+            while (m_job && m_next < m_bands)
+            {
+                const unsigned band = m_next++;
+                const auto *job = m_job;
+                lock.unlock();
+                (*job)(band);
+                lock.lock();
+                if (++m_done == m_bands)
+                    m_finished.notify_all();
+            }
+        }
+
+        std::vector<std::thread> m_workers;
+        std::mutex m_mutex;
+        std::condition_variable m_wake, m_finished;
+        const std::function<void(unsigned)> *m_job = nullptr;
+        unsigned m_bands = 0u, m_next = 0u, m_done = 0u;
+        uint64_t m_generation = 0u;
+        bool m_stop = false;
+    };
