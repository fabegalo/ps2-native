+    // Swizzled VRAM bytes a buffer of this format and width may touch in rows [0, height).
+    struct VramSpan
+    {
+        uint64_t begin, end;
+        bool overlaps(const VramSpan &other) const { return begin < other.end && other.begin < end; }
+    };
+
+    // Columns past the buffer width spill into the next page row, so width counts too.
+    VramSpan vramSpan(uint32_t block, uint32_t psm, uint32_t bw, uint32_t width, uint32_t height)
+    {
+        uint32_t pageW = 64u, pageH = 32u;
+        switch (psm)
+        {
+        case GS_PSM_CT16: case GS_PSM_CT16S: case GS_PSM_Z16: case GS_PSM_Z16S: pageH = 64u; break;
+        case GS_PSM_T8: pageW = 128u; pageH = 64u; break;
+        case GS_PSM_T4: pageW = 128u; pageH = 128u; break;
+        default: break;
+        }
+        const uint64_t pagesWide = (std::max<uint32_t>(bw, 1u) * 64u + pageW - 1u) / pageW;
+        const uint64_t pagesTall = (std::max<uint64_t>(height, 1u) + pageH - 1u) / pageH;
+        const uint64_t lastRowPages = (std::max<uint64_t>(width, 1u) + pageW - 1u) / pageW;
+        const uint64_t begin = static_cast<uint64_t>(block) * 256u;
+        return {begin, begin + ((pagesTall - 1u) * pagesWide + std::max(lastRowPages, pagesWide) + 1u) * 8192u};
+    }
+
+    // Rows of a primitive can be drawn in parallel bands when it is large and
+    // no band can read or write bytes that another band writes.
+    bool canDrawInBands(const GSDrawState &state, int x1, int y0, int y1, const VramSpan *texture)
+    {
+        constexpr uint64_t kMinPixels = 16384u;
+        constexpr uint64_t kVramBytes = 4u * 1024u * 1024u;
+        const auto &ctx = state.context;
+        if (static_cast<uint64_t>(x1 + 1) * static_cast<uint64_t>(y1 - y0 + 1) < kMinPixels)
+            return false;
+        const uint32_t fbw = std::max<uint32_t>(ctx.frame.fbw, 1u);
+        const uint32_t rows = static_cast<uint32_t>(y1 + 1);
+        const uint32_t columns = static_cast<uint32_t>(x1 + 1);
+        const VramSpan frame = vramSpan(GSInternal::framePageBaseToBlock(ctx.frame.fbp), ctx.frame.psm, fbw, columns, rows);
+        const VramSpan depth = vramSpan(GSInternal::framePageBaseToBlock(ctx.zbuf.zbp), ctx.zbuf.psm, fbw, columns, rows);
+        const bool usesDepth = ((ctx.test >> 17) & 3u) >= 2u || !ctx.zbuf.zmask; // Z read by GEQUAL/GREATER, written unless masked
+        if (frame.end > kVramBytes || (usesDepth && (depth.end > kVramBytes || depth.overlaps(frame))))
+            return false;
+        if (texture && (texture->end > kVramBytes || texture->overlaps(frame) || (usesDepth && texture->overlaps(depth))))
+            return false;
+        return true;
+    }
+
+    template <class Prepare, class Draw>
+    void drawInBands(int y0, int y1, Prepare prepare, Draw draw)
+    {
+        auto &pool = RasterBands::instance();
+        const int rows = y1 - y0 + 1;
+        const unsigned count = std::min<unsigned>(pool.threads() * 4u, static_cast<unsigned>(rows));
+        prepare(count);
+        const std::function<void(unsigned)> job = [&](unsigned band) {
+            draw(band, y0 + static_cast<int>(static_cast<int64_t>(rows) * band / count),
+                 y0 + static_cast<int>(static_cast<int64_t>(rows) * (band + 1u) / count) - 1);
+        };
+        pool.run(count, job);
+    }
